---
interface Props { eyebrow?: string; title: string; lede?: string; }
const { eyebrow, title, lede } = Astro.props;
---
<section class="section">
  <div class="container-svge" data-reveal>
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="display max-w-[20ch]">{title}</h1>
    {lede && <p class="lede mt-6 max-w-[55ch]">{lede}</p>}
  </div>
</section>
