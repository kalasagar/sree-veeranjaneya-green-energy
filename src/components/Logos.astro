---
import { SITE } from '../lib/site';
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-10">
  {SITE.partners.map((p) => (
    <article class="border-t-2 border-[color:var(--color-forest)] pt-5">
      <p class="eyebrow mb-2">{p.role}</p>
      <h3 class="text-lg sm:text-xl font-semibold text-[color:var(--color-forest)] leading-snug tracking-tight">{p.name}</h3>
      <p class="mt-3 text-sm text-[color:var(--color-slate)] leading-relaxed max-w-[42ch]">{p.note}</p>
    </article>
  ))}
</div>
