---
/**
 * Partner roster — editorial cards with a monogram lockup, role eyebrow,
 * full name, and a one-line note. Used in: /work (in place), /, /about
 * (where appropriate).
 *
 * No actual partner SVG logos are bundled (the published partners — IOCL,
 * Raj Process, GoI — don't allow casual reuse of their wordmarks without
 * permission). Until those licences land, we render a typographic
 * monogram tile per partner that reads as a logo lockup at a glance.
 */
import { SITE } from '../lib/site';

function monogram(name: string): string {
  // Strip parenthetical suffixes, take initials of the first 2-3 significant words.
  const stripped = name.replace(/\([^)]*\)/g, '').trim();
  const words = stripped.split(/\s+/).filter(w => !/^(of|and|the|for|&|pvt|ltd|inc|corp|systems)$/i.test(w));
  return words.slice(0, 3).map(w => w[0]).join('').toUpperCase();
}

const palette = ['#1B5E20', '#2C5282', '#B7472A'];
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-px overflow-hidden rounded" style="background: var(--rule-color);" data-reveal>
  {SITE.partners.map((p, i) => (
    <article class="p-6 sm:p-7 flex flex-col" style="background: var(--color-paper);">
      <!-- Monogram lockup tile -->
      <div
        class="mb-5 inline-flex items-center justify-center rounded"
        style={`width: 64px; height: 64px; background: ${palette[i % palette.length]}; color: var(--color-paper); font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: 0.04em;`}
        aria-hidden="true"
      >{monogram(p.name)}</div>

      <p class="eyebrow" style="color: var(--color-saffron-text);">{p.role}</p>
      <h3 class="mt-2 leading-snug" style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--color-ink); letter-spacing: -0.01em;">{p.name}</h3>
      <div class="mt-3 w-8 h-px" style="background: var(--color-saffron);" aria-hidden="true"></div>
      <p class="mt-4 text-sm leading-relaxed flex-1" style="color: var(--color-slate);">{p.note}</p>
    </article>
  ))}
</div>
