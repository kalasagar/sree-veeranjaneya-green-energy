---
/**
 * Partner roster — editorial cards with role eyebrow + name + note.
 * Used in: work (already in place), home (partner reel).
 */
import { SITE } from '../lib/site';
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-px overflow-hidden rounded" style="background: var(--rule-color);" data-reveal>
  {SITE.partners.map((p) => (
    <article class="p-6 sm:p-8 flex flex-col" style="background: var(--color-paper);">
      <p class="eyebrow" style="color: var(--color-saffron-text);">{p.role}</p>
      <h3 class="mt-3" style="font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; color: var(--color-ink); letter-spacing: -0.01em;">{p.name}</h3>
      <div class="mt-3 w-8 h-px" style="background: var(--color-saffron);" aria-hidden="true"></div>
      <p class="mt-4 text-sm leading-relaxed flex-1" style="color: var(--color-slate);">{p.note}</p>
    </article>
  ))}
</div>
