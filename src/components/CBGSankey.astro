---
/**
 * Mass-flow Sankey — feedstock streams → 4× CSTR digester → CBG + FOM + losses.
 * Widths encode daily mass-flow. Indicative; reconciles with the DPR §3 plan.
 * Used on /plant #flow.
 */
import { SITE } from '../lib/site';

const mf = SITE.massFlow;

const inputs = [
  { id: 'napier', label: 'Napier grass',  value: mf.napierTpd,    color: 'var(--color-forest)' },
  { id: 'straw',  label: 'Paddy straw',   value: mf.paddyStrawTpd, color: '#C98E2B' },
  { id: 'dung',   label: 'Cattle dung',   value: mf.dungTpd,       color: '#B7472A' },
];

const outputs = [
  { id: 'cbg',  label: 'CBG to IOCL',           sub: `${mf.cbgTpd} TPD`,                                       share: 0.55, color: 'var(--color-saffron)' },
  { id: 'fom',  label: 'FOM back to fields',    sub: `${mf.fomSolidTph} TPH solid + ${mf.fomLiquidM3PerDay} m³/d liquid`, share: 0.35, color: 'var(--color-forest)' },
  { id: 'loss', label: 'CO₂ vented · water',    sub: 'recovered / recycled where possible',                    share: 0.10, color: '#90A4AE' },
];

const W = 880;
const H = 380;
const padX = 20;
const padY = 32;
const nodeW = 14;
const gap = 6;
const totalIn = inputs.reduce((s, i) => s + i.value, 0);
const avail = H - 2 * padY;

let iy = padY;
const iBlocks = inputs.map(i => {
  const h = (i.value / totalIn) * (avail - (inputs.length - 1) * gap);
  const b = { ...i, y: iy, h };
  iy += h + gap;
  return b;
});

let oy = padY;
const oBlocks = outputs.map(o => {
  const h = o.share * (avail - (outputs.length - 1) * gap);
  const b = { ...o, y: oy, h };
  oy += h + gap;
  return b;
});

const midX = W / 2 - 22;
const midW = 44;
const midY = padY;
const midH = avail;

function curve(x1: number, y1: number, x2: number, y2: number, h: number) {
  const cx = (x1 + x2) / 2;
  return `M${x1},${y1} C${cx},${y1} ${cx},${y2} ${x2},${y2} L${x2},${y2 + h} C${cx},${y2 + h} ${cx},${y1 + h} ${x1},${y1 + h} Z`;
}
---
<section class="svge-card p-6 sm:p-8" data-reveal>
  <header class="pb-5 border-b" style="border-color: var(--rule-color);">
    <p class="eyebrow" style="color: var(--color-saffron-text);">Mass-flow Sankey</p>
    <h3 class="mt-3 display" style="font-size: clamp(1.625rem, 2.8vw, 2.25rem); max-width: 26ch;">
      <span class="numeral">{mf.feedstockTpd}</span> tonnes in · <span class="numeral">{mf.rawBiogasNm3PerDay.toLocaleString('en-IN')}</span> Nm³/day raw biogas · <span class="numeral">{mf.cbgTpd}</span> tonnes out.
    </h3>
    <p class="mt-3 max-w-2xl" style="color: var(--color-slate);">
      Widths encode daily mass-flow at steady state. Breakdown by feedstock stream and product fraction is indicative; reconciles with DPR §3.
    </p>
  </header>

  <div class="mt-7 overflow-x-auto svge-sankey">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full min-w-[760px]" role="img" aria-label="Mass-flow Sankey from feedstock through digester to CBG and FOM">
      <!-- Inputs → digester -->
      {iBlocks.map(b => {
        const tStart = midY + ((b.y - padY) / avail) * midH;
        const tH = (b.h / avail) * midH;
        return <path d={curve(padX + nodeW, b.y, midX - 2, tStart, Math.max(tH, b.h))} style={`fill:${b.color}; fill-opacity: 0.45;`} />;
      })}

      <!-- Input nodes -->
      {iBlocks.map(b => (
        <g>
          <rect x={padX} y={b.y} width={nodeW} height={b.h} style={`fill:${b.color};`} />
          <text x={padX + nodeW + 8} y={b.y + 14} style={`font-family: var(--font-mono); font-size: 12px; font-weight: 600; fill: ${b.color};`}>{b.label}</text>
          <text x={padX + nodeW + 8} y={b.y + 30} style="font-family: var(--font-mono); font-size: 11px; fill: var(--color-slate);">{b.value} TPD</text>
        </g>
      ))}

      <!-- Digester column -->
      <rect x={midX} y={midY} width={midW} height={midH} style="fill: var(--color-ink);" />
      <text x={midX + midW / 2} y={midY - 10} text-anchor="middle" style="font-family: var(--font-mono); font-size: 12px; font-weight: 600; fill: var(--color-ink);">4× CSTR · 15,402 m³</text>
      <text x={midX + midW / 2} y={midY + midH + 22} text-anchor="middle" style="font-family: var(--font-mono); font-size: 11px; fill: var(--color-slate);">HRT 34 d · OLR 1.75 kg VS/m³/d</text>

      <!-- Digester → outputs -->
      {oBlocks.map(o => {
        const sourceY = midY + ((o.y - padY) / avail) * midH;
        return <path d={curve(midX + midW, sourceY, W - padX - nodeW, o.y, o.h)} style={`fill:${o.color}; fill-opacity: 0.45;`} />;
      })}

      <!-- Output nodes -->
      {oBlocks.map(b => (
        <g>
          <rect x={W - padX - nodeW} y={b.y} width={nodeW} height={b.h} style={`fill:${b.color};`} />
          <text x={W - padX - nodeW - 8} y={b.y + 14} text-anchor="end" style={`font-family: var(--font-mono); font-size: 12px; font-weight: 600; fill: ${b.color};`}>{b.label}</text>
          <text x={W - padX - nodeW - 8} y={b.y + 30} text-anchor="end" style="font-family: var(--font-mono); font-size: 11px; fill: var(--color-slate);">{b.sub}</text>
        </g>
      ))}
    </svg>
  </div>

  <!-- Side facts -->
  <div class="mt-8 grid sm:grid-cols-4 gap-px overflow-hidden rounded" style="background: var(--rule-color);">
    {[
      { k: 'Recycled water', v: `${mf.waterRecycledM3PerDay}`, u: 'm³/day' },
      { k: 'Slurry to digester', v: `${mf.slurryToDigesterM3PerDay}`, u: 'm³/day' },
      { k: 'CH₄ floor', v: `≥${mf.cbgMethanePct}%`, u: 'contracted' },
      { k: 'Cascade trucks', v: `~${mf.cascadesPerDay}`, u: 'per day' },
    ].map(f => (
      <div class="p-4" style="background: var(--color-paper);">
        <p class="eyebrow" style="color: var(--color-slate-2);">{f.k}</p>
        <p class="mt-2 numeral" style="font-family: var(--font-display); font-weight: 700; color: var(--color-ink); font-size: 1.5rem;">{f.v}</p>
        <p class="meta mt-1" style="color: var(--color-slate-2);">{f.u}</p>
      </div>
    ))}
  </div>
</section>
