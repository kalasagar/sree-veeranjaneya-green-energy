---
/**
 * Generic <details>-based disclosure. Editorial chrome.
 * Used in: plant (IS 16087 spec, equipment), farmers (FAQ), work (roles),
 *          press (probably soon).
 */
interface Props {
  summary: string;
  meta?: string;
  open?: boolean;
  /** Render summary larger (h3-scale) for major content. */
  emphasis?: boolean;
}
const { summary, meta, open = false, emphasis = false } = Astro.props;
---
<details class="svge-disclosure group" open={open}>
  <summary>
    <span class="flex-1 min-w-0" style={emphasis ? 'font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.015em;' : ''}>{summary}</span>
    {meta && <span class="meta shrink-0 hidden sm:inline" style="color: var(--color-slate-2);">{meta}</span>}
  </summary>
  <div class="disc-body">
    {meta && <p class="meta sm:hidden mb-3" style="color: var(--color-slate-2);">{meta}</p>}
    <slot />
  </div>
</details>
