---
interface Props {
  summary: string;
  meta?: string;
  open?: boolean;
}
const { summary, meta, open = false } = Astro.props;
---
<details class="svge-disclosure" open={open}>
  <summary>
    <span>{summary}</span>
    {meta && <span class="meta">{meta}</span>}
    <span aria-hidden="true"></span>
  </summary>
  <div class="disc-body"><slot /></div>
</details>
