---
/**
 * The spine of V4.1: the circularity story in one drawing + five
 * national-importance "fights" the plant takes on.
 *
 * Row 1 — an inline SVG closed-loop diagram. Four cardinal stops
 *   (Field, Plant, Indian Oil, 40 km catchment) tied by a saffron
 *   ring. Three inflows on the NE quadrant (paddy straw, Napier,
 *   cattle dung).
 * Row 2 — five "fight-cards" keyed to existing SITE numbers. Each
 *   card = one national fight + one mechanism + one number.
 *
 * Props:
 *   compact?: boolean  — diagram-only (no cards). Used on /plant.
 */
import { link } from '../lib/links';

const BASE = import.meta.env.BASE_URL;
const asset = (p: string) => `${BASE}${p.replace(/^\//, '')}`.replace('//', '/');

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const fights = [
  {
    eyebrow: 'Oil import bill',
    headline: '~80 buses/day',
    detail:
      "4 TPD CBG to Indian Oil. About a day's CNG for 80 city buses. India sends ~₹12 lakh crore abroad every year buying crude. Every cubic metre we make stays here.",
    href: '/build/#capital',
  },
  {
    eyebrow: 'Burn cycle',
    headline: '~29,000 TPA',
    detail:
      'Feedstock bought, not burned. ~14 Mt of paddy straw is set on fire across India every winter; we take ours out of that pile and pay for it.',
    href: '/farmers/',
  },
  {
    eyebrow: 'Air quality',
    headline: '5× WHO limit',
    detail:
      'Annual PM2.5 in the Indo-Gangetic plain runs five times the WHO safe limit. Stubble burning is one named cause. We remove the match in our belt.',
    href: '/plant/#glossary',
  },
  {
    eyebrow: 'Soil & fertilizer',
    headline: '~365 TPA FOM',
    detail:
      "~365 TPA of solid Fermented Organic Manure plus 52 m³/day of liquid manure goes back to the same 40 km belt we buy from. Rebuilds the organic carbon decades of chemical farming stripped out.",
    href: '/plant/#glossary',
  },
  {
    eyebrow: 'Rural cash',
    headline: '~120 jobs',
    detail:
      "47 on plant payroll, ~73 in aggregation, transport, and farmer-side roles inside 40 km. Napier at ₹1,200/t × 6 harvests/yr; payments cleared in 14 days.",
    href: '/work/',
  },
];
---
<div class={compact ? 'svge-circular-loop svge-circular-loop--compact' : 'svge-circular-loop'} data-reveal>
  <!-- The loop, in one drawing -->
  <figure class="loop-figure">
    <svg viewBox="0 0 1000 720" role="img" aria-labelledby="loopTitle loopDesc" preserveAspectRatio="xMidYMid meet">
      <title id="loopTitle">The SVGE circular loop</title>
      <desc id="loopDesc">
        Farmer's field at the top, our plant at the right, Indian Oil at the bottom, the same forty-kilometre catchment at the left. A saffron ring runs clockwise between them. Three inflows from the upper right (paddy straw, Napier grass, cattle dung) feed into the plant. At the centre, 4 TPD of CBG and FOM leave each day.
      </desc>

      <defs>
        <radialGradient id="loopWash" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--color-paper-2)" stop-opacity="0.7"/>
          <stop offset="70%" stop-color="var(--color-paper)" stop-opacity="0.4"/>
          <stop offset="100%" stop-color="var(--color-paper)" stop-opacity="0"/>
        </radialGradient>
        <!-- One closed loop path the flow particles ride. Keep coords
             matching the four-arc segments below. -->
        <path id="loopFullPath" d="M 500 160 A 220 220 0 0 1 720 380 A 220 220 0 0 1 500 600 A 220 220 0 0 1 280 380 A 220 220 0 0 1 500 160" fill="none"/>
        <marker id="loopArrow" viewBox="0 0 14 14" refX="11" refY="7" markerWidth="11" markerHeight="11" orient="auto-start-reverse">
          <path d="M0,1 L12,7 L0,13 z" fill="var(--color-saffron)"></path>
        </marker>
        <marker id="inflowArrow" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="9" markerHeight="9" orient="auto">
          <path d="M0,2 L10,6 L0,10 z" fill="var(--color-saffron)"></path>
        </marker>

        <!-- Decorative iconography. Drawn at unit scale and translated to each node. -->
        <g id="iconPaddy">
          <!-- a single paddy stalk with grains -->
          <path d="M 0,18 Q 0,4 0,-18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          <g fill="currentColor">
            <ellipse cx="-3" cy="-14" rx="2" ry="3.5" transform="rotate(-20 -3 -14)"/>
            <ellipse cx="3" cy="-10" rx="2" ry="3.5" transform="rotate(20 3 -10)"/>
            <ellipse cx="-3" cy="-6" rx="2" ry="3.5" transform="rotate(-20 -3 -6)"/>
            <ellipse cx="3" cy="-2" rx="2" ry="3.5" transform="rotate(20 3 -2)"/>
          </g>
        </g>
        <g id="iconDigester">
          <!-- a digester dome with a small flame -->
          <path d="M -14,8 L -14,-2 A 14,14 0 0 1 14,-2 L 14,8 z" fill="currentColor"/>
          <line x1="0" y1="-16" x2="0" y2="-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M 0,-18 Q -3,-22 0,-26 Q 3,-22 0,-18 z" fill="var(--color-saffron)"/>
        </g>
        <g id="iconFlame">
          <!-- the IOCL flame: a stylised CBG flame -->
          <path d="M 0,16 Q -10,4 -6,-8 Q -2,-4 -1,-12 Q 4,-2 8,2 Q 12,12 0,16 z" fill="var(--color-saffron)"/>
          <path d="M 0,10 Q -3,4 -1,-2 Q 2,2 3,-4 Q 6,2 5,8 Q 3,12 0,10 z" fill="var(--color-gold)" opacity="0.85"/>
        </g>
        <g id="iconSeedling">
          <!-- a single seedling rising from soil -->
          <path d="M -16,12 L 16,12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M 0,12 L 0,-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M 0,-2 Q -6,-6 -8,-12 Q -2,-10 0,-4" fill="currentColor"/>
          <path d="M 0,-4 Q 6,-8 8,-14 Q 2,-12 0,-6" fill="currentColor"/>
        </g>

        <!-- Inflow chip icons (small) -->
        <g id="chipStraw" fill="var(--color-saffron-text)">
          <rect x="-9" y="-2" width="18" height="3" rx="1.2" transform="rotate(-15)"/>
          <rect x="-9" y="2" width="18" height="3" rx="1.2" transform="rotate(-15)"/>
          <rect x="-9" y="-6" width="18" height="3" rx="1.2" transform="rotate(-15)"/>
        </g>
        <g id="chipNapier" fill="var(--color-saffron-text)">
          <path d="M -8,8 Q -4,-4 0,-10 Q 4,-4 8,8 z"/>
        </g>
        <g id="chipDung" fill="var(--color-saffron-text)">
          <ellipse cx="0" cy="0" rx="8" ry="5"/>
          <ellipse cx="0" cy="0" rx="5" ry="3" fill="var(--color-paper)" opacity="0.35"/>
        </g>
      </defs>

      <!-- Soft radial wash behind the ring for depth -->
      <circle cx="500" cy="380" r="280" fill="url(#loopWash)"></circle>

      <!-- Faint ghost ring for tonal anchor -->
      <circle cx="500" cy="380" r="220" fill="none" stroke="var(--rule-color)" stroke-width="1" stroke-dasharray="2 6" opacity="0.55"></circle>

      <!-- The saffron ring: four clockwise quadrants with mid-arc arrow markers -->
      <g class="loop-ring" fill="none" stroke="var(--color-saffron)" stroke-width="4" stroke-linecap="round" data-draw>
        <path d="M 500 160 A 220 220 0 0 1 720 380" marker-end="url(#loopArrow)"></path>
        <path d="M 720 380 A 220 220 0 0 1 500 600" marker-end="url(#loopArrow)"></path>
        <path d="M 500 600 A 220 220 0 0 1 280 380" marker-end="url(#loopArrow)"></path>
        <path d="M 280 380 A 220 220 0 0 1 500 160" marker-end="url(#loopArrow)"></path>
      </g>

      <!-- Flow particles riding the loop. Four saffron dots, evenly
           spaced by negative-begin offsets, looping every 16s. Hidden
           under prefers-reduced-motion via CSS. -->
      <g class="loop-particles" aria-hidden="true">
        <circle r="6" fill="var(--color-saffron)" opacity="0.9">
          <animateMotion dur="16s" repeatCount="indefinite" begin="0s" rotate="auto"><mpath href="#loopFullPath"/></animateMotion>
        </circle>
        <circle r="6" fill="var(--color-saffron)" opacity="0.9">
          <animateMotion dur="16s" repeatCount="indefinite" begin="-4s" rotate="auto"><mpath href="#loopFullPath"/></animateMotion>
        </circle>
        <circle r="6" fill="var(--color-saffron)" opacity="0.9">
          <animateMotion dur="16s" repeatCount="indefinite" begin="-8s" rotate="auto"><mpath href="#loopFullPath"/></animateMotion>
        </circle>
        <circle r="6" fill="var(--color-saffron)" opacity="0.9">
          <animateMotion dur="16s" repeatCount="indefinite" begin="-12s" rotate="auto"><mpath href="#loopFullPath"/></animateMotion>
        </circle>
      </g>

      <!-- Inflow rail: 3 dashed lines from chips into the plant node -->
      <g class="loop-inflows" fill="none" stroke="var(--color-saffron-text)" stroke-width="1.5" stroke-dasharray="4 5" opacity="0.7">
        <line x1="900" y1="120" x2="700" y2="260" marker-end="url(#inflowArrow)"></line>
        <line x1="940" y1="220" x2="700" y2="340" marker-end="url(#inflowArrow)"></line>
        <line x1="940" y1="340" x2="720" y2="400" marker-end="url(#inflowArrow)"></line>
      </g>

      <!-- Inflow chips (icon + label) -->
      <g class="loop-inflow-chips" font-family="var(--font-mono)" font-size="13" font-weight="600" letter-spacing="0.12em" fill="var(--color-saffron-text)" text-anchor="end" style="text-transform: uppercase;">
        <g transform="translate(900,120)"><use href="#chipStraw" transform="translate(20,0)"/></g>
        <text x="888" y="115">Paddy straw</text>
        <g transform="translate(940,220)"><use href="#chipNapier" transform="translate(20,0)"/></g>
        <text x="928" y="215">Napier grass</text>
        <g transform="translate(940,340)"><use href="#chipDung" transform="translate(20,0)"/></g>
        <text x="928" y="335">Cattle dung</text>
      </g>

      <!-- Four cardinal nodes — clickable, ink-filled, iconographic. Plant
           node sits at slightly larger radius (heart-of-operation cue). -->
      <g class="loop-nodes">
        <a href={link('/farmers/')} class="loop-node-link" aria-label="Farmer's field — 72 TPD feedstock harvested">
          <g transform="translate(500,160)">
            <circle class="loop-node-halo" r="80" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="70" fill="var(--color-ink)"></circle>
            <g transform="translate(0,-12)" color="var(--color-gold)"><use href="#iconPaddy"/></g>
            <text font-family="var(--font-mono)" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" y="20" style="text-transform: uppercase;">Farmer's field</text>
          </g>
        </a>
        <a href={link('/plant/')} class="loop-node-link" aria-label="Our plant — 4 CSTR digesters, 9,600 Nm³/day raw biogas">
          <g transform="translate(720,380)">
            <circle class="loop-node-halo" r="90" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="78" fill="var(--color-ink)"></circle>
            <g transform="translate(0,-12)" color="var(--color-gold)"><use href="#iconDigester"/></g>
            <text font-family="var(--font-mono)" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" y="24" style="text-transform: uppercase;">Our plant</text>
          </g>
        </a>
        <a href={link('/build/#capital')} class="loop-node-link" aria-label="Indian Oil offtake — 4 TPD CBG dispatched">
          <g transform="translate(500,600)">
            <circle class="loop-node-halo" r="80" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="70" fill="var(--color-ink)"></circle>
            <g transform="translate(0,-12)"><use href="#iconFlame"/></g>
            <text font-family="var(--font-mono)" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" y="22" style="text-transform: uppercase;">Indian Oil</text>
          </g>
        </a>
        <a href={link('/plant/#glossary')} class="loop-node-link" aria-label="40 km belt — ~365 TPA FOM returned to soil">
          <g transform="translate(280,380)">
            <circle class="loop-node-halo" r="80" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="70" fill="var(--color-ink)"></circle>
            <g transform="translate(0,-8)" color="var(--color-gold)"><use href="#iconSeedling"/></g>
            <text font-family="var(--font-mono)" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" y="24" style="text-transform: uppercase;">40 km belt</text>
          </g>
        </a>
      </g>

      <!-- Throughput tags — small mono-cap numerals outside each node. -->
      <g class="loop-throughput" font-family="var(--font-mono)" font-weight="600" letter-spacing="0.12em" fill="var(--color-ink)" style="text-transform: uppercase;">
        <!-- Field: above (north) -->
        <text x="500" y="62" text-anchor="middle" font-size="13" fill="var(--color-saffron-text)">72 TPD feedstock</text>
        <text x="500" y="82" text-anchor="middle" font-size="10" fill="var(--color-slate)">harvested inside 40 km</text>

        <!-- Plant: right (east) -->
        <text x="848" y="370" text-anchor="start" font-size="13" fill="var(--color-saffron-text)">9,600 Nm³/day</text>
        <text x="848" y="390" text-anchor="start" font-size="10" fill="var(--color-slate)">raw biogas · ≥90% CH₄</text>

        <!-- Indian Oil: below (south) -->
        <text x="500" y="694" text-anchor="middle" font-size="13" fill="var(--color-saffron-text)">4 TPD CBG · ₹46/kg floor</text>
        <text x="500" y="712" text-anchor="middle" font-size="10" fill="var(--color-slate)">15-yr Commercial Agreement</text>

        <!-- 40 km belt: left (west) -->
        <text x="152" y="370" text-anchor="end" font-size="13" fill="var(--color-saffron-text)">~365 TPA FOM</text>
        <text x="152" y="390" text-anchor="end" font-size="10" fill="var(--color-slate)">+ 52 m³/day liquid manure</text>
      </g>

      <!-- Flow labels on the saffron arcs -->
      <g class="loop-flow-labels" font-family="var(--font-mono)" font-size="11" font-weight="600" letter-spacing="0.16em" fill="var(--color-saffron-text)" text-anchor="middle" style="text-transform: uppercase;">
        <text x="664" y="510">CBG dispatch →</text>
        <text x="336" y="510">← FOM return</text>
        <text x="336" y="270">↑ Soil rebuilds</text>
        <text x="664" y="270">↓ Mass-flow in</text>
      </g>

      <!-- Centre heart: the headline figure -->
      <g class="loop-heart" text-anchor="middle">
        <circle cx="500" cy="380" r="86" fill="var(--color-paper)" stroke="var(--color-saffron)" stroke-width="1.5"></circle>
        <text x="500" y="368" font-family="var(--font-display)" font-weight="700" font-size="36" fill="var(--color-ink)" letter-spacing="-0.02em">4 TPD</text>
        <text x="500" y="395" font-family="var(--font-mono)" font-size="10" font-weight="600" letter-spacing="0.22em" fill="var(--color-saffron-text)" style="text-transform: uppercase;">CBG · FOM</text>
        <text x="500" y="416" font-family="var(--font-body)" font-size="10" fill="var(--color-slate)">every operating day</text>
      </g>
    </svg>

    <figcaption class="loop-caption">
      <p class="loop-caption-line">Nothing leaves the belt.</p>
      <p class="loop-caption-sub">The money, the fuel, and the soil all circulate inside the same forty-kilometre catchment we source from.</p>
    </figcaption>
  </figure>

  {!compact && (
    <ol class="loop-fights" role="list">
      {fights.map(f => (
        <li>
          <a href={link(f.href)} class="loop-fight-cell">
            <p class="eyebrow" style="color: var(--color-gold);">{f.eyebrow}</p>
            <p class="loop-fight-headline">{f.headline}</p>
            <p class="loop-fight-detail">{f.detail}</p>
          </a>
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  .svge-circular-loop {
    display: grid;
    gap: 2.5rem;
  }
  .loop-figure {
    margin: 0;
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .loop-figure {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .loop-figure svg {
    width: 100%;
    height: auto;
    max-height: 640px;
    display: block;
  }
  /* Saffron arc draws in when the SVG enters view (uses Base.astro's
     data-draw observer; respects prefers-reduced-motion via the
     fast-path in Base which immediately marks [data-drawn]). */
  .loop-ring path {
    stroke-dasharray: var(--draw-length, 1000);
    stroke-dashoffset: var(--draw-length, 1000);
    transition: stroke-dashoffset 1.2s cubic-bezier(0.65, 0, 0.35, 1);
  }
  [data-drawn] .loop-ring path { stroke-dashoffset: 0; }

  /* Node links: keyboard focus + hover affordance. */
  .loop-node-link {
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .loop-node-link .loop-node-halo {
    transition: opacity 0.18s ease;
  }
  .loop-node-link:hover .loop-node-halo,
  .loop-node-link:focus-visible .loop-node-halo {
    opacity: 0.55;
  }
  .loop-node-link:focus { outline: none; }
  .loop-node-link:focus-visible { outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .loop-ring path {
      stroke-dasharray: none;
      stroke-dashoffset: 0;
      transition: none;
    }
    /* Hide flow particles entirely; SMIL keeps running but the dots
       are not visible. */
    .loop-particles { display: none; }
    .loop-node-link .loop-node-halo,
    .loop-node-link:hover .loop-node-halo { transition: none; }
  }
  .loop-caption {
    text-align: left;
  }
  .loop-caption-line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    max-width: 18ch;
  }
  .loop-caption-line::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 0.875rem;
    background: var(--color-saffron);
  }
  .loop-caption-sub {
    margin-top: 1rem;
    color: var(--color-slate);
    line-height: 1.6;
    max-width: 36ch;
  }

  .loop-fights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: color-mix(in oklab, var(--color-paper) 12%, transparent);
    border-radius: 0.375rem;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .loop-fights { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .loop-fights { grid-template-columns: repeat(5, 1fr); }
  }
  .loop-fight-cell {
    display: block;
    height: 100%;
    padding: 1.25rem;
    background: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  @media (min-width: 640px) { .loop-fight-cell { padding: 1.5rem; } }
  .loop-fight-cell:hover { background: var(--color-ink-soft); }
  .loop-fight-cell:hover .eyebrow { color: var(--color-saffron) !important; }
  .loop-fight-cell:focus-visible {
    outline: 2px solid var(--color-saffron);
    outline-offset: 2px;
  }

  .loop-fight-headline {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-paper);
  }
  .loop-fight-detail {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-paper) 82%, transparent);
  }

  /* Compact variant: diagram only, no fight cards. */
  .svge-circular-loop--compact .loop-figure svg { max-height: 420px; }
</style>
