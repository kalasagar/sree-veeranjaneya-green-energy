---
/**
 * The SVGE flow, hub-and-spokes.
 *
 * Three feedstock inputs on the left feed into a central Plant node.
 * The Plant has two outputs on the right: CBG (primary product) to
 * Indian Oil, and FOM (byproduct) to the 40 km belt. A long saffron
 * return arc loops from the belt back to the farms, closing the loop.
 *
 * Geometrically honest to the physical Y-flow (a plant has two
 * outputs, not a forced clockwise circle). Reads left-to-right.
 *
 * Props:
 *   compact?: boolean — diagram only, no fight cards. Reserved for
 *     future inner-page use; not currently consumed.
 */
import { link } from '../lib/links';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const fights = [
  {
    eyebrow: 'Oil import bill',
    headline: '~80 buses/day',
    detail:
      "4 TPD CBG to Indian Oil. About a day's CNG for 80 city buses. India sends ~₹12 lakh crore abroad every year buying crude. Every cubic metre we make stays here.",
    href: '/build/#capital',
  },
  {
    eyebrow: 'Burn cycle',
    headline: '~29,000 TPA',
    detail:
      'Feedstock bought, not burned. ~14 Mt of paddy straw is set on fire across India every winter; we take ours out of that pile and pay for it.',
    href: '/farmers/',
  },
  {
    eyebrow: 'Air quality',
    headline: '5× WHO limit',
    detail:
      'Annual PM2.5 in the Indo-Gangetic plain runs five times the WHO safe limit. Stubble burning is one named cause. We remove the match in our belt.',
    href: '/plant/#glossary',
  },
  {
    eyebrow: 'Soil & fertilizer',
    headline: '~365 TPA FOM',
    detail:
      '~365 TPA of solid Fermented Organic Manure plus 52 m³/day of liquid manure goes back to the same 40 km belt we buy from. Rebuilds the organic carbon decades of chemical farming stripped out.',
    href: '/plant/#glossary',
  },
  {
    eyebrow: 'Rural cash',
    headline: '~120 jobs',
    detail:
      '47 on plant payroll, ~73 in aggregation, transport, and farmer-side roles inside 40 km. Napier at ₹1,200/t × 6 harvests/yr; payments cleared in 14 days.',
    href: '/work/',
  },
];
---
<div class={compact ? 'svge-flow svge-flow--compact' : 'svge-flow'} data-reveal>
  <figure class="flow-figure">
    <svg viewBox="0 0 1100 580" role="img" aria-labelledby="flowTitle flowDesc" preserveAspectRatio="xMidYMid meet">
      <title id="flowTitle">SVGE flow: from farms, through the plant, out to fuel and back to soil</title>
      <desc id="flowDesc">
        Three feedstock inputs on the left — paddy straw, Napier grass, cattle dung — feed into a central plant. From the plant two outputs branch right: Compressed Bio-Gas to Indian Oil as the primary product (upper arrow), and Fermented Organic Manure back to the same 40 km belt as the byproduct (lower arrow). A long saffron return arc loops from the belt back to the farms on the left, closing the loop.
      </desc>

      <defs>
        <marker id="flowArrow" viewBox="0 0 14 14" refX="11" refY="7" markerWidth="11" markerHeight="11" orient="auto">
          <path d="M0,1 L12,7 L0,13 z" fill="var(--color-saffron)"/>
        </marker>
        <marker id="flowArrowSm" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="9" markerHeight="9" orient="auto">
          <path d="M0,1 L10,6 L0,11 z" fill="var(--color-saffron)"/>
        </marker>

        <!-- Node iconography. Drawn at unit scale, translated per use. -->
        <g id="iconPaddy">
          <path d="M 0,18 Q 0,4 0,-18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          <g fill="currentColor">
            <ellipse cx="-3" cy="-14" rx="2" ry="3.5" transform="rotate(-20 -3 -14)"/>
            <ellipse cx="3" cy="-10" rx="2" ry="3.5" transform="rotate(20 3 -10)"/>
            <ellipse cx="-3" cy="-6" rx="2" ry="3.5" transform="rotate(-20 -3 -6)"/>
            <ellipse cx="3" cy="-2" rx="2" ry="3.5" transform="rotate(20 3 -2)"/>
          </g>
        </g>
        <g id="iconNapier">
          <path d="M -10,18 Q -6,2 -2,-14" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          <path d="M 0,18 Q 0,0 0,-18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          <path d="M 10,18 Q 6,2 2,-14" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </g>
        <g id="iconDung">
          <ellipse cx="0" cy="0" rx="14" ry="9" fill="currentColor"/>
          <ellipse cx="0" cy="0" rx="9" ry="5" fill="var(--color-ink)"/>
        </g>
        <g id="iconDigester">
          <path d="M -22,12 L -22,-4 A 22,22 0 0 1 22,-4 L 22,12 z" fill="currentColor"/>
          <line x1="0" y1="-22" x2="0" y2="-10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M 0,-26 Q -4,-32 0,-38 Q 4,-32 0,-26 z" fill="var(--color-saffron)"/>
        </g>
        <g id="iconFlame">
          <path d="M 0,18 Q -12,4 -8,-10 Q -3,-5 -1,-14 Q 5,-2 10,3 Q 14,14 0,18 z" fill="var(--color-saffron)"/>
          <path d="M 0,12 Q -3,5 -1,-2 Q 2,2 3,-4 Q 6,2 5,8 Q 3,12 0,12 z" fill="var(--color-gold)" opacity="0.85"/>
        </g>
        <g id="iconSeedling">
          <path d="M -16,12 L 16,12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M 0,12 L 0,-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M 0,-2 Q -6,-6 -8,-12 Q -2,-10 0,-4" fill="currentColor"/>
          <path d="M 0,-4 Q 6,-8 8,-14 Q 2,-12 0,-6" fill="currentColor"/>
        </g>
      </defs>

      <!-- COLUMN HEADERS — three numbered phases above the diagram -->
      <g class="flow-phases" font-family="var(--font-mono)" font-weight="600" letter-spacing="0.18em" text-anchor="middle" style="text-transform: uppercase;">
        <g transform="translate(140,40)">
          <text font-size="12" fill="var(--color-saffron-text)">01 · We take</text>
          <text y="16" font-size="9" fill="var(--color-slate)" letter-spacing="0.14em">From farms inside 40 km</text>
        </g>
        <g transform="translate(550,40)">
          <text font-size="12" fill="var(--color-saffron-text)">02 · We process</text>
          <text y="16" font-size="9" fill="var(--color-slate)" letter-spacing="0.14em">9,600 Nm³/day raw biogas</text>
        </g>
        <g transform="translate(960,40)">
          <text font-size="12" fill="var(--color-saffron-text)">03 · We return</text>
          <text y="16" font-size="9" fill="var(--color-slate)" letter-spacing="0.14em">Fuel out, soil back</text>
        </g>
      </g>

      <!-- CONVERGING INPUT ARROWS — three feedstock paths into the plant -->
      <g class="flow-inputs" fill="none" stroke="var(--color-saffron)" stroke-width="3" stroke-linecap="round" data-draw>
        <path d="M 200 150 Q 340 200, 458 270" marker-end="url(#flowArrow)"/>
        <path d="M 200 300 Q 340 300, 450 300" marker-end="url(#flowArrow)"/>
        <path d="M 200 450 Q 340 400, 458 330" marker-end="url(#flowArrow)"/>
      </g>

      <!-- INPUT NODES (left column) — clickable, route to /farmers -->
      <g class="flow-input-nodes">
        <a href={link('/farmers/')} class="flow-node-link" aria-label="Paddy straw — bought from farmers within 40 km">
          <g transform="translate(140,150)">
            <circle class="flow-node-halo" r="58" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="48" fill="var(--color-ink)"/>
            <g transform="translate(0,-6)" color="var(--color-gold)"><use href="#iconPaddy"/></g>
            <text y="24" font-size="10" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" style="text-transform: uppercase;">Paddy straw</text>
          </g>
        </a>
        <a href={link('/farmers/')} class="flow-node-link" aria-label="Napier grass — contract-farmed within 40 km">
          <g transform="translate(140,300)">
            <circle class="flow-node-halo" r="58" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="48" fill="var(--color-ink)"/>
            <g transform="translate(0,-4)" color="var(--color-gold)"><use href="#iconNapier"/></g>
            <text y="24" font-size="10" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" style="text-transform: uppercase;">Napier grass</text>
          </g>
        </a>
        <a href={link('/farmers/')} class="flow-node-link" aria-label="Cattle dung — collected on monthly pickup routes">
          <g transform="translate(140,450)">
            <circle class="flow-node-halo" r="58" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
            <circle r="48" fill="var(--color-ink)"/>
            <g transform="translate(0,-2)" color="var(--color-gold)"><use href="#iconDung"/></g>
            <text y="24" font-size="10" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" style="text-transform: uppercase;">Cattle dung</text>
          </g>
        </a>
      </g>

      <!-- PLANT (centre) — clickable, larger node as the heart of the operation -->
      <a href={link('/plant/')} class="flow-node-link" aria-label="Our plant — 4 CSTR digesters, 4 TPD CBG output">
        <g transform="translate(550,300)">
          <circle class="flow-node-halo" r="115" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
          <circle r="100" fill="var(--color-ink)"/>
          <g transform="translate(0,-22)" color="var(--color-gold)"><use href="#iconDigester"/></g>
          <text y="22" font-size="16" font-weight="700" letter-spacing="0.04em" fill="var(--color-paper)" font-family="var(--font-display)" text-anchor="middle">PLANT</text>
          <text y="46" font-size="9" font-weight="600" letter-spacing="0.16em" fill="var(--color-gold)" font-family="var(--font-mono)" text-anchor="middle" style="text-transform: uppercase;">4 × CSTR · 4 TPD</text>
        </g>
      </a>

      <!-- DIVERGING OUTPUT ARROWS — CBG up (primary, thick), FOM down (byproduct, thinner + dashed) -->
      <g class="flow-outputs" fill="none" stroke="var(--color-saffron)" stroke-linecap="round" data-draw>
        <path d="M 645 245 Q 770 215, 880 200" stroke-width="5" marker-end="url(#flowArrow)"/>
        <path class="flow-arc-byproduct" d="M 645 355 Q 770 385, 880 400" stroke-width="3" stroke-dasharray="9 5" marker-end="url(#flowArrowSm)"/>
      </g>

      <!-- OUTPUT ARROW TAGS — primary vs byproduct, named pre-textually -->
      <g class="flow-output-tags" font-family="var(--font-mono)" font-size="10" font-weight="700" letter-spacing="0.18em" text-anchor="middle" style="text-transform: uppercase;">
        <text x="765" y="190" fill="var(--color-ink)">Primary product · CBG</text>
        <text x="765" y="408" fill="var(--color-slate-2)">Byproduct · FOM</text>
      </g>

      <!-- OUTPUT NODES (right column) -->
      <a href={link('/build/#capital')} class="flow-node-link" aria-label="Indian Oil — 4 TPD CBG dispatched under 15-year LoI">
        <g transform="translate(960,200)">
          <circle class="flow-node-halo" r="78" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
          <circle r="68" fill="var(--color-ink)"/>
          <g transform="translate(0,-10)"><use href="#iconFlame"/></g>
          <text y="26" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" style="text-transform: uppercase;">Indian Oil</text>
        </g>
      </a>
      <a href={link('/plant/#glossary')} class="flow-node-link" aria-label="40 km belt — FOM returned to soil">
        <g transform="translate(960,400)">
          <circle class="flow-node-halo" r="78" fill="none" stroke="var(--color-saffron)" stroke-width="2" opacity="0"></circle>
          <circle r="68" fill="var(--color-ink)"/>
          <g transform="translate(0,-8)" color="var(--color-gold)"><use href="#iconSeedling"/></g>
          <text y="26" font-size="11" font-weight="600" letter-spacing="0.14em" fill="var(--color-paper)" text-anchor="middle" style="text-transform: uppercase;">40 km belt</text>
        </g>
      </a>

      <!-- RETURN ARC — long saffron curve from belt back to farms, closing the loop -->
      <g class="flow-return" fill="none" stroke="var(--color-saffron)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="3 6" opacity="0.8">
        <path d="M 960 470 Q 960 555, 550 555 Q 140 555, 140 520" marker-end="url(#flowArrowSm)"/>
      </g>
      <text x="550" y="551" text-anchor="middle" font-family="var(--font-mono)" font-size="11" font-weight="700" letter-spacing="0.22em" fill="var(--color-saffron-text)" style="text-transform: uppercase;">Soil rebuilt · back to the same farms</text>
    </svg>

    <figcaption class="flow-caption">
      <p class="flow-caption-line">Nothing leaves the belt.</p>
      <p class="flow-caption-sub">The money, the fuel, and the soil all circulate inside the same forty-kilometre catchment we source from.</p>
    </figcaption>
  </figure>

  {!compact && (
    <ol class="flow-fights" role="list">
      {fights.map(f => (
        <li>
          <a href={link(f.href)} class="flow-fight-cell">
            <p class="eyebrow" style="color: var(--color-gold);">{f.eyebrow}</p>
            <p class="flow-fight-headline">{f.headline}</p>
            <p class="flow-fight-detail">{f.detail}</p>
          </a>
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  .svge-flow {
    display: grid;
    gap: 2.5rem;
  }
  .flow-figure {
    margin: 0;
    display: grid;
    gap: 1.75rem;
  }
  .flow-figure svg {
    width: 100%;
    height: auto;
    max-height: 620px;
    display: block;
  }
  .flow-caption {
    max-width: 56ch;
    margin: 0 auto;
    text-align: center;
  }
  .flow-caption-line {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .flow-caption-line::after {
    content: "";
    display: block;
    width: 2.5rem;
    height: 2px;
    margin: 0.875rem auto 0;
    background: var(--color-saffron);
  }
  .flow-caption-sub {
    margin-top: 1rem;
    color: var(--color-slate);
    line-height: 1.55;
  }

  /* Draw-on-scroll for the saffron arrows. Uses the data-draw observer
     in Base.astro which sets --draw-length per path. */
  .flow-inputs path,
  .flow-outputs path,
  .flow-return path {
    stroke-dasharray: var(--draw-length, 1000);
    stroke-dashoffset: var(--draw-length, 1000);
    transition: stroke-dashoffset 1.2s cubic-bezier(0.65, 0, 0.35, 1);
  }
  [data-drawn].flow-inputs path,
  [data-drawn].flow-outputs path,
  [data-drawn] .flow-inputs path,
  [data-drawn] .flow-outputs path {
    stroke-dashoffset: 0;
  }
  /* Byproduct arrow keeps its dashed look post-draw (overrides). */
  .flow-outputs path.flow-arc-byproduct {
    stroke-dasharray: 9 5;
    stroke-dashoffset: 0;
    opacity: 0.78;
  }
  /* Return arc dash pattern is its own (closes the loop visually) — not part
     of the draw-on-scroll set. */
  .flow-return path { stroke-dasharray: 3 6; stroke-dashoffset: 0; transition: none; }

  /* Node link affordance */
  .flow-node-link { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .flow-node-link .flow-node-halo { transition: opacity 0.18s ease; }
  .flow-node-link:hover .flow-node-halo,
  .flow-node-link:focus-visible .flow-node-halo { opacity: 0.55; }
  .flow-node-link:focus { outline: none; }
  .flow-node-link:focus-visible { outline: none; }

  /* Five fight cards — same hairline grid pattern as TrustBand */
  .flow-fights {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: color-mix(in oklab, var(--color-paper) 12%, transparent);
    border-radius: 0.375rem;
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .flow-fights { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .flow-fights { grid-template-columns: repeat(5, 1fr); }
  }
  .flow-fight-cell {
    display: block;
    height: 100%;
    padding: 1.25rem;
    background: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  @media (min-width: 640px) { .flow-fight-cell { padding: 1.5rem; } }
  .flow-fight-cell:hover { background: var(--color-ink-soft); }
  .flow-fight-cell:hover .eyebrow { color: var(--color-saffron) !important; }
  .flow-fight-cell:focus-visible { outline: 2px solid var(--color-saffron); outline-offset: 2px; }

  .flow-fight-headline {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-paper);
  }
  .flow-fight-detail {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--color-paper) 82%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-inputs path,
    .flow-outputs path { stroke-dasharray: none; stroke-dashoffset: 0; transition: none; }
    .flow-outputs path.flow-arc-byproduct { stroke-dasharray: 9 5; }
    .flow-node-link .flow-node-halo,
    .flow-node-link:hover .flow-node-halo { transition: none; }
  }

  /* Compact variant: diagram only, no fight cards. */
  .svge-flow--compact .flow-figure svg { max-height: 460px; }
</style>
