---
/**
 * Mark — the canonical SVGE brand mark.
 *
 * Uses the raster mark_512.png (derived from the VTracer-traced mark.svg with
 * forest leaf, slate veins, saffron flame, gold accents on a paper tile). This
 * is the same artwork as the favicon and OG image — keeping it identical
 * everywhere for brand recall.
 *
 * The mark is a square brand tile by design (paper background baked in). On
 * dark backgrounds it reads as a small paper badge, like Apple's app icon on
 * a dark website.
 */
interface Props {
  size?: number;
  class?: string;
  ariaLabel?: string | null;
  rounded?: boolean;
}
const { size = 36, class: className = '', ariaLabel = 'SVGE', rounded = true } = Astro.props;
const BASE = import.meta.env.BASE_URL;
const src = `${BASE}brand/mark_512.png`.replace('//', '/');
const radius = rounded ? Math.round(size * 0.18) : 0;
---
<img
  src={src}
  alt={ariaLabel ?? ''}
  width={size}
  height={size}
  class={`svge-mark inline-block shrink-0 ${className}`}
  style={`border-radius: ${radius}px;`}
  loading="lazy"
  decoding="async"
/>
