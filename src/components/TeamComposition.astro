---
/**
 * Team composition — stacked bars per role band for plant + extended footprint.
 */
import { SITE } from '../lib/site';

const bands = SITE.team.roleBands;
const plantTotal = bands.reduce((s, b) => s + b.plant, 0);
const totalAll = bands.reduce((s, b) => s + b.plant + b.extended, 0);
const colors = ['#1B5E20', '#2C5282', '#C98E2B', '#B7472A'];
---
<section class="svge-card p-6 sm:p-8" data-reveal>
  <p class="eyebrow text-[color:var(--tone-ink)]">Team composition</p>
  <h3 class="mt-2 text-2xl text-[color:var(--color-ink)]">
    <span data-count-to={plantTotal} class="numeral-display">{plantTotal}</span> plant roles · <span data-count-to={totalAll} class="numeral-display">{totalAll}</span> total
  </h3>
  <p class="mt-2 text-sm text-[color:var(--color-slate)]">{SITE.team.localHirePolicy}</p>

  <dl class="mt-6 space-y-5">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-slate-2)] mb-2">On plant payroll · {plantTotal}</p>
      <div class="svge-bar" role="img" aria-label={`Plant headcount split into ${bands.length} bands`}>
        {bands.map((b, i) => (
          <span style={`width:${(b.plant / plantTotal) * 100}%;background:${colors[i % colors.length]};`} title={`${b.band}: ${b.plant}`}></span>
        ))}
      </div>
    </div>
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-slate-2)] mb-2">Plant + extended · {totalAll}</p>
      <div class="svge-bar" role="img" aria-label="Total jobs including extended supply chain">
        {bands.map((b, i) => (
          <span style={`width:${((b.plant + b.extended) / totalAll) * 100}%;background:${colors[i % colors.length]};opacity:0.85;`} title={`${b.band}: ${b.plant + b.extended}`}></span>
        ))}
      </div>
    </div>
  </dl>

  <ul class="mt-6 grid sm:grid-cols-2 gap-3 text-sm">
    {bands.map((b, i) => (
      <li class="flex items-baseline gap-3">
        <span class="w-3 h-3 rounded-sm flex-none mt-1.5" style={`background:${colors[i % colors.length]};`} aria-hidden="true"></span>
        <span>
          <span class="font-semibold text-[color:var(--color-ink)]">{b.band}</span>
          <span class="ml-1 font-mono text-xs text-[color:var(--color-slate-2)]">· {b.plant}{b.extended ? ` + ${b.extended} ext.` : ''}</span>
          <p class="mt-0.5 text-xs text-[color:var(--color-slate)] leading-relaxed">{b.note}</p>
        </span>
      </li>
    ))}
  </ul>

  <p class="mt-6 text-xs font-mono text-[color:var(--color-slate-2)]">Catchment radius {SITE.team.catchmentRadiusKm} km · local hire first.</p>
</section>
