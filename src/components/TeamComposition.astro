---
/**
 * Stacked role-band bars — plant payroll + extended supply chain.
 * Used in: build (#team), work (#careers paired with Countdown).
 */
import { SITE } from '../lib/site';

const bands = SITE.team.roleBands;
const plantTotal = bands.reduce((s, b) => s + b.plant, 0);
const totalAll = bands.reduce((s, b) => s + b.plant + b.extended, 0);
const colors = ['#1B5E20', '#2C5282', '#C98E2B', '#B7472A'];
---
<section class="svge-card p-6 sm:p-8" data-reveal>
  <header class="pb-5 border-b" style="border-color: var(--rule-color);">
    <p class="eyebrow" style="color: var(--color-saffron-text);">Team composition</p>
    <h3 class="mt-3 display" style="font-size: clamp(1.625rem, 2.8vw, 2.25rem);">
      <span class="numeral" data-count-to={plantTotal}>{plantTotal}</span> plant roles ·
      <span class="numeral" data-count-to={totalAll}>{totalAll}</span> total jobs
    </h3>
    <p class="mt-3 max-w-2xl" style="color: var(--color-slate);">{SITE.team.localHirePolicy}</p>
  </header>

  <dl class="mt-7 space-y-6">
    <div>
      <div class="flex items-baseline justify-between gap-3 mb-3 flex-wrap">
        <dt class="eyebrow" style="color: var(--color-ink);">On plant payroll</dt>
        <dd class="meta" style="color: var(--color-slate-2);"><span class="numeral">{plantTotal}</span> people · three shifts</dd>
      </div>
      <div class="svge-bar h-3.5" role="img" aria-label={`Plant headcount split into ${bands.length} role bands`}>
        {bands.map((b, i) => (
          b.plant > 0 ? <span style={`width:${(b.plant / plantTotal) * 100}%; background:${colors[i % colors.length]};`} title={`${b.band}: ${b.plant}`}></span> : null
        ))}
      </div>
    </div>
    <div>
      <div class="flex items-baseline justify-between gap-3 mb-3 flex-wrap">
        <dt class="eyebrow" style="color: var(--color-ink);">Plant + extended supply chain</dt>
        <dd class="meta" style="color: var(--color-slate-2);"><span class="numeral">{totalAll}</span> people · {SITE.team.catchmentRadiusKm}-km radius</dd>
      </div>
      <div class="svge-bar h-3.5" role="img" aria-label="Total jobs including extended supply chain">
        {bands.map((b, i) => (
          <span style={`width:${((b.plant + b.extended) / totalAll) * 100}%; background:${colors[i % colors.length]}; opacity:0.85;`} title={`${b.band}: ${b.plant + b.extended}`}></span>
        ))}
      </div>
    </div>
  </dl>

  <ul class="mt-8 grid sm:grid-cols-2 gap-x-6 gap-y-5" role="list">
    {bands.map((b, i) => (
      <li class="flex items-start gap-3">
        <span class="w-3 h-3 rounded-sm flex-none mt-1.5" style={`background:${colors[i % colors.length]};`} aria-hidden="true"></span>
        <div class="flex-1 min-w-0">
          <p class="flex items-baseline gap-2 flex-wrap">
            <span class="font-semibold" style="color: var(--color-ink);">{b.band}</span>
            <span class="numeral meta" style="color: var(--color-slate-2);">{b.plant}{b.extended ? ` + ${b.extended} ext.` : ' on plant'}</span>
          </p>
          <p class="mt-1 text-sm leading-relaxed" style="color: var(--color-slate);">{b.note}</p>
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-7 pt-4 meta border-t" style="color: var(--color-slate-2); border-color: var(--rule-color);">
    Hiring begins around plant commissioning (target Q3 2026). First tranche prioritises local candidates from Vizianagaram + Srikakulam.
  </p>
</section>
