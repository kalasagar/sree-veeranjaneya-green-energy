---
/**
 * Statutory clearance matrix — three columns (Obtained · Applied · After-COD).
 * Header carries the count + CPCB category badge.
 *
 * Used in: build (#clearances), plant (compact), work (compact).
 */
import { SITE } from '../lib/site';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const c = SITE.clearances;
const total = c.obtained.length + c.applied.length + c.afterCOD.length;

const columns = [
  { label: 'Obtained',  items: c.obtained, dot: 'var(--color-forest)',       weight: 'solid' as const },
  { label: 'Applied',   items: c.applied,  dot: 'var(--color-saffron)',      weight: 'solid' as const },
  { label: 'After COD', items: c.afterCOD, dot: 'var(--color-paper)',        weight: 'ring' as const },
];
---
<section class="svge-card p-6 sm:p-8" data-reveal id="clearances">
  <!-- Header: count + WHITE-category badge -->
  <header class="flex items-end justify-between gap-4 flex-wrap pb-5 border-b" style="border-color: var(--rule-color);">
    <div>
      <p class="eyebrow" style="color: var(--color-saffron-text);">Statutory clearances</p>
      <h3 class="mt-2 display" style="font-size: clamp(1.5rem, 2.6vw, 2rem); font-family: var(--font-display);">
        <span class="numeral" data-count-to={c.obtained.length}>{c.obtained.length}</span> obtained ·
        <span class="numeral" data-count-to={c.applied.length}>{c.applied.length}</span> applied ·
        <span class="numeral" data-count-to={c.afterCOD.length}>{c.afterCOD.length}</span> after-COD
      </h3>
    </div>
    <span
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs uppercase tracking-[0.18em]"
      style="background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-weight: 500;"
      title={`CPCB ${c.category} category. ${c.categoryBasis}.`}
    >
      <span class="w-2 h-2 rounded-full" style="background: var(--color-paper);" aria-hidden="true"></span>
      CPCB · {c.category}
    </span>
  </header>

  {!compact && (
    <p class="mt-4 max-w-3xl" style="color: var(--color-slate);">
      {c.categoryBasis}. Environmental Clearance is not required for energy-crop CBG plants under the EIA Notification 2006.
    </p>
  )}

  <!-- Three-column matrix -->
  <div class="mt-8 grid md:grid-cols-3 gap-px overflow-hidden rounded" style="background: var(--rule-color);">
    {columns.map(col => (
      <div class="p-5 sm:p-6" style="background: var(--color-paper);">
        <p class="eyebrow mb-4" style="color: var(--color-slate-2);">{col.label} · <span class="numeral" style="color: var(--color-ink);">{col.items.length}</span></p>
        <ul class="space-y-4" role="list">
          {col.items.map(item => (
            <li class="flex items-start gap-3 text-sm">
              <span
                class="mt-1.5 w-2.5 h-2.5 rounded-full flex-none"
                style={col.weight === 'ring'
                  ? `background: ${col.dot}; border: 1.5px solid var(--color-slate-2);`
                  : `background: ${col.dot};`}
                aria-hidden="true"
              ></span>
              <span class="flex-1">
                <span class="font-semibold" style="color: var(--color-ink);">{item.item}</span><br/>
                <span class="meta" style="color: var(--color-slate-2);">{item.authority}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {!compact && (
    <p class="mt-6 meta" style="color: var(--color-slate-2);">
      {total} clearances total, sequenced against the LoI commissioning clock. Andhra Pradesh exempts CBG plants from a separate pre-construction fire NOC.
    </p>
  )}
</section>
