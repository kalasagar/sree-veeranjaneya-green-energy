---
const { eyebrow, title, narrow } = Astro.props as { eyebrow?: string; title?: string; narrow?: boolean };
---
<section class={`mx-auto px-4 sm:px-6 py-12 sm:py-16 ${narrow ? 'max-w-3xl' : 'max-w-6xl'}`}>
  {(eyebrow || title) && (
    <header class="mb-8">
      {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-[color:var(--color-saffron-text)] mb-2">{eyebrow}</p>}
      {title && <h2 class="text-2xl sm:text-3xl">{title}</h2>}
    </header>
  )}
  <slot />
</section>
