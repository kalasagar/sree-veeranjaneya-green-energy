---
/**
 * Editorial section wrapper. Eyebrow + display title + slot.
 */
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  bg?: 'paper' | 'paper-2' | 'ink';
  narrow?: boolean;
  lede?: string;
}
const { id, eyebrow, title, bg = 'paper', narrow = false, lede } = Astro.props;
const bgClass = bg === 'paper-2' ? 'section-paper-2' : bg === 'ink' ? 'section-ink' : '';
---
<section id={id} class={`section ${bgClass}`}>
  <div class={narrow ? 'container-narrow' : 'container-svge'}>
    {(eyebrow || title) && (
      <header class="mb-8 sm:mb-12" data-reveal>
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        {title && <h2 class="display max-w-[24ch]">{title}</h2>}
        {lede && <p class="lede mt-5">{lede}</p>}
      </header>
    )}
    <slot />
  </div>
</section>
