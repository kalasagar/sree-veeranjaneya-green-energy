---
/**
 * Magazine deck under each hero.
 */
interface Props {
  eyebrow?: string;
  deck: string;
}
const { eyebrow, deck } = Astro.props;
---
<section class="kicker">
  <div class="container-svge">
    {eyebrow && <p class="eyebrow kicker-eyebrow">{eyebrow}</p>}
    <div class="kicker-rule mt-3"></div>
    <h2 class="kicker-deck mt-4"><Fragment set:html={deck} /></h2>
  </div>
</section>
