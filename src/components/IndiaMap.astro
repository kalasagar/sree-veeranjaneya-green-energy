---
/**
 * Static SVG India outline (very simplified) showing:
 *   - the Indo-Gangetic smog corridor (light saffron shading)
 *   - the paddy belt (forest-green hatching)
 *   - SVGE plant location pin (saffron flag)
 *
 * Pure SVG, no JS, no external tile fetches.
 */
import { SITE } from '../lib/site';

// Lat/lng to a hand-tuned SVG coordinate system covering mainland India.
// Origin top-left, viewBox 0 0 600 700.
const projectLatLng = (lat: number, lng: number) => {
  const minLng = 68, maxLng = 97;
  const minLat = 6, maxLat = 37;
  const x = ((lng - minLng) / (maxLng - minLng)) * 600;
  const y = 700 - ((lat - minLat) / (maxLat - minLat)) * 700;
  return { x, y };
};
const plant = projectLatLng(SITE.plant.lat, SITE.plant.lng);
---
<figure class="svge-card p-6 sm:p-8" data-reveal>
  <header class="pb-5 mb-5 border-b" style="border-color: var(--rule-color);">
    <p class="eyebrow" style="color: var(--color-saffron-text);">India in context</p>
    <h3 class="mt-3 display" style="font-size: clamp(1.5rem, 2.6vw, 2rem); max-width: 28ch;">Paddy belt · smog corridor · SVGE.</h3>
  </header>
  <svg viewBox="0 0 600 700" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto" role="img" aria-label="Map of India with paddy belt, smog corridor, and SVGE plant location.">
    <defs>
      <pattern id="paddy-hatch" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(40)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="#1B5E20" stroke-width="1.2" opacity="0.45"/>
      </pattern>
    </defs>

    <!-- Simplified India outline (hand-traced approximation, mainland only) -->
    <path d="
      M 230 60
      C 250 30, 320 30, 360 70
      L 420 100
      C 460 120, 490 160, 500 200
      L 520 260
      C 540 300, 540 340, 520 380
      L 480 440
      C 460 500, 420 560, 360 620
      L 320 660
      L 280 680
      L 240 660
      L 200 600
      L 170 520
      L 140 440
      L 110 360
      L 90 280
      L 100 200
      L 130 140
      L 180 90
      Z
    " fill="#FAFAF7" stroke="#37474F" stroke-width="2.2" opacity="0.9"/>

    <!-- Indo-Gangetic smog corridor (Punjab to West Bengal arc) -->
    <path d="
      M 160 180
      Q 250 140, 360 150
      Q 440 170, 470 220
      L 460 250
      Q 380 200, 290 200
      Q 220 210, 175 230
      Z
    " fill="#E65100" opacity="0.18"/>

    <!-- Paddy belt (very rough — east India + AP) -->
    <path d="
      M 320 180
      Q 430 200, 460 270
      Q 470 360, 440 430
      Q 410 510, 360 560
      L 320 540
      Q 340 460, 360 380
      Q 340 280, 320 180
      Z
    " fill="url(#paddy-hatch)" opacity="0.7"/>

    <!-- Plant location pin -->
    <g transform={`translate(${plant.x}, ${plant.y})`}>
      <circle r="9" fill="#E65100" stroke="#FAFAF7" stroke-width="2"/>
      <line x1="0" y1="-8" x2="0" y2="-26" stroke="#E65100" stroke-width="2.5"/>
      <polygon points="0,-26 14,-22 0,-18" fill="#E65100"/>
    </g>
    <text x={plant.x + 18} y={plant.y + 4} font-family="ui-monospace, monospace" font-size="14" fill="#37474F" font-weight="600">SVGE · Thatipadu</text>

    <!-- Legend -->
    <g transform="translate(40, 540)">
      <rect width="18" height="14" fill="#E65100" opacity="0.25" rx="2"/>
      <text x="26" y="12" font-family="ui-monospace, monospace" font-size="12" fill="#37474F">Indo-Gangetic smog corridor</text>

      <rect y="22" width="18" height="14" fill="url(#paddy-hatch)" rx="2"/>
      <text x="26" y="34" font-family="ui-monospace, monospace" font-size="12" fill="#37474F">Paddy belt</text>

      <circle cx="9" cy="52" r="6" fill="#E65100" stroke="#FAFAF7" stroke-width="1.5"/>
      <text x="26" y="56" font-family="ui-monospace, monospace" font-size="12" fill="#37474F">SVGE plant</text>
    </g>
  </svg>
  <figcaption class="mt-5 pt-4 meta border-t" style="color: var(--color-slate-2); border-color: var(--rule-color);">
    Simplified outline. Sources: paddy belt (Min. of Agriculture &amp; Farmers' Welfare); smog corridor (CPCB / IIT-Kanpur source apportionment studies). SVGE pin at <span class="numeral">{SITE.plant.lat.toFixed(4)}°N, {SITE.plant.lng.toFixed(4)}°E</span>.
  </figcaption>
</figure>
