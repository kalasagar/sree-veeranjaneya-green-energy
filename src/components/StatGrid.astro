---
interface Stat { v: string; k: string; sub?: string }
const { stats } = Astro.props as { stats: Stat[] };
---
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
  {stats.map((s) => (
    <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-4 sm:p-5">
      <div class="text-2xl sm:text-3xl font-bold text-[color:var(--color-forest)]">{s.v}</div>
      <div class="text-xs mt-1 font-mono uppercase tracking-wider text-[color:var(--color-slate-2)]">{s.k}</div>
      {s.sub && <div class="text-xs mt-1 text-[color:var(--color-slate-2)]">{s.sub}</div>}
    </div>
  ))}
</div>
