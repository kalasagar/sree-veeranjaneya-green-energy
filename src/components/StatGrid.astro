---
interface Props { stats: { v: string; k: string; sub?: string }[]; }
const { stats } = Astro.props;
---
<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background: var(--rule-color);" data-reveal>
  {stats.map(s => (
    <article class="p-6 sm:p-8" style="background: var(--color-paper);">
      <p class="eyebrow mb-3">{s.k}</p>
      <p class="display" style="font-size: clamp(2rem, 4vw, 3rem);">{s.v}</p>
      {s.sub && <p class="meta mt-2">{s.sub}</p>}
    </article>
  ))}
</div>
