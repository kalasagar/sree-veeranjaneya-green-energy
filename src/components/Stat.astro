---
interface Props { value: string; unit?: string; label: string; framing?: string; }
const { value, unit, label, framing } = Astro.props;
---
<article class="svge-card p-6" data-reveal>
  <p class="eyebrow">{label}</p>
  <p class="mt-3 flex items-baseline gap-2">
    <span class="display" style="font-size: clamp(2.5rem, 5vw, 4rem);">{value}</span>
    {unit && <span class="eyebrow">{unit}</span>}
  </p>
  {framing && <p class="mt-3 text-sm text-[color:var(--color-slate)] leading-relaxed">{framing}</p>}
</article>
