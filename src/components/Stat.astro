---
import type { Stat as StatT } from '../lib/site';
interface Props { stat: StatT; large?: boolean }
const { stat, large = false } = Astro.props;
---
<article class={`svge-card p-5 sm:p-6 ${large ? 'sm:p-8' : ''}`}>
  <div class="flex items-baseline gap-1">
    <span class={`font-bold text-[color:var(--color-forest)] tracking-tight ${large ? 'text-4xl sm:text-5xl' : 'text-3xl sm:text-4xl'}`}>{stat.value}</span>
    {stat.unit && <span class="text-base sm:text-lg font-mono text-[color:var(--color-slate-2)]">{stat.unit}</span>}
  </div>
  <div class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-slate-2)] mt-2">{stat.k}</div>
  {stat.framing && <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-slate)]">{stat.framing}</p>}
  {stat.source && (
    <p class="mt-2 text-[11px] font-mono text-[color:var(--color-slate-2)]">
      Source: {stat.source.url ? <a href={stat.source.url} rel="noopener noreferrer">{stat.source.label}</a> : stat.source.label}
    </p>
  )}
</article>
