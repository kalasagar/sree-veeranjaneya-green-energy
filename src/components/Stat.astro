---
/**
 * Editorial stat card. Eyebrow label + display numeral + optional framing.
 * Used in: index home, build plant snapshot, work team stats.
 *
 * Sizing strategy: clamp the numeral display to a range that holds for both
 * short values ("4 TPD") and longer ones ("₹33", "9,600"). Unit is a distinct
 * mono chip below the number — not the same weight as the label.
 */
interface Props {
  value: string;
  unit?: string;
  label: string;
  framing?: string;
  /** Opt-in count-up animation; only fires for numeric-prefix values. */
  animate?: boolean;
  /** Optional source/citation badge. */
  source?: string;
}
const { value, unit, label, framing, animate = false, source } = Astro.props;
const numericMatch = animate ? value.match(/^([₹$£€]?)([\d,.]+)(.*)$/) : null;
const numericTo = numericMatch ? parseFloat(numericMatch[2].replace(/,/g, '')) : null;
---
<article class="svge-card p-6 sm:p-7 flex flex-col h-full" data-reveal>
  <p class="eyebrow">{label}</p>
  <p class="mt-3 leading-none">
    {numericTo !== null
      ? <span class="numeral text-[color:var(--color-ink)] block" style="font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 4.2vw, 3.25rem); letter-spacing: -0.02em;" data-count-to={numericTo} data-prefix={numericMatch![1]} data-suffix={numericMatch![3]} data-thousands="true">{value}</span>
      : <span class="numeral text-[color:var(--color-ink)] block" style="font-family: var(--font-display); font-weight: 700; font-size: clamp(2.25rem, 4.2vw, 3.25rem); letter-spacing: -0.02em;">{value}</span>
    }
  </p>
  {unit && <p class="mt-2"><span class="inline-block px-2 py-0.5 rounded text-[10px] tracking-[0.18em] uppercase" style="background: var(--color-paper-2); color: var(--color-slate); font-family: var(--font-mono);">{unit}</span></p>}
  {framing && <p class="mt-4 text-sm leading-relaxed flex-1" style="color: var(--color-slate);">{framing}</p>}
  {source && <p class="mt-4 text-[10px] tracking-[0.22em] uppercase pt-3 border-t border-[color:var(--rule-color)]" style="font-family: var(--font-mono); color: var(--color-slate-2);">{source}</p>}
</article>
