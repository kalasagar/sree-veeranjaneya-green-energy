---
/**
 * Magazine-cover audience router. Seven numbered rows, each linking to the
 * page that best serves that audience.
 *
 * Used on home + contact. Replaces the older IntentChooser.
 */
import { link } from '../lib/links';

const audiences = [
  { num: '01', who: 'IOCL / SATAT officials',     want: 'Spec compliance, LoI status, dispatch logistics',     href: '/plant/',              anchor: 'Spec + flow' },
  { num: '02', who: 'Term lenders',                want: 'Capital flow, clearance status, commissioning clock',  href: '/build/',              anchor: 'The build, in numbers' },
  { num: '03', who: 'Farmers + aggregators',       want: '40-km radius, payment cadence, contract terms',        href: '/farmers/',            anchor: 'Your land, our radius' },
  { num: '04', who: 'EPC / logistics partners',    want: 'Open RFPs by category, direct intake',                 href: '/work/#rfps',          anchor: 'Open RFPs' },
  { num: '05', who: 'Future hires',                want: 'Role bands, hiring tranches, local-hire policy',       href: '/work/#careers',       anchor: '47 plant, 120 total' },
  { num: '06', who: 'Journalists',                 want: 'Brand pack, fast facts, build journal',                href: '/press/',              anchor: 'Press kit + journal' },
  { num: '07', who: 'State / district officials',  want: 'Clearance matrix, WHITE-category basis, jobs map',     href: '/build/#clearances',   anchor: 'Clearances' },
];
---
<section class="svge-card overflow-hidden p-0" data-reveal>
  <!-- Magazine cover header -->
  <header class="px-6 sm:px-10 py-8 sm:py-10" style="background: var(--color-ink); color: var(--color-paper);">
    <p class="eyebrow" style="color: var(--color-gold);">Seven audiences · seven destinations</p>
    <h3 class="mt-3 display" style="font-family: var(--font-display); color: var(--color-paper); font-size: clamp(1.75rem, 4vw, 2.75rem); line-height: 1.05; max-width: 18ch;">Pick the door that fits.</h3>
    <span class="block mt-5 w-12 h-px" style="background: var(--color-saffron);" aria-hidden="true"></span>
  </header>

  <!-- Numbered rows -->
  <ol role="list">
    {audiences.map((a, i) => (
      <li class={i > 0 ? 'border-t' : ''} style="border-color: var(--rule-color);">
        <a
          href={link(a.href)}
          class="grid grid-cols-[44px_1fr_auto] items-center gap-4 sm:gap-6 px-6 sm:px-10 py-6 no-underline group transition-colors duration-150"
          style="color: var(--color-ink);"
        >
          <span class="numeral text-2xl" style="font-family: var(--font-mono); color: var(--color-slate-2); transition: color 150ms ease;">{a.num}</span>
          <div class="min-w-0">
            <p class="text-lg sm:text-xl font-semibold leading-tight" style="color: var(--color-ink); font-family: var(--font-display); font-weight: 700; letter-spacing: -0.01em;">{a.who}</p>
            <p class="text-sm mt-1" style="color: var(--color-slate);">{a.want}</p>
          </div>
          <span class="hidden sm:flex flex-col items-end text-right gap-1">
            <span class="eyebrow" style="color: var(--color-saffron-text);">{a.anchor}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-1" style="color: var(--color-saffron-text);">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .svge-card ol li:hover { background: color-mix(in oklab, var(--color-saffron) 6%, transparent); }
  .svge-card ol li:hover .numeral { color: var(--color-saffron-text) !important; }
</style>
