---
/**
 * Capital flow — public-side only. Shows the three central-government
 * incentive schemes that anchor the public side of the capital stack
 * (MNRE CFA, AGRL, FOM MDA). Private-side structure (source names,
 * sizing, lender identity) is not published on the public site; it
 * sits with qualified lenders in the data room on request.
 *
 * Used on /build #capital.
 */
import { SITE } from '../lib/site';

const incentSchemes = [
  {
    label: 'MNRE CFA',
    issuer: 'Ministry of New & Renewable Energy',
    note: 'Capital Financial Assistance under the Phase-I National Bioenergy Programme.',
  },
  {
    label: 'AGRL Ministry',
    issuer: 'Agriculture & Rural support',
    note: 'Central-government rural support component, sequenced against the build clock.',
  },
  {
    label: 'FOM MDA',
    issuer: 'Ministry of Chemicals & Fertilizers',
    note: 'Market Development Assistance, applied per tonne of Fermented Organic Manure dispatched after commissioning.',
  },
];
---
<section class="svge-card p-6 sm:p-8" data-reveal id="capital-flow">
  <header class="pb-5 border-b" style="border-color: var(--rule-color);">
    <p class="eyebrow" style="color: var(--color-saffron-text);">Capital · public side</p>
    <h3 class="mt-3 display" style="font-size: clamp(1.625rem, 2.8vw, 2.25rem); max-width: 26ch;">
      Three central-government incentives. All confirmed against the project.
    </h3>
    <p class="mt-3 max-w-2xl" style="color: var(--color-slate);">
      The public-money side of the capital stack is on this page. The private-financing structure (sources, sizing, lender identity) sits with qualified lenders in the data room — not on the public site.
    </p>
  </header>

  <!-- Central incentive schemes (named, no rupees) -->
  <div class="mt-7">
    <p class="eyebrow mb-4" style="color: var(--color-saffron-text);">Central incentive schemes</p>
    <div class="grid sm:grid-cols-3 gap-px overflow-hidden rounded" style="background: var(--rule-color);">
      {incentSchemes.map(s => (
        <article class="p-5 sm:p-6 flex flex-col" style="background: var(--color-paper);">
          <p class="eyebrow" style="color: var(--color-ink);">{s.label}</p>
          <p class="mt-3 text-sm" style="color: var(--color-slate-2); font-family: var(--font-mono); letter-spacing: 0.06em;">{s.issuer}</p>
          <p class="mt-3 meta leading-relaxed flex-1" style="color: var(--color-slate-2);">{s.note}</p>
        </article>
      ))}
    </div>
  </div>

  <p class="mt-6 meta" style="color: var(--color-slate-2);">
    Plus a <span class="numeral">{SITE.financing.taxHolidayYears}</span>-year income-tax holiday for CBG plants under the Income Tax Act. The full capital structure reconciles in the <a href="#dataroom">data room</a> on request.
  </p>
</section>
