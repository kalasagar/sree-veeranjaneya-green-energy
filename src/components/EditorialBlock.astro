---
const BASE = import.meta.env.BASE_URL;
const asset = (p: string) => `${BASE}${p.replace(/^\//, '')}`.replace('//', '/');
interface Props {
  side?: 'left' | 'right';
  numeral?: string;
  title?: string;
  image?: string | null;
  imageAlt?: string;
}
const { side = 'left', numeral, title, image, imageAlt = '' } = Astro.props;
---
<div class={`grid lg:grid-cols-[1fr_1.2fr] gap-8 lg:gap-16 items-start ${side === 'right' ? 'lg:[&>*:first-child]:order-2' : ''}`} data-reveal>
  {image
    ? <figure class="overflow-hidden rounded"><img src={asset(`banners/${image}.avif`)} alt={imageAlt} loading="lazy" class="w-full h-full object-cover" /></figure>
    : <div class="hidden lg:block"></div>}
  <div>
    {numeral && <p class="numeral text-3xl" style="color: var(--color-saffron-text);">{numeral}</p>}
    {title && <h3 class="display mt-3 max-w-[20ch]" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{title}</h3>}
    <div class="prose-svge mt-5"><slot /></div>
  </div>
</div>
