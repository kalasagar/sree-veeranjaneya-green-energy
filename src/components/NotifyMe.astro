---
/**
 * NotifyMe — single-field email signup card.
 *
 * Posts to the same Formspree placeholder as the contact form with a `topic`
 * field so messages route correctly. Used on /news/, /farmers/, /careers/.
 *
 * Props:
 *   - topic: routing label appended as a hidden field
 *   - eyebrow / title / body: copy variations per surface
 *   - cta: button label (defaults to "Notify me")
 *   - tone: 'paper' (default) or 'ink' (dark background variant)
 *
 * Honeypot field `company_hp` mirrors the contact form's spam protection.
 */
import Icon from './Icon.astro';
interface Props {
  topic: string;
  eyebrow?: string;
  title: string;
  body?: string;
  cta?: string;
  tone?: 'paper' | 'ink';
}
const {
  topic,
  eyebrow = 'Stay in the loop',
  title,
  body,
  cta = 'Notify me',
  tone = 'paper',
} = Astro.props;
const dark = tone === 'ink';
const cardClass = dark
  ? 'bg-[color:var(--color-ink)] text-[color:var(--color-paper)] border border-[color:var(--color-paper)]/10'
  : 'bg-[color:var(--color-forest)] text-[color:var(--color-paper)] border border-[color:var(--color-forest)]';
---
<aside class={`svge-notify svge-card p-6 sm:p-10 ${cardClass}`} data-reveal>
  <p class="eyebrow mb-3" style="color: var(--color-gold);">{eyebrow}</p>
  <h3 class="text-2xl sm:text-3xl leading-tight mb-3" style="font-family: var(--font-display); font-weight: 700; letter-spacing: -0.015em; color: var(--color-paper);">{title}</h3>
  <div class="mb-5 w-10 h-px" style="background: var(--color-saffron);" aria-hidden="true"></div>
  {body && <p class="text-base text-[color:var(--color-paper)]/85 mb-6 leading-relaxed max-w-[55ch]">{body}</p>}
  <form
    action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID"
    method="POST"
    class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center"
    data-notify
  >
    <input type="hidden" name="topic" value={topic} />
    <input type="hidden" name="_subject" value={`Notify: ${topic}`} />
    {/* honeypot — hidden from humans */}
    <label class="sr-only" aria-hidden="true">
      Company (leave blank)
      <input type="text" name="company_hp" tabindex="-1" autocomplete="off" />
    </label>
    <label class="flex-1 min-w-0">
      <span class="sr-only">Your email</span>
      <input
        required
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        class="w-full rounded-md bg-[color:var(--color-paper)] text-[color:var(--color-ink)] px-4 py-3 text-base placeholder:text-[color:var(--color-slate-2)]/70 focus:outline-none focus:ring-2 focus:ring-[color:var(--color-saffron)]"
      />
    </label>
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 font-semibold transition-colors duration-150 bg-[color:var(--color-saffron-text)] text-[color:var(--color-paper)] hover:bg-[color:var(--color-saffron)] cursor-pointer"
    >
      <span>{cta}</span>
      <Icon name="arrow-right" size={16} />
    </button>
  </form>
  <p class="mt-3 text-xs text-[color:var(--color-paper)]/65 leading-relaxed max-w-[55ch]">
    One email per update. No tracking, no third-party newsletter platform. Unsubscribe by replying with "stop".
  </p>
  <p class="svge-notify-status mt-3 text-sm" aria-live="polite"></p>
</aside>
<script>
  // Progressive enhancement: hijack submit for JSON post + inline status.
  // Falls back to a native POST + Formspree thank-you page if JS disabled.
  document.querySelectorAll<HTMLFormElement>('form[data-notify]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('.svge-notify-status');
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const orig = btn?.textContent;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
      if (status) { status.textContent = ''; status.style.color = ''; }
      try {
        const r = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (r.ok) {
          form.reset();
          if (status) { status.textContent = "Thanks. You're on the list. We'll be in touch."; status.style.color = '#FFB300'; }
        } else if (form.action.includes('REPLACE_WITH_FORMSPREE_ID')) {
          if (status) { status.textContent = 'Form not yet wired in dev. Email svge.india@gmail.com.'; status.style.color = '#FFB300'; }
        } else {
          if (status) { status.textContent = `Could not subscribe. Please email svge.india@gmail.com directly. (${r.status})`; status.style.color = '#FFB300'; }
        }
      } catch {
        if (status) { status.textContent = 'Network error. Please email svge.india@gmail.com directly.'; status.style.color = '#FFB300'; }
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = orig || 'Notify me'; }
      }
    });
  });
</script>
