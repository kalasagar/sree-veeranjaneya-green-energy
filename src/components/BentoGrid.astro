---
import Stat from './Stat.astro';
interface Props {
  hero: { value: string; unit?: string; k: string; framing?: string };
  supporting: { value: string; unit?: string; k: string; framing?: string }[];
}
const { hero, supporting } = Astro.props;
---
<div class="grid lg:grid-cols-[1.6fr_1fr] gap-4" data-reveal>
  <article class="svge-card p-8 sm:p-12" style="background: var(--color-ink); color: var(--color-paper);">
    <p class="eyebrow" style="color: color-mix(in oklab, var(--color-paper) 70%, transparent);">{hero.k}</p>
    <p class="mt-4 mega" style="color: var(--color-paper);" data-count-target>
      <span data-count-to={hero.value.replace(/[^0-9.]/g, '')} data-thousands="true">{hero.value}</span>{hero.unit && <span class="ml-2 eyebrow" style="color: color-mix(in oklab, var(--color-paper) 70%, transparent);">{hero.unit}</span>}
    </p>
    {hero.framing && <p class="mt-5 max-w-[40ch] leading-relaxed" style="color: color-mix(in oklab, var(--color-paper) 85%, transparent);">{hero.framing}</p>}
  </article>
  <div class="grid sm:grid-cols-1 gap-4">
    {supporting.map(s => <Stat value={s.value} unit={s.unit} label={s.k} framing={s.framing} />)}
  </div>
</div>
