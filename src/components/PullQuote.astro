---
interface Props { quote: string; attribution?: string; draft?: boolean; }
const { quote, attribution, draft } = Astro.props;
---
<figure class="my-8 pl-6 sm:pl-8 border-l-2 border-[color:var(--color-saffron)]" data-reveal>
  <blockquote class="text-2xl sm:text-3xl leading-snug" style="font-family: var(--font-display); font-style: italic; color: var(--color-ink);">
    "{quote}"
  </blockquote>
  {(attribution || draft) && (
    <figcaption class="mt-3 meta">
      {attribution && <span>— {attribution}</span>}
      {draft && <span class="ml-2 px-2 py-0.5 rounded" style="background: var(--color-paper-3); color: var(--color-saffron-text);">[Draft — pending founder approval]</span>}
    </figcaption>
  )}
</figure>
