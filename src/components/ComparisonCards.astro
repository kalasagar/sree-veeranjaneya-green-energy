---
/**
 * "What 4 TPD looks like" — six editorial cards.
 * Each card: label · display numeral · framing · source line.
 * Used on /build #impact.
 */
import { SITE } from '../lib/site';
const cards = SITE.comparisons;
---
<section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px overflow-hidden rounded" style="background: var(--rule-color);" data-reveal role="list">
  {cards.map((c) => (
    <article class="p-6 sm:p-7 flex flex-col" style="background: var(--color-paper);" role="listitem">
      <p class="eyebrow" style="color: var(--color-saffron-text);">{c.label}</p>
      <p class="mt-4 leading-none">
        <span class="numeral" style="font-family: var(--font-display); font-weight: 700; color: var(--color-ink); font-size: clamp(2rem, 3.5vw, 2.875rem); letter-spacing: -0.02em;">{c.value}</span>
      </p>
      <p class="mt-2"><span class="meta inline-block px-2 py-0.5 rounded" style="background: var(--color-paper-2); color: var(--color-slate); font-family: var(--font-mono);">{c.unit}</span></p>
      <p class="mt-5 text-sm leading-relaxed flex-1" style="color: var(--color-slate);">{c.framing}</p>
      <p class="mt-5 pt-4 border-t meta" style="color: var(--color-slate-2); border-color: var(--rule-color); font-family: var(--font-mono);">{c.source}</p>
    </article>
  ))}
</section>
