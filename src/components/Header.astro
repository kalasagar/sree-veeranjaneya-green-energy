---
/**
 * Editorial masthead — sticky, minimal, accessible.
 * Header opacity & visibility logic preserved from V3.
 */
import { SITE } from '../lib/site';
import { link, stripBase } from '../lib/links';
import Mark from './Mark.astro';

const path = stripBase(Astro.url.pathname);
const { heroOver = false } = Astro.props as { heroOver?: boolean };
---
<header id="svge-header" class={`svge-header ${heroOver ? 'is-over' : ''}`} data-hero-page={heroOver ? '' : undefined}>
  <div class="container-svge flex items-center justify-between gap-6">
    <a href={link('/')} class="svge-h-brand flex items-center gap-3 no-underline group" aria-label="SVGE — home">
      <Mark size={36} decorative />
      <span class="flex flex-col leading-tight">
        <span class="svge-h-wordmark text-base font-semibold tracking-tight" style="font-family: var(--font-display); color: var(--color-ink);">SVGE</span>
        <span class="svge-h-tagline hidden sm:inline meta" style="color: var(--color-slate-2);">Grass to Gas · Farm to Fuel</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-0" aria-label="Primary">
      {SITE.nav.slice(1).map(n => {
        const active = path === n.href || (path.startsWith(n.href) && n.href !== '/');
        return (
          <a
            href={link(n.href)}
            aria-current={active ? 'page' : undefined}
            class={`svge-h-link relative px-3 py-2 min-h-[44px] inline-flex items-center text-sm no-underline transition-colors duration-150 ${active ? 'is-active' : ''}`}
            style="text-decoration: none;"
          >{n.label}</a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a href={link('/contact/')} class="svge-h-cta btn btn-ghost hidden lg:inline-flex" style="height:40px;padding:0 18px;">
        Talk to us
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <button id="svge-drawer-open" type="button" aria-label="Open navigation menu" aria-controls="svge-drawer" aria-expanded="false"
              class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="svge-drawer-backdrop" hidden class="fixed inset-0 z-50 bg-[color:var(--color-ink)]/60 opacity-0 data-[open]:opacity-100 transition-opacity duration-200"></div>
<aside id="svge-drawer" role="dialog" aria-modal="true" aria-label="Site navigation" hidden
       class="fixed top-0 right-0 z-50 h-full w-[min(88vw,360px)] bg-[color:var(--color-paper)] border-l-2 border-[color:var(--color-saffron)] shadow-2xl translate-x-full data-[open]:translate-x-0 transition-transform duration-250">
  <div class="flex items-center justify-between p-5 border-b border-[color:var(--rule-color)]">
    <a href={link('/')} class="flex items-center gap-3 no-underline">
      <Mark size={36} decorative />
      <span class="font-semibold" style="font-family: var(--font-display); color: var(--color-ink);">SVGE</span>
    </a>
    <button id="svge-drawer-close" type="button" aria-label="Close navigation menu"
            class="inline-flex items-center justify-center w-11 h-11 rounded">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <nav class="p-5">
    <p class="eyebrow mb-3">Pages</p>
    <ul class="space-y-1">
      {SITE.nav.slice(1).map(n => {
        const active = path === n.href || (path.startsWith(n.href) && n.href !== '/');
        return (
          <li>
            <a href={link(n.href)} aria-current={active ? 'page' : undefined}
               class={`block px-3 py-3 rounded text-lg no-underline ${active ? 'bg-[color:var(--color-paper-2)] text-[color:var(--color-saffron-text)] font-semibold' : 'hover:bg-[color:var(--color-paper-2)]'}`}
               style="text-decoration:none;">{n.label}</a>
          </li>
        );
      })}
    </ul>
    <a href={link('/contact/')} class="btn btn-primary w-full justify-center mt-6">Talk to us →</a>
  </nav>
</aside>

<script is:inline data-astro-rerun>
  (function () {
    var openBtn = document.getElementById('svge-drawer-open');
    var closeBtn = document.getElementById('svge-drawer-close');
    var backdrop = document.getElementById('svge-drawer-backdrop');
    var drawer = document.getElementById('svge-drawer');
    if (!openBtn || !drawer || !backdrop || !closeBtn) return;

    var lastFocus = null;
    function open() {
      lastFocus = document.activeElement;
      drawer.hidden = false; backdrop.hidden = false;
      requestAnimationFrame(function () { drawer.dataset.open = ''; backdrop.dataset.open = ''; });
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
    }
    function close() {
      delete drawer.dataset.open; delete backdrop.dataset.open;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      setTimeout(function () { drawer.hidden = true; backdrop.hidden = true; lastFocus && lastFocus.focus && lastFocus.focus(); }, 220);
    }
    function onKey(e) { if (e.key === 'Escape') { e.preventDefault(); close(); } }
    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    drawer.querySelectorAll('a[href]').forEach(function (a) { a.addEventListener('click', close); });

    // Header is always position: fixed. On hero pages it starts in
    // "over" mode (transparent + scrim does legibility) and switches
    // to "solid" mode (paper + backdrop-blur) past the threshold.
    // The class swap is purely visual — no position-mode change.
    var header = document.getElementById('svge-header');
    if (header && header.dataset.heroPage !== undefined) {
      var threshold = 80;
      var lastOver = null;
      function onScroll() {
        var over = window.scrollY <= threshold;
        if (over === lastOver) return;
        lastOver = over;
        if (over) header.classList.add('is-over');
        else header.classList.remove('is-over');
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  })();
</script>
