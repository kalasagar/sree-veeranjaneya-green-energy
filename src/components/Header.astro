---
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 backdrop-blur bg-[color:var(--color-paper)]/85 border-b border-[color:var(--color-slate-2-soft)]/30">
  <div class="container-svge">
    <nav class="flex items-center justify-between gap-6 h-16 sm:h-20">
      <a href="/" class="flex items-center gap-3 no-underline">
        <img src="/brand/mark.svg" alt="SVGE mark" width="36" height="36" />
        <span class="flex flex-col leading-tight">
          <span class="text-sm font-semibold text-[color:var(--color-forest)] tracking-tight">SVGE</span>
          <span class="hidden sm:inline text-[11px] text-[color:var(--color-slate-2)] font-mono">Grass to Gas. Farm to Fuel.</span>
        </span>
      </a>
      <ul class="flex items-center gap-0 sm:gap-1 lg:gap-3 overflow-x-auto -mr-4 sm:mr-0 pr-4 sm:pr-0 text-sm">
        {SITE.nav.slice(1).map((n) => {
          const active = path === n.href || (path.startsWith(n.href) && n.href !== '/');
          return (
            <li class="shrink-0">
              <a
                href={n.href}
                aria-current={active ? 'page' : undefined}
                class={`px-3 py-2 min-h-[44px] inline-flex items-center no-underline whitespace-nowrap transition-colors duration-150 ease-out ${active ? 'text-[color:var(--color-forest)] font-semibold border-b-2 border-[color:var(--color-saffron)]' : 'text-[color:var(--color-slate)] hover:text-[color:var(--color-saffron-text)]'}`}
              >{n.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
