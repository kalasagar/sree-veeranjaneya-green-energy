---
import { SITE } from '../lib/site';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 backdrop-blur bg-[color:var(--color-paper)]/85 border-b border-black/5">
  <nav class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/brand/mark.svg" alt="SVGE mark" width="36" height="36" />
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="text-sm font-semibold text-[color:var(--color-forest)] tracking-tight">{SITE.short} · Sree Veeranjaneya</span>
        <span class="text-[11px] text-[color:var(--color-slate-2)] font-mono">{SITE.tagline}</span>
      </span>
    </a>
    <ul class="flex items-center gap-1 sm:gap-2 overflow-x-auto">
      {SITE.nav.slice(1).map((n) => {
        const active = path === n.href || path.startsWith(n.href) && n.href !== '/';
        return (
          <li>
            <a
              href={n.href}
              class={`text-sm px-3 py-1.5 rounded-full no-underline whitespace-nowrap ${active ? 'bg-[color:var(--color-forest)] text-[color:var(--color-paper)]' : 'text-[color:var(--color-slate)] hover:text-[color:var(--color-saffron-text)]'}`}
            >{n.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
