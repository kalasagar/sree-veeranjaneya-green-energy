---
/**
 * Slim header.
 *   - Transparent over dark hero pages → solid (paper) after 60px scroll.
 *   - Solid paper on every non-hero page.
 *   - Saffron pulse dot on the mark signals "live · pre-construction".
 *   - Primary CTA pill on the right (lg+); hamburger on mobile.
 */
import { SITE } from '../lib/site';
import { link, stripBase } from '../lib/links';
import Mark from './Mark.astro';
const path = stripBase(Astro.url.pathname);
const BASE = import.meta.env.BASE_URL;
const asset = (p: string) => `${BASE}${p.replace(/^\//, '')}`.replace('//', '/');

const HERO_PAGES = ['/', '/about/', '/project/', '/process/', '/impact/', '/farmers/', '/partners/', '/press/', '/careers/', '/contact/', '/news/'];
const heroPage = HERO_PAGES.includes(path);
---
<header
  id="svge-header"
  data-hero-page={heroPage ? '' : undefined}
  class={`fixed top-0 inset-x-0 z-40 transition-[background,color,box-shadow,backdrop-filter] duration-200 ease-out ${heroPage ? 'svge-h-over' : 'svge-h-solid'}`}
>
  <div class="container-svge">
    <nav class="flex items-center justify-between gap-4 sm:gap-6 h-16 sm:h-20">
      <a href={link("/")} class="flex items-center gap-3 no-underline group" aria-label="SVGE — home">
        <span class="relative inline-flex items-center justify-center">
          <span id="svge-mark" class="inline-flex items-center justify-center w-9 h-9">
            <Mark size={36} ariaLabel={null} />
          </span>
          <span class="absolute -top-0.5 -right-0.5 inline-flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full rounded-full bg-[color:var(--color-saffron)]/55 animate-ping"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[color:var(--color-saffron)] ring-1 ring-[color:var(--color-paper)]"></span>
          </span>
        </span>
        <span class="flex flex-col leading-tight">
          <span class="svge-h-wordmark text-sm font-semibold tracking-tight transition-colors duration-200">SVGE</span>
          <span class="svge-h-tagline hidden sm:inline text-[11px] font-mono transition-colors duration-200">Grass to Gas. Farm to Fuel.</span>
        </span>
      </a>

      <!-- DESKTOP NAV -->
      <ul class="hidden lg:flex items-center gap-1 xl:gap-2 text-sm">
        {SITE.nav.slice(1).map((n) => {
          const active = path === n.href || (path.startsWith(n.href) && n.href !== '/');
          return (
            <li>
              <a
                href={link(n.href)}
                aria-current={active ? 'page' : undefined}
                class={`svge-h-link px-3 py-2 min-h-[44px] inline-flex items-center no-underline whitespace-nowrap transition-colors duration-150 ease-out relative ${active ? 'is-active' : ''}`}
              >{n.label}</a>
            </li>
          );
        })}
      </ul>

      <!-- CTA + HAMBURGER -->
      <div class="flex items-center gap-2">
        <a
          href={link("/contact/")}
          class="svge-h-cta hidden lg:inline-flex items-center gap-1.5 h-10 px-4 rounded-full text-[12px] font-mono uppercase tracking-[0.18em] no-underline transition-all duration-150"
        >
          <span>Talk to us</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <button
          id="svge-drawer-open"
          type="button"
          aria-label="Open navigation menu"
          aria-controls="svge-drawer"
          aria-expanded="false"
          class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-md transition-colors duration-200"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- MOBILE DRAWER -->
<div
  id="svge-drawer-backdrop"
  hidden
  class="fixed inset-0 z-50 bg-[color:var(--color-ink)]/55 backdrop-blur-sm transition-opacity duration-200 ease-out opacity-0 data-[open]:opacity-100"
></div>

<aside
  id="svge-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  hidden
  class="fixed top-0 right-0 z-50 h-full w-[min(88vw,360px)] bg-[color:var(--color-paper)] border-l-4 border-[color:var(--color-saffron)] shadow-2xl translate-x-full transition-transform duration-250 ease-out data-[open]:translate-x-0"
>
  <div class="flex items-center justify-between p-5 border-b border-[color:var(--color-slate-2-soft)]/30">
    <a href={link("/")} class="flex items-center gap-3 no-underline">
      <Mark size={36} ariaLabel={null} />
      <span class="flex flex-col leading-tight">
        <span class="text-sm font-semibold text-[color:var(--color-forest)]">SVGE</span>
        <span class="text-[11px] font-mono text-[color:var(--color-slate-2)]">Grass to Gas. Farm to Fuel.</span>
      </span>
    </a>
    <button
      id="svge-drawer-close"
      type="button"
      aria-label="Close navigation menu"
      class="inline-flex items-center justify-center w-11 h-11 rounded-md text-[color:var(--color-slate)] hover:text-[color:var(--color-saffron-text)] transition-colors duration-150"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="p-5 overflow-y-auto h-[calc(100%-80px)]">
    <p class="eyebrow mb-3">Main</p>
    <ul class="space-y-1 mb-8">
      {SITE.nav.slice(1).map((n) => {
        const active = path === n.href || (path.startsWith(n.href) && n.href !== '/');
        return (
          <li>
            <a
              href={link(n.href)}
              aria-current={active ? 'page' : undefined}
              class={`block px-3 py-3 rounded-md text-lg no-underline transition-colors duration-150 ${active ? 'bg-[color:var(--color-paper-2)] text-[color:var(--color-forest)] font-semibold' : 'text-[color:var(--color-slate)] hover:bg-[color:var(--color-paper-2)] hover:text-[color:var(--color-saffron-text)]'}`}
            >{n.label}</a>
          </li>
        );
      })}
    </ul>

    <p class="eyebrow mb-3">Also</p>
    <ul class="space-y-1">
      {SITE.navSecondary.map((n) => {
        const active = path.startsWith(n.href);
        return (
          <li>
            <a
              href={link(n.href)}
              class={`block px-3 py-3 rounded-md text-base no-underline transition-colors duration-150 ${active ? 'bg-[color:var(--color-paper-2)] text-[color:var(--color-forest)] font-semibold' : 'text-[color:var(--color-slate)] hover:bg-[color:var(--color-paper-2)] hover:text-[color:var(--color-saffron-text)]'}`}
            >{n.label}</a>
          </li>
        );
      })}
      <li><a href={link("/news/")} class="block px-3 py-3 rounded-md text-base text-[color:var(--color-slate)] hover:bg-[color:var(--color-paper-2)] hover:text-[color:var(--color-saffron-text)] no-underline">News</a></li>
    </ul>

    <a href={link("/contact/")} class="mt-8 inline-flex items-center justify-center w-full gap-1.5 h-12 rounded-full bg-[color:var(--color-forest)] text-[color:var(--color-paper)] text-sm font-mono uppercase tracking-[0.18em] no-underline">
      Talk to us
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>

    <div class="mt-6 p-4 rounded-md bg-[color:var(--color-paper-2)] text-sm">
      <p class="eyebrow mb-2">Or email</p>
      <a href="mailto:svge.india@gmail.com" class="font-semibold text-[color:var(--color-forest)] block">svge.india@gmail.com</a>
      <p class="mt-2 text-xs text-[color:var(--color-slate-2)]">Reply within two business days.</p>
    </div>
  </nav>
</aside>

<script is:inline data-astro-rerun>
  (function () {
    var header = document.getElementById('svge-header');
    var openBtn = document.getElementById('svge-drawer-open');
    var closeBtn = document.getElementById('svge-drawer-close');
    var backdrop = document.getElementById('svge-drawer-backdrop');
    var drawer = document.getElementById('svge-drawer');
    if (!header) return;

    var lastSolid = null;
    var threshold = 60;
    function applyScrollState() {
      var solid = window.scrollY > threshold;
      if (solid === lastSolid) return;
      lastSolid = solid;
      if (solid) {
        header.classList.remove('svge-h-over');
        header.classList.add('svge-h-solid');
      } else if (header.dataset.heroPage !== undefined) {
        header.classList.add('svge-h-over');
        header.classList.remove('svge-h-solid');
      }
    }
    applyScrollState();
    window.addEventListener('scroll', applyScrollState, { passive: true });

    if (!openBtn || !drawer || !backdrop || !closeBtn) return;

    var lastFocus = null;
    function focusableInside(root) {
      return Array.from(root.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'));
    }
    function openDrawer() {
      lastFocus = document.activeElement;
      drawer.hidden = false; backdrop.hidden = false;
      requestAnimationFrame(function () { drawer.dataset.open = ''; backdrop.dataset.open = ''; });
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      var first = focusableInside(drawer)[0]; first && first.focus();
      document.addEventListener('keydown', onKey);
      document.addEventListener('focus', trapFocus, true);
    }
    function closeDrawer() {
      delete drawer.dataset.open; delete backdrop.dataset.open;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('focus', trapFocus, true);
      setTimeout(function () { drawer.hidden = true; backdrop.hidden = true; lastFocus && lastFocus.focus && lastFocus.focus(); }, 220);
    }
    function onKey(e) {
      if (e.key === 'Escape') { e.preventDefault(); closeDrawer(); return; }
      if (e.key === 'Tab') {
        var nodes = focusableInside(drawer);
        if (!nodes.length) return;
        var first = nodes[0], last = nodes[nodes.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }
    function trapFocus(e) {
      if (!drawer.contains(e.target)) { var f = focusableInside(drawer)[0]; f && f.focus(); }
    }

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);
    drawer.querySelectorAll('a[href]').forEach(function (a) { a.addEventListener('click', closeDrawer); });
  })();
</script>
