---
import { SITE } from '../lib/site';

const fmt = new Intl.DateTimeFormat('en-IN', { year: 'numeric' });
---
<footer class="mt-24">

  <!-- BAND 1 — Editorial closing -->
  <section class="bg-[color:var(--color-forest-dark)] text-[color:var(--color-paper)]">
    <div class="container-svge py-16 sm:py-20">
      <div class="grid-12 items-end">
        <div class="col-8">
          <p class="eyebrow" style="color:#FFB300;">Closing statement</p>
          <p class="serif mt-4 text-[color:var(--color-paper)] leading-[1.05]" style="font-size: clamp(2.5rem, 6vw, 5rem); letter-spacing: -0.02em;">
            Grass to Gas.<br/><em>Farm to Fuel.</em>
          </p>
          <p class="serif mt-6 text-lg sm:text-xl text-[color:var(--color-paper)]/80 leading-relaxed max-w-[55ch]">
            We're building one Compressed Bio-Gas plant in Thatipadu, Vizianagaram. The receipts live on <a class="underline text-[color:var(--color-paper)]" href="/news/">our news page</a> — one update a month from the day concrete is poured.
          </p>
        </div>
        <div class="col-4 lg:text-right">
          <a href="/news/" class="btn btn-ink inline-flex" style="background: var(--color-saffron-text); color: var(--color-paper);">Read the first post →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BAND 2 — Sitemap + address -->
  <section class="bg-[color:var(--color-paper-2)]">
    <div class="container-svge py-12 sm:py-16">
      <div class="grid-12">
        <!-- Brand block -->
        <div class="col-3">
          <div class="flex items-center gap-3">
            <img src="/brand/mark.svg" alt="" width="40" height="40" />
            <div>
              <div class="font-semibold text-[color:var(--color-forest)] leading-tight">{SITE.short}</div>
              <div class="font-mono text-[11px] text-[color:var(--color-slate-2)] leading-tight">Grass → Gas → Soil</div>
            </div>
          </div>
          <p class="mt-4 text-xs leading-relaxed text-[color:var(--color-slate-2)]">
            4 TPD CBG plant under construction in Vizianagaram, Andhra Pradesh. Aligned with SATAT · GOBARdhan · MNRE.
          </p>
        </div>

        <!-- The Project -->
        <div class="col-3">
          <p class="eyebrow mb-3">The project</p>
          <ul class="space-y-1.5 text-sm">
            <li><a href="/about/">About</a></li>
            <li><a href="/project/">Project</a></li>
            <li><a href="/process/">Process</a></li>
            <li><a href="/process/engineering/">Engineering detail</a></li>
            <li><a href="/impact/">Impact</a></li>
            <li><a href="/news/">News</a> · <a href="/news/rss.xml" class="text-xs">RSS</a></li>
          </ul>
        </div>

        <!-- Audiences -->
        <div class="col-3">
          <p class="eyebrow mb-3">Audiences</p>
          <ul class="space-y-1.5 text-sm">
            <li><a href="/farmers/">For farmers</a></li>
            <li><a href="/partners/">Partners</a></li>
            <li><a href="/press/">Press</a></li>
            <li><a href="/careers/">Careers</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href={SITE.social.linkedin} rel="noopener">LinkedIn ↗</a></li>
          </ul>
        </div>

        <!-- Legal -->
        <div class="col-3">
          <p class="eyebrow mb-3">Legal & data</p>
          <ul class="space-y-1.5 text-sm">
            <li><a href="/privacy/">Privacy policy</a></li>
            <li><a href="/terms/">Terms of use</a></li>
            <li><a href={`mailto:${SITE.email}?subject=DPR%20request`}>Request the DPR</a></li>
          </ul>
        </div>
      </div>

      <!-- Address + registration block -->
      <div class="mt-12 pt-8 border-t border-[color:var(--color-slate-2-soft)]/30 grid-12 text-xs text-[color:var(--color-slate-2)] leading-relaxed">
        <div class="col-4">
          <p class="eyebrow mb-2">Plant site</p>
          <p>{SITE.plant.village}, {SITE.plant.mandal} Mandal,<br/>{SITE.plant.district}, {SITE.plant.state} — {SITE.plant.pin}<br/><span class="font-mono">{SITE.plant.lat.toFixed(4)}°N, {SITE.plant.lng.toFixed(4)}°E</span></p>
        </div>
        <div class="col-4">
          <p class="eyebrow mb-2">Registered office</p>
          <p>{SITE.registeredOffice.line1},<br/>{SITE.registeredOffice.line2},<br/>{SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}<br/><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </div>
        <div class="col-4 font-mono">
          <p class="eyebrow mb-2 font-sans">Identifiers</p>
          <p>CIN: {SITE.cin}<br/>GSTIN: {SITE.gst}<br/>UDYAM: {SITE.udyam}<br/>PAN: {SITE.pan}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BAND 3 — Utility -->
  <section class="bg-[color:var(--color-paper)] border-t border-[color:var(--color-slate-2-soft)]/30">
    <div class="container-svge py-5 flex flex-wrap items-center justify-between gap-2 text-xs text-[color:var(--color-slate-2)]">
      <span>© {fmt.format(new Date())} {SITE.legalName}. All rights reserved.</span>
      <span class="font-mono">Built with Astro · hosted on GitHub Pages</span>
    </div>
  </section>
</footer>
