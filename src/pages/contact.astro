---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import IntentChooser from '../components/IntentChooser.astro';
import { SITE } from '../lib/site';
---
<Base title="Contact" description="Pick the door that fits — farmer, partner, journalist, or future hire — and we'll route your message.">
  <Section eyebrow="Contact" title="Pick the door that fits">
    <p class="text-lg max-w-2xl mb-8 leading-relaxed">
      We'd rather route you to the right page than make you describe yourself in a generic form. Pick what fits:
    </p>
    <IntentChooser />
  </Section>

  <Section eyebrow="Or use the form" title="A single message gets to all founders">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-10">
      <div>
        <!--
          FORMSPREE ENDPOINT — Replace the placeholder ID below before going live.
          1. Sign up at https://formspree.io (free tier: 50 submissions/mo)
          2. Create a new form, set the destination to svge.india@gmail.com
          3. Copy the form ID from the Formspree dashboard
          4. Replace REPLACE_WITH_FORMSPREE_ID with that ID
        -->
        <form id="contactForm" action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID" method="POST" class="space-y-4 max-w-prose">
          <label class="block">
            <span class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Your name</span>
            <input required name="name" type="text" class="mt-1 w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Email</span>
            <input required name="email" type="email" class="mt-1 w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm" />
          </label>
          <label class="block">
            <span class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Topic</span>
            <select name="topic" class="mt-1 w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm">
              <option>Feedstock supply (farmer / aggregator)</option>
              <option>EPC / logistics / FOM partnership</option>
              <option>Journalist / press</option>
              <option>Hiring / careers</option>
              <option>Lender / banking</option>
              <option>Something else</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Message</span>
            <textarea required name="message" rows="5" class="mt-1 w-full rounded-lg border border-black/10 bg-white px-3 py-2 text-sm"></textarea>
          </label>
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="btn btn-primary">Send message ↗</button>
          <p id="formStatus" class="text-xs font-mono text-[color:var(--color-slate-2)]"></p>
        </form>
      </div>

      <aside class="space-y-5">
        <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-6 text-sm">
          <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Email</div>
          <a class="text-base font-semibold" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <p class="mt-3 text-xs text-[color:var(--color-slate-2)]">We are deliberately not publishing a phone number until the plant is operational. Email gets to both directors.</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-6 text-sm leading-relaxed">
          <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Registered Office</div>
          <p class="mt-1">{SITE.registeredOffice.line1}<br/>{SITE.registeredOffice.line2}<br/>{SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}<br/>India</p>
        </div>
        <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-6 text-sm leading-relaxed">
          <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Plant Site</div>
          <p class="mt-1">{SITE.plant.village}, {SITE.plant.mandal} Mandal<br/>{SITE.plant.district}, {SITE.plant.state} — {SITE.plant.pin}<br/><span class="font-mono text-xs">{SITE.plant.lat.toFixed(4)}°N, {SITE.plant.lng.toFixed(4)}°E</span></p>
        </div>
      </aside>
    </div>
  </Section>
</Base>
<script is:inline>
  document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const status = document.getElementById('formStatus');
    status.textContent = 'Sending…';
    try {
      const fd = new FormData(form);
      const r = await fetch(form.action, { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } });
      if (r.ok) {
        form.reset();
        status.textContent = 'Thank you — we received your message.';
        status.style.color = '#1B5E20';
      } else {
        status.textContent = 'Could not send. Please email svge.india@gmail.com directly. (' + r.status + ')';
        status.style.color = '#E65100';
      }
    } catch {
      status.textContent = 'Network error. Please email svge.india@gmail.com directly.';
      status.style.color = '#E65100';
    }
  });
</script>
