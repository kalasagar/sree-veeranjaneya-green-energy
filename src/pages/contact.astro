---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import Stakeholders from '../components/Stakeholders.astro';
import { SITE } from '../lib/site';
---
<Base title="Contact" description="Tell us who you are (farmer, partner, journalist, future hire) and we route your message." heroOver={true}>
  <FullBleedHero
    banner="about_founder_field"
    alt="Founder walking down a path between Napier grass plots at golden hour."
    eyebrow="Contact"
    objectPosition="50% 70%"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2.75rem, 6vw, 5rem);">
      <span class="block">Seven audiences.</span>
      <span class="block" style="color: var(--color-gold);">One inbox.</span>
      <span class="block">Pick a door.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Seven audiences come to SVGE for different reasons: IOCL on spec compliance, lenders on the data room, farmers on supply terms, EPC partners on sub-contract scope, future hires on the next tranche, journalists on the press kit, and state officials on clearance status. Pick the door that fits and we'll route the message.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="Talk to us" deck='Seven kinds of reader, <span style="color: var(--color-saffron-text);">one inbox</span> at the other end.' maxCh={26} />

  <Section><Stakeholders /></Section>

  <Section eyebrow="Or use the form" title="A single message reaches all founders." bg="paper-2">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-8">
      <form id="contactForm" action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID" method="POST" class="space-y-5 max-w-2xl">
        <label class="block">
          <span class="eyebrow">Your name</span>
          <input required name="name" type="text" class="mt-2 w-full rounded border border-[color:var(--rule-color)] bg-[color:var(--color-paper)] px-4 py-3" />
        </label>
        <label class="block">
          <span class="eyebrow">Email</span>
          <input required name="email" type="email" class="mt-2 w-full rounded border border-[color:var(--rule-color)] bg-[color:var(--color-paper)] px-4 py-3" />
        </label>
        <label class="block">
          <span class="eyebrow">Message</span>
          <textarea required name="message" rows="6" class="mt-2 w-full rounded border border-[color:var(--rule-color)] bg-[color:var(--color-paper)] px-4 py-3"></textarea>
        </label>
        <button type="submit" class="btn btn-primary">Send →</button>
      </form>
      <aside class="svge-card p-6">
        <p class="eyebrow mb-2">Email directly</p>
        <p class="text-lg"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p class="meta mt-3">Reply within two business days.</p>
        <p class="eyebrow mt-6 mb-2">Office hours</p>
        <p class="text-sm">Mon–Sat · 09:00–18:00 IST</p>
      </aside>
    </div>
  </Section>
</Base>
