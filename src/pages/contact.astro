---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import IntentChooser from '../components/IntentChooser.astro';
import { SITE } from '../lib/site';
---
<Base title="Contact" description="Pick the door that fits — farmer, partner, journalist, or future hire — and we'll route your message.">
  <FullBleedHero banner={null} alt="Contact" eyebrow="Contact">
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl">
      Pick the door<br/>
      <span style="color:#FFB300;">that fits.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Routes faster than a generic form. Pick one:
    </p>
  </FullBleedHero>

  <Section>
    <IntentChooser />
  </Section>

  <Section eyebrow="Or use the form" title="A single message gets to all founders." bg="paper-2">
    <div class="grid-12">
      <div class="col-8">
        <form id="contactForm" action="https://formspree.io/f/REPLACE_WITH_FORMSPREE_ID" method="POST" class="space-y-5">
          <label class="block">
            <span class="eyebrow text-[color:var(--color-slate-2)]">Your name</span>
            <input required name="name" type="text" class="mt-1 w-full rounded-md border border-[color:var(--color-slate-2-soft)]/40 bg-[color:var(--color-paper)] px-4 py-3 text-base" />
          </label>
          <label class="block">
            <span class="eyebrow text-[color:var(--color-slate-2)]">Email</span>
            <input required name="email" type="email" class="mt-1 w-full rounded-md border border-[color:var(--color-slate-2-soft)]/40 bg-[color:var(--color-paper)] px-4 py-3 text-base" />
          </label>
          <label class="block">
            <span class="eyebrow text-[color:var(--color-slate-2)]">Topic</span>
            <select name="topic" class="mt-1 w-full rounded-md border border-[color:var(--color-slate-2-soft)]/40 bg-[color:var(--color-paper)] px-4 py-3 text-base">
              <option>Feedstock supply (farmer / aggregator)</option>
              <option>EPC / logistics / FOM partnership</option>
              <option>Journalist / press</option>
              <option>Hiring / careers</option>
              <option>Lender / banking</option>
              <option>Something else</option>
            </select>
          </label>
          <label class="block">
            <span class="eyebrow text-[color:var(--color-slate-2)]">Message</span>
            <textarea required name="message" rows="6" class="mt-1 w-full rounded-md border border-[color:var(--color-slate-2-soft)]/40 bg-[color:var(--color-paper)] px-4 py-3 text-base"></textarea>
          </label>
          <input type="text" name="company_hp" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="btn btn-primary">Send message →</button>
          <p id="formStatus" class="text-xs font-mono text-[color:var(--color-slate-2)]"></p>
        </form>
      </div>

      <aside class="col-4 space-y-5">
        <div class="rounded-xl bg-[color:var(--color-paper)] p-6 text-sm">
          <p class="eyebrow mb-2">Email</p>
          <a class="text-lg font-semibold" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <p class="mt-3 text-xs text-[color:var(--color-slate-2)] leading-relaxed">No phone published until the plant is operational. Email reaches both directors.</p>
        </div>
        <div class="rounded-xl bg-[color:var(--color-paper)] p-6 text-sm leading-relaxed">
          <p class="eyebrow mb-2">Registered Office</p>
          <p>{SITE.registeredOffice.line1}<br/>{SITE.registeredOffice.line2}<br/>{SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}<br/>India</p>
        </div>
        <div class="rounded-xl bg-[color:var(--color-paper)] p-6 text-sm leading-relaxed">
          <p class="eyebrow mb-2">Plant Site</p>
          <p>{SITE.plant.village}, {SITE.plant.mandal} Mandal<br/>{SITE.plant.district}, {SITE.plant.state} — {SITE.plant.pin}<br/><span class="font-mono text-xs">{SITE.plant.lat.toFixed(4)}°N, {SITE.plant.lng.toFixed(4)}°E</span></p>
        </div>
      </aside>
    </div>
  </Section>
</Base>
<script is:inline>
  document.getElementById('contactForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const status = document.getElementById('formStatus');
    const submitBtn = form.querySelector('button[type="submit"]');
    const originalLabel = submitBtn?.textContent;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
    status.textContent = '';
    try {
      const fd = new FormData(form);
      const r = await fetch(form.action, { method: 'POST', body: fd, headers: { 'Accept': 'application/json' } });
      if (r.ok) {
        form.reset();
        status.textContent = 'Thank you — we received your message.';
        status.style.color = '#1B5E20';
      } else {
        status.textContent = 'Could not send. Please email svge.india@gmail.com directly. (' + r.status + ')';
        status.style.color = '#B34200';
      }
    } catch {
      status.textContent = 'Network error. Please email svge.india@gmail.com directly.';
      status.style.color = '#B34200';
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel ?? 'Send message →'; }
    }
  });
</script>
