---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';
---
<Base title="Page not found" description="That page doesn't exist on the SVGE site.">
  <Section narrow>
    <div class="text-center py-10">
      <div class="font-mono text-6xl text-[color:var(--color-saffron)] mb-4">404</div>
      <h1 class="text-3xl">We can't find that page.</h1>
      <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-slate)]">
        Either the link is wrong, or we moved the page while you were reading. Both happen. Pick a door:
      </p>
      <div class="mt-8 grid sm:grid-cols-2 gap-3 text-left">
        {SITE.nav.filter(n => n.href !== '/').map(n => (
          <a href={n.href} class="rounded-2xl bg-[color:var(--color-paper-2)] p-4 no-underline cursor-pointer hover:bg-[color:var(--color-paper)] active:scale-[0.99] border border-black/5 transition-all duration-200 ease-out">
            <div class="font-semibold text-[color:var(--color-forest)]">{n.label} ↗</div>
          </a>
        ))}
      </div>
      <p class="mt-8 text-sm font-mono text-[color:var(--color-slate-2)]">
        Or go <a href="/">back to the home page</a>.
      </p>
    </div>
  </Section>
</Base>
