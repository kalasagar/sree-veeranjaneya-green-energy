---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import BentoGrid from '../components/BentoGrid.astro';
import PlantMap from '../components/PlantMap.astro';
import EditorialBlock from '../components/EditorialBlock.astro';
import Logos from '../components/Logos.astro';
import { SITE } from '../lib/site';

const ps = SITE.plantStats;
---
<Base title="The Project" description="4 TPD Compressed Bio-Gas plant in Thatipadu, Vizianagaram. IOCL Letter of Intent issued 04.10.2024. SATAT-approved EPC partner. 2-year commissioning clock.">
  <FullBleedHero
    banner="project_plant_render"
    alt="Aerial photograph of a small bio-CNG plant on a cleared plot, surrounded by paddy fields in coastal Andhra Pradesh."
    eyebrow="The Project"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl">
      4 TPD CBG. 40-km supply radius.<br/>
      <span style="color:#FFB300;">2-year commissioning clock.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Single plant. Single site. Indian Oil Letter of Intent issued 04.10.2024 (ref IndianOil/SATAT/01/3931). EPC partner Raj Process Equipments &amp; Systems, Pune — SATAT-approved. Built to IS 16087:2016 spec. CPCB WHITE pollution category.
    </p>
  </FullBleedHero>

  <!-- BENTO PLANT SNAPSHOT -->
  <Section eyebrow="Plant snapshot" title="What sits on 2.63 acres.">
    <BentoGrid hero={ps[0]} supporting={[ps[1], ps[2], ps[3]]} />
    <div class="mt-8 grid-12">
      {ps.slice(4).map(s => (
        <div class="col-3 border-t-2 border-[color:var(--color-ink)] pt-4">
          <div class="stat-num">{s.value}<span class="unit">{s.unit}</span></div>
          <p class="eyebrow mt-2">{s.k}</p>
          {s.framing && <p class="text-sm mt-2 text-[color:var(--color-slate)] leading-relaxed">{s.framing}</p>}
        </div>
      ))}
    </div>
  </Section>

  <!-- LOCATION -->
  <Section eyebrow="Location" title="Where we are." bg="paper-2">
    <div class="grid-12 items-start">
      <div class="col-8">
        <PlantMap />
      </div>
      <aside class="col-4 text-sm leading-relaxed">
        <h3 class="text-xl mb-3">Site & connectivity</h3>
        <ul class="space-y-1.5">
          <li><strong>Village:</strong> {SITE.plant.village}</li>
          <li><strong>Mandal:</strong> {SITE.plant.mandal}</li>
          <li><strong>District:</strong> {SITE.plant.district}, {SITE.plant.state} — {SITE.plant.pin}</li>
          <li><strong>Land:</strong> {SITE.plant.landAcres} ac, MD-owned</li>
        </ul>
        <h3 class="text-xl mt-6 mb-3">Distance to</h3>
        <ul class="space-y-1 font-mono text-xs">
          <li>Rajam — 8 km</li>
          <li>Amadalavalasa — 24 km</li>
          <li>Srikakulam — 33 km</li>
          <li>Vizianagaram — 61 km</li>
          <li>Visakhapatnam Airport — 111 km</li>
          <li>Visakhapatnam Seaport — 122 km</li>
        </ul>
      </aside>
    </div>
  </Section>

  <!-- WHAT GETS BUILT FIRST -->
  <Section eyebrow="First things first" title="What goes up before anything else.">
    <EditorialBlock side="left" image="project_plant_render" imageAlt="Render of the SVGE plant — anaerobic digester and surrounding plot." numeral="01">
      <p>Civil works — boundary wall, plinth, internal road — and the anaerobic digester foundation. The digester is the heart of the plant; nothing else can be commissioned until its 24-hour residence cycle is running stably. Concrete is poured before any compressor or VPSA tower is even on site.</p>
      <p class="mt-4">From the day concrete is poured, we publish a monthly public update — one photo, one milestone hit, one missed, one financial number, one thing that went wrong.</p>
    </EditorialBlock>
  </Section>

  <!-- TIMELINE -->
  <Section eyebrow="Timeline" title="Where we are right now.">
    <ol class="relative border-l-2 border-[color:var(--color-forest)]/30 pl-8 space-y-6 max-w-3xl">
      {SITE.timeline.map(t => (
        <li class="relative">
          <span class={`absolute -left-[42px] top-1 w-5 h-5 rounded-full ${t.current ? 'bg-[color:var(--color-saffron)] ring-4 ring-[color:var(--color-saffron)]/20' : t.done ? 'bg-[color:var(--color-forest)]' : 'bg-[color:var(--color-paper)] border-2 border-[color:var(--color-forest)]/40'}`}></span>
          <div class="eyebrow">{t.date}</div>
          <div class={`text-base mt-1 ${t.done ? 'font-semibold text-[color:var(--color-ink)]' : 'text-[color:var(--color-slate-2)]'}`}>{t.label}{t.current ? ' — current' : ''}</div>
        </li>
      ))}
    </ol>
    <p class="mt-8 text-sm font-mono text-[color:var(--color-slate-2)]">Pre-construction. The day concrete is poured, the monthly public update starts.</p>
  </Section>

  <!-- PARTNERS -->
  <Section eyebrow="Partners" title="The network behind the plant.">
    <Logos />
  </Section>

  <!-- CAPITAL -->
  <Section eyebrow="Capital" title="How the project is funded." bg="paper-2">
    <div class="grid-12">
      <article class="col-4 rounded-lg bg-[color:var(--color-paper)] p-6">
        <p class="eyebrow mb-2">Structure</p>
        <h3 class="text-xl leading-snug mt-1 text-[color:var(--color-forest)]">Promoter-led</h3>
        <p class="text-sm mt-2 text-[color:var(--color-slate)]">Two directors own 100% of the equity. No fund clock, no investor exit pressure.</p>
      </article>
      <article class="col-4 rounded-lg bg-[color:var(--color-paper)] p-6">
        <p class="eyebrow mb-2">Term loan</p>
        <h3 class="text-xl leading-snug mt-1 text-[color:var(--color-forest)]">{SITE.financing.termYears}-year</h3>
        <p class="text-sm mt-2 text-[color:var(--color-slate)]">Public-sector lender. Disbursement begins with construction; door-to-door tenor concludes with the offtake-contract horizon.</p>
      </article>
      <article class="col-4 rounded-lg bg-[color:var(--color-paper)] p-6">
        <p class="eyebrow mb-2">Confirmed incentives</p>
        <h3 class="text-xl leading-snug mt-1 text-[color:var(--color-forest)]">₹{SITE.financing.incentivesCr} Cr</h3>
        <p class="text-sm mt-2 text-[color:var(--color-slate)]">MNRE CFA · AGRL Ministry · FOM Market Development Assistance (Min. of Chemicals &amp; Fertilizers). Plus a 5-year income-tax holiday for CBG plants.</p>
      </article>
    </div>

    <details class="mt-10 rounded-xl bg-[color:var(--color-paper)] border border-[color:var(--color-slate-2-soft)]/30 p-6 open:bg-[color:var(--color-paper-3)]">
      <summary class="cursor-pointer font-semibold text-[color:var(--color-forest)]">For lenders and project finance — request the DPR</summary>
      <div class="mt-4 text-sm leading-relaxed prose-svge">
        <p>The full Detailed Project Report (DPR) — cost sheet, sensitivity analysis, break-even, DSCR, IRR, working capital, depreciation, equipment vendor quotations — is available on email request to qualified lenders with a brief intro to your institution.</p>
        <p>Headline public points:</p>
        <ul>
          <li>Total project cost ≈ {SITE.financing.totalCr === 33.27 ? '₹33 Cr' : '₹' + SITE.financing.totalCr + ' Cr'}. {SITE.financing.structure}.</li>
          <li>Plant capacity 4 TPD CBG, 9,600 Nm³/day raw biogas, 24 hours × 360 days, IS 16087:2016 spec.</li>
          <li>Indian Oil Letter of Intent dated 04.10.2024 (ref IndianOil/SATAT/01/3931). 15-year Commercial Agreement validity. Commissioning deadline 04.10.2026.</li>
          <li>CFA eligibility: MNRE Phase-I National Bioenergy Programme (extended to 31.03.2026).</li>
          <li>UDYAM-registered MSME: {SITE.udyam}. ROC Vijayawada, Reg. No. {SITE.registrationNumber}.</li>
          <li>CPCB pollution category: WHITE. Three statutory clearances obtained, three applied, one after-COD.</li>
        </ul>
        <p>Email <a href={`mailto:${SITE.email}?subject=DPR%20request`}>{SITE.email}</a> with subject line <em>DPR request</em>.</p>
      </div>
    </details>
  </Section>
</Base>
