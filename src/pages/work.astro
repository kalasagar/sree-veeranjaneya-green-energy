---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import ChipRail from '../components/ChipRail.astro';
import Accordion from '../components/Accordion.astro';
import Countdown from '../components/Countdown.astro';
import TeamComposition from '../components/TeamComposition.astro';
import ClearanceMatrix from '../components/ClearanceMatrix.astro';
import NotifyMe from '../components/NotifyMe.astro';
import Logos from '../components/Logos.astro';
import { SITE } from '../lib/site';

const roles = [
  { k: 'Plant operations', v: 'Shift engineers, biogas operators, instrumentation technicians. CBG plants run 24×360 — three shifts.' },
  { k: 'Lab & QC', v: 'Gas analysis chemists for daily IS 16087:2016 verification. CH₄, CO₂, O₂, H₂S, dew point.' },
  { k: 'Feedstock aggregation', v: 'Field supervisors managing farmer relationships and daily collection logistics in a 40-km radius. Telugu-speaking, farmer-facing.' },
  { k: 'Accounts & payments', v: 'The 14-day farmer-payment discipline lives here. Reconciliation, MIS, slip integrity.' },
  { k: 'Drivers & watchmen', v: 'Cascade truck drivers, tractor/telehandler operators, plant watchmen. Local hire, day shift / night shift.' },
];

const tone: Record<string, string> = { open: 'var(--color-forest)', discussion: 'var(--color-saffron-text)', awarded: 'var(--color-slate-2)' };
const chips = [{ id: 'rfps', label: 'RFPs' }, { id: 'careers', label: 'Careers' }, { id: 'clearances', label: 'Why now' }];
---
<Base title="Work with us" description="Open RFPs by category. Careers from Q3 2026. Direct intake — no portals, no middlemen." heroOver={true}>
  <FullBleedHero
    banner="about_founder_field"
    video="story_b2_people"
    alt="People at the field — local hire first."
    eyebrow="Work with us"
    objectPosition="50% 65%"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2.75rem, 6vw, 5rem);">
      Engage with<br/>
      <span style="color: var(--color-gold);">the build.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Six open RFP categories. Five hiring categories. Total plant headcount at steady state is 47; with aggregation, ~120 jobs total.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="Work · six RFPs · 120 jobs" deck='Open RFPs. <span style="color: var(--color-saffron-text);">Hiring tranches.</span> Direct intake.' />
  <ChipRail items={chips} />

  <!-- RFPs -->
  <Section id="rfps" eyebrow="RFPs" title="Six categories. Status, scope, contact.">
    <div class="grid md:grid-cols-2 gap-4">
      {SITE.rfps.map(r => (
        <article class="svge-card p-6" data-reveal>
          <header class="flex items-baseline gap-3 flex-wrap">
            <h3 style="font-family: var(--font-display); font-size: 1.375rem;">{r.label}</h3>
            <span class="inline-flex items-center gap-2 px-2 py-1 rounded-full text-[10px]" style={`background: color-mix(in oklab, ${tone[r.status]} 14%, transparent); color: ${tone[r.status]}; font-family: var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase;`}>
              <span class="w-1.5 h-1.5 rounded-full" style={`background:${tone[r.status]};`} aria-hidden="true"></span>{r.status}
            </span>
          </header>
          <p class="mt-3 text-sm leading-relaxed">{r.scope}</p>
          <p class="mt-4 meta"><a href={`mailto:${r.contact}?subject=${encodeURIComponent('RFP: ' + r.label)}`}>{r.contact}</a></p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Already in place" title="Three relationships that matter." bg="paper-2">
    <Logos />
  </Section>

  <!-- Careers -->
  <Section id="careers" eyebrow="Careers" title="Local hire first.">
    <div class="grid lg:grid-cols-2 gap-6">
      <Countdown label="to the first hiring tranche" />
      <TeamComposition />
    </div>
    <div class="mt-12 max-w-3xl">
      {roles.map(r => <Accordion summary={r.k}><p>{r.v}</p></Accordion>)}
    </div>
    <p class="mt-6 meta">For specialised roles — gas analysers, instrumentation, controls — we hire wherever we find competence. Local-first is the default.</p>
  </Section>

  <Section narrow bg="paper-2">
    <NotifyMe
      topic="Careers"
      eyebrow="Be the first to know"
      title="Email me when SVGE opens its first hiring tranche."
      body="One email per category when applications open. Unsubscribe at any time."
      cta="Notify me about roles"
    />
  </Section>

  <Section id="clearances" eyebrow="Why now" title="The build is real, not vapour.">
    <ClearanceMatrix compact={true} />
  </Section>
</Base>
