---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import RadiusMap from '../components/RadiusMap.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Accordion from '../components/Accordion.astro';
import NotifyMe from '../components/NotifyMe.astro';
import { SITE } from '../lib/site';

const faqs = [
  { q: 'Do I have to sign a long-term contract?', a: 'No. For paddy straw, every supply is on its own slip. For Napier grass, we offer a season-long contract because we want to know the feedstock is there, but it is renewable per season. Never multi-year-locked.' },
  { q: "How do I know you'll actually pay in 14 days?", a: 'Every payment is bank-transfer against a numbered supply slip you keep a copy of. From the day concrete is poured, we will publish farmer-payments-made as one of the monthly numbers on /press/#journal.' },
  { q: 'What if my paddy straw is wet from rain?', a: "We don't pay for wet straw. It kills the digester economics. But if a forecast says rain is coming, call us before harvest. We have flexibility on timing." },
  { q: 'Do I get Fermented Organic Manure for free?', a: 'FOM is sold back at a fair market rate, significantly below chemical fertilizer for the equivalent nutrient load.' },
  { q: 'Will Napier grass work on my land?', a: 'Napier handles most coastal-Andhra soils, including stony or low-water plots that struggle with paddy. We visit your land before signing, at our cost.' },
  { q: 'When does this actually start?', a: 'The plant is in pre-construction today. Email us now to be on the contact list when first feedstock collection begins (target Q3 2026).' },
];
---
<Base title="For Farmers" description="We buy paddy straw, Napier grass, cattle dung. We pay within 14 days. By bank transfer. Within 40 km of Thatipadu." heroOver={true}>
  <FullBleedHero
    banner="farmers_hands_straw"
    video="farmers_hands_straw"
    alt="Weathered hands tying a bundle of dry paddy straw."
    eyebrow="For Farmers"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(1.625rem, 6vw, 5rem);">
      <span class="block">We buy</span>
      <span class="block" style="color: var(--color-gold);">what you would have burned.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      If you farm within 40 km of Thatipadu, in Vizianagaram or Srikakulam district, we want to talk to you. Paddy straw is bought on a numbered supply slip and paid in fourteen days by bank transfer, no middleman. Napier grass is taken under a season-long contract, renewable per season. Cattle dung is picked up on a monthly route.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="If your land is inside the radius" deck='We pay in <span style="color: var(--color-saffron-text);">fourteen days</span>, by bank transfer, against every supply slip.' maxCh={28} />

  <!-- Radius -->
  <Section eyebrow="Your land" title="If you farm within 40 km, this is the radius.">
    <RadiusMap highlight={40} caption="Concentric distances from Thatipadu. Vizianagaram + Srikakulam catchment within the 40-km belt." />
  </Section>

  <!-- Where this sits — paddy belt + smog corridor on the India map. -->
  <Section eyebrow="Where this sits on the map of India" title="The paddy belt, the smog corridor, and one small dot in coastal Andhra." bg="paper-2">
    <IndiaMap />
  </Section>

  <!-- What we buy -->
  <Section eyebrow="What we buy / what we don't" title="The contract, in plain language." bg="paper-2">
    <div class="grid lg:grid-cols-2 gap-4">
      <div class="svge-card p-8" style="background: var(--color-forest); color: var(--color-paper);" data-reveal>
        <p class="eyebrow" style="color: color-mix(in oklab, var(--color-paper) 85%, transparent);">We pay for</p>
        <ul class="mt-4 space-y-4">
          <li class="flex items-baseline gap-3"><span class="numeral text-2xl" style="color: var(--color-paper);">01</span><div><strong class="text-lg">Paddy straw.</strong> Dry, baled or loose, post-harvest.</div></li>
          <li class="flex items-baseline gap-3"><span class="numeral text-2xl" style="color: var(--color-paper);">02</span><div><strong class="text-lg">Napier grass</strong> under a contract-farming agreement, on your land or ours.</div></li>
          <li class="flex items-baseline gap-3"><span class="numeral text-2xl" style="color: var(--color-paper);">03</span><div><strong class="text-lg">Cattle dung.</strong> Fresh, in volume, from your shed.</div></li>
        </ul>
      </div>
      <div class="svge-card p-8" data-reveal>
        <p class="eyebrow">We won't pay for</p>
        <ul class="mt-4 space-y-2 list-disc list-inside">
          <li>Wet or rotting straw. Must be dry and clean.</li>
          <li>Plastic-contaminated bales.</li>
          <li>Pre-burned or charred residue (defeats the point).</li>
          <li>Anything supplied through a paid middleman. We go direct.</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- Four steps -->
  <Section eyebrow="How it works" title="Four steps. No paperwork tricks.">
    {/*
      Connected timeline: four cells in a hairline gap-px grid (matches the
      site's other gap-px patterns). Each cell carries a forest-filled
      numeral chip (40 px circle) and a saffron arrow on its right edge that
      visually points into the next cell. Mobile: stacks vertically and the
      arrow rotates 90° to point down between cards.
    */}
    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded relative" style="background: var(--rule-color);">
      {[
        ['Contact us',       'Email, WhatsApp (once construction starts), or walk-in once we are on site.'],
        ['Agree a rate',     'In writing, in plain Telugu or English. Per tonne. No verbal-only deals.'],
        ['Deliver and sign', 'You deliver to the plant or our pickup point, sign a numbered supply slip, and keep a copy. So do we.'],
        ['Get paid',         '14 days. Bank transfer. To the account on the slip.'],
      ].map(([t, d], i, arr) => (
        <li class="p-6 sm:p-7 flex flex-col relative" style="background: var(--color-paper);" data-reveal>
          <!-- numeral chip + connector arrow -->
          <div class="flex items-center justify-between mb-5">
            <span
              class="inline-flex items-center justify-center rounded-full numeral"
              style="width: 44px; height: 44px; background: var(--color-forest); color: var(--color-paper); font-family: var(--font-mono); font-weight: 600; font-size: 14px; letter-spacing: 0.06em;"
              aria-hidden="true"
            >{(i + 1).toString().padStart(2, '0')}</span>
            {i < arr.length - 1 && (
              <span
                class="text-[color:var(--color-saffron)] hidden lg:inline-flex"
                aria-hidden="true"
                style="font-family: var(--font-mono);"
              >
                <svg width="32" height="14" viewBox="0 0 32 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="0" y1="7" x2="28" y2="7" /><polyline points="22 2 28 7 22 12" /></svg>
              </span>
            )}
          </div>

          <h3 style="font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; color: var(--color-ink); letter-spacing: -0.01em; line-height: 1.2; min-height: 2.4em;">{t}</h3>
          <div class="mt-3 w-8 h-px" style="background: var(--color-saffron);" aria-hidden="true"></div>
          <p class="mt-4 text-sm leading-relaxed flex-1" style="color: var(--color-slate);">{d}</p>
        </li>
      ))}
    </ol>
    <p class="meta mt-5" style="color: var(--color-slate-2);">No agents. No middlemen. Every step in writing.</p>
  </Section>

  <!-- Notify -->
  <Section narrow bg="paper-2">
    <NotifyMe
      topic="Farmer pickup route"
      eyebrow="When pickup starts"
      title="Be on the list when the first vehicle goes out."
      body="One email when the pickup route in your village goes live. No follow-up spam."
      cta="Add me to the route"
    />
  </Section>

  <!-- FAQ -->
  <Section eyebrow="Common questions" title="What farmers ask us first." narrow>
    <div>
      {faqs.map(f => <Accordion summary={f.q}><p>{f.a}</p></Accordion>)}
    </div>
    <p class="mt-8 text-sm">Couldn't find your question? Email <a href={`mailto:${SITE.email}?subject=Farmer%20enquiry`}>{SITE.email}</a>. A Telugu page is in the works for 2026 Q3.</p>
  </Section>
</Base>
