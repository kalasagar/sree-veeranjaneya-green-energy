---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import ChipRail from '../components/ChipRail.astro';
import CBGSankey from '../components/CBGSankey.astro';
import DayInTheData from '../components/DayInTheData.astro';
import PlantBlueprint from '../components/PlantBlueprint.astro';
import Accordion from '../components/Accordion.astro';
import Stat from '../components/Stat.astro';
import { SITE } from '../lib/site';

const eightSteps = [
  { n: '01', t: 'Feedstock receipt', d: '72 TPD Napier grass at 20-25% solids, or paddy straw + cattle dung mix. Sourced via 5-year contract farming and direct supply from farmers within a 40-km radius of the plant.' },
  { n: '02', t: 'Mixing tank', d: 'Feedstock combined with ~145 m³/day of recycled process water. Total ~216 m³/day slurry flows to the digester.' },
  { n: '03', t: 'Anaerobic digestion', d: '4 × CSTR-type digesters (26 m × 8.63 m, total 15,402 m³). 34-day residence. Outputs 9,500 Nm³/day of raw biogas.' },
  { n: '04', t: 'Slurry separation', d: 'Solid-liquid separator yields 52 m³/day liquid manure and 1 TPH solid Fermented Organic Manure (FOM).' },
  { n: '05', t: 'Gas purification', d: 'Water scrubber → chemical scrubber → activated carbon filter → two-tower VPSA system. Strips CO₂, H₂S, and moisture to ≥90% methane.' },
  { n: '06', t: 'Compression & buffer', d: 'Purified CBG compressed to 250 bar and stored in a surge vessel.' },
  { n: '07', t: 'Dispatch QC', d: 'Continuous gas analysers (CH₄, CO₂, O₂, H₂S) and a dew-point sensor stamp each dispatch slip. Out-of-spec gas is recycled, not loaded.' },
  { n: '08', t: 'Dispatch to IOCL', d: 'CBG cascade trucks (or pipeline once available) carry the gas to Indian Oil offtake points under the SATAT contract.' },
];

const isSpec = [
  { p: 'CH₄ (methane)', limit: '≥ 90 % v/v', mean: 'The fuel itself. Below 90 %, calorific value drops and CNG engines need re-tuning.' },
  { p: 'CO₂', limit: '≤ 4 %', mean: 'Inert. Dilutes fuel; corrodes cylinders if water is also present.' },
  { p: 'O₂', limit: '≤ 0.5 %', mean: 'Safety floor. Oxygen + methane + spark = explosion risk in cascades.' },
  { p: 'Total sulphur (incl. H₂S)', limit: '≤ 20 mg/m³', mean: 'H₂S forms sulphuric acid with moisture; eats valves and cylinder steel.' },
  { p: 'Moisture (water dew point)', limit: '≤ 5 mg/m³ (≈ −40 °C dew point at 250 bar)', mean: 'Free water causes corrosion and ice plugs. The PSA dryer is sized to this.' },
];

const machinery = [
  ['Anaerobic Digester (CSTR Type)', '4 No.', 'RCC/MS with Balloon', 'The heart of the plant. Four units of 26 m × 8.63 m each, total 15,402 m³.'],
  ['Biogas Blower with FLP Motor & VFD', '2 No. (1W+1S)', 'n/a', 'Flameproof motor on VFD, one working + one standby for 24×360 ops.'],
  ['Water Scrubber', '1 No.', 'HDPE', 'High-pressure water scrubbing strips bulk CO₂ before fine cleanup.'],
  ['Chemical Scrubber', '1 No.', 'SS304', 'Polishes residual H₂S with a chemical sorbent. SS304 needed for sulphidic service.'],
  ['Activated Carbon Filter', '1 No.', 'C.S.', 'Last polishing stage for trace H₂S and VOCs before the VPSA inlet.'],
  ['2-Tower VPSA Biogas Purification Plant', '2 No.', 'S.S./C.S.', 'The methane-vs-CO₂ separator. 96-98% methane recovery in industry; SVGE contracted floor is ≥90%.'],
  ['Biogas Surge Vessel', '1 No.', 'C.S.', 'Levels pressure between VPSA cycles and compressor draw.'],
  ['Gas Analysers (CH₄, CO₂, O₂, H₂S)', '1 No.', 'n/a', 'Continuous online analysers. Out-of-spec values trigger recycle, never dispatch.'],
  ['Dew Point Sensor', '1 No.', 'n/a', 'Verifies the PSA dryer delivers −40 °C dew point at the cascade fill point.'],
];

const chips = [
  { id: 'flow', label: 'Flow' },
  { id: 'steps', label: 'Eight steps' },
  { id: 'blueprint', label: 'Blueprint' },
  { id: 'spec', label: 'IS 16087' },
  { id: 'equipment', label: 'Equipment' },
  { id: 'glossary', label: 'Glossary' },
];
---
<Base title="Plant" description="Feedstock to fuel, on one page. Eight-step process, IS 16087:2016 spec, equipment list, glossary." heroOver={true}>
  <FullBleedHero
    banner="project_plant_render"
    video="process_digester_dawn"
    alt="Aerial view of the plant site."
    eyebrow="Inside the plant"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2rem, 6vw, 5rem);">
      <span class="block">Feedstock to fuel.</span>
      <span class="block" style="color: var(--color-gold);">Eight steps.</span>
      <span class="block">One drawing.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Four tonnes of Compressed Bio-Gas a day, distilled from 9,600 Nm³ of raw biogas across four CSTR digesters totalling 15,402 m³ of working volume. Built to IS 16087:2016, with a 2-tower VPSA holding methane at ≥90%. Designed and integrated by Raj Process Equipments &amp; Systems, Pune.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="From a field of grass to a tank of fuel" deck='Seventy-two tonnes of feedstock go in. <span style="color: var(--color-saffron-text);">Four tonnes of clean fuel</span> come out. Eight steps in between.' maxCh={28} />
  <ChipRail items={chips} />

  <!-- Flow -->
  <Section id="flow" eyebrow="Mass-flow Sankey" title="From field to fill point.">
    <CBGSankey />
  </Section>

  <!-- A day in the data — scrollytelling. Belongs here on /plant rather
       than the home page (mass-flow numbers are technical depth). -->
  <Section eyebrow="A day in the data" title="One operating day, in numbers." bg="paper-2">
    <DayInTheData />
  </Section>

  <!-- Eight steps -->
  <Section id="steps" eyebrow="Eight steps" title="The flow chart, with engineering depth." bg="paper-2">
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {eightSteps.map(s => (
        <li class="svge-card p-5" data-reveal>
          <p class="numeral text-sm" style="color: var(--color-saffron-text);">{s.n}</p>
          <h3 class="mt-2" style="font-family: var(--font-display); font-size: 1.125rem;">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed">{s.d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Blueprint -->
  <Section id="blueprint" eyebrow="Plant blueprint" title="The plant, in one drawing.">
    <PlantBlueprint />
  </Section>

  <!-- Sized for -->
  <Section eyebrow="Engineering" title="The numbers the equipment is sized for." bg="paper-2">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <Stat value="4 × CSTR" unit="15,402 m³" label="Digester" framing="RCC with balloon. 26 m × 8.63 m per unit. 15% gas-holding head space." />
      <Stat value="34 d" unit="HRT" label="Retention" framing="HRT 34 days. OLR 1.75 kg VS/m³/day. Pre-digester 648 m³." />
      <Stat value="2-tower" unit="VPSA" label="Upgrading" framing="PSA dryer to −40 °C dew point. Activated-carbon polishing. Contracted floor ≥ 90 % CH₄." />
      <Stat value="250 bar" unit="cascade" label="Dispatch" framing="IS 15319 cascades. Dispatch to IOCL Retail Outlet within 75 km (LoI cl. 5)." />
    </div>
  </Section>

  <!-- IS 16087 -->
  <Section id="spec" eyebrow="IS 16087:2016" title="The fuel spec, in plain language." bg="paper-2">
    <div class="max-w-3xl">
      {isSpec.map(s => (
        <Accordion summary={s.p} meta={s.limit}>
          <p>{s.mean}</p>
        </Accordion>
      ))}
    </div>
    <p class="meta mt-6 max-w-3xl">Out-of-spec gas at any parameter is recycled to the inlet, never dispatched. OMCs (IOCL/BPCL/HPCL) reject any tanker that fails on any line.</p>
  </Section>

  <!-- Equipment -->
  <Section id="equipment" eyebrow="Equipment" title="What sits on the plot.">
    <div class="max-w-5xl">
      {machinery.map(([e, q, m, why]) => (
        <Accordion summary={e as string} meta={`${q} · ${m}`}>
          <p>{why}</p>
        </Accordion>
      ))}
    </div>
    <p class="meta mt-6">Plus supporting harvesting machinery: rotary slasher, tedder, raker, balers, tractors, telehandler, moisture meter, water tank, fire extinguisher, lightning arrestor.</p>
  </Section>

  <!-- Glossary -->
  <Section id="glossary" eyebrow="Glossary" title="Every term used on this site, defined." bg="paper-2">
    <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
      {SITE.glossary.map(g => (
        <div data-reveal>
          <dt class="flex items-baseline gap-2">
            <span class="numeral font-semibold text-base" style="color: var(--color-ink);">{g.term}</span>
            <span class="meta">{g.long}</span>
          </dt>
          <dd class="mt-1 text-sm leading-relaxed">{g.def}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section narrow>
    <p class="text-sm">For capital flow, clearance status, and the commissioning clock, <a href={link('/build/')}>see The Build →</a></p>
  </Section>
</Base>
