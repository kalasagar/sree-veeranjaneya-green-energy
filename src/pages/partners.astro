---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Logos from '../components/Logos.astro';
import EditorialBlock from '../components/EditorialBlock.astro';
import IntentChooser from '../components/IntentChooser.astro';
import { SITE } from '../lib/site';

const lookFor = [
  { k: 'Feedstock supply', v: 'Farmers, aggregators, FPOs in the Vizianagaram–Srikakulam belt. Napier under contract, paddy straw on supply slip. Cash within 14 days.', cta: { label: 'Start there', href: '/farmers/' } },
  { k: 'EPC sub-contracting', v: 'Civil, mechanical, and electrical sub-packages once construction begins. Local hire preferred where competence permits.', cta: { label: 'Send a one-pager', href: '/contact/' } },
  { k: 'Cascade logistics', v: 'Truck operators for CBG dispatch to IOCL outlets. Capacity, IS-compliant cascades, route experience matter — flat rates don\'t.', cta: { label: 'Send credentials', href: '/contact/' } },
  { k: 'FOM offtake', v: 'Cooperatives, FPOs, organic-input dealers who buy solid Fermented Organic Manure or liquid digestate. We do not sell to brand distributors — we sell to the same belt we source from.', cta: { label: 'Open a conversation', href: '/contact/' } },
  { k: 'Lenders', v: 'The term loan is structured. We are not raising fresh debt. Future plants — when they come — will start the conversation from here.', cta: null },
  { k: 'Talent', v: 'Operations, lab, aggregation, accounts. Hiring opens with construction. Local hire first.', cta: { label: 'Be the first to know', href: '/careers/' } },
];
---
<Base title="Partners" description="Who we already work with — IOCL, Raj Process Equipments, the Government of India — and what we look for in the next set.">
  <FullBleedHero
    banner="project_plant_render"
    alt="Aerial view of the plant site surrounded by paddy fields, where the network of partners will deliver."
    eyebrow="Partners"
    objectPosition="50% 20%"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl">
      The network behind<br/>
      <span style="color:#FFB300;">one small plant.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Three relationships are in place today. IOCL has issued the Letter of Intent (04.10.2024, ref IndianOil/SATAT/01/3931). Raj Process Equipments &amp; Systems is the SATAT-approved EPC. The Government of India funds three confirmed central incentives totalling ₹6.7 crore.
    </p>
  </FullBleedHero>

  <Section eyebrow="In place today" title="Three relationships that matter.">
    <Logos />
  </Section>

  <!-- WHY PARTNER WITH SVGE -->
  <Section eyebrow="Why partner with SVGE" title="The work is small. The terms are clean." bg="paper-2">
    <EditorialBlock side="left" image="impact_fom_soil" imageAlt="Hands working soil — the closing loop our partners feed into." numeral="01">
      <p>SVGE is one of about 152 SATAT CBG projects in operation or under construction nationally — and one of seven in Andhra Pradesh. The numbers are small by SATAT standards: 4 TPD CBG, ~₹33 crore in project cost, 40-km feedstock radius. The trade-off is everything that comes with it: no fund clock, no investor demanding cut corners, no parent-company politics, no procurement layer between you and the decision maker. The two directors sign every contract.</p>
      <p class="mt-4">Payment terms are short and posted: 14 days for feedstock, 30 days for civil sub-contracts on certified completion, IOCL clearing terms for cascade logistics. We do not negotiate payment dates down. We negotiate scope.</p>
    </EditorialBlock>
  </Section>

  <Section eyebrow="What we look for" title="Six categories we will partner on." bg="paper-2">
    <div class="grid-12">
      {lookFor.map(item => (
        <article class="col-6 rounded-xl bg-[color:var(--color-paper)] p-6">
          <h3 class="text-xl leading-snug">{item.k}</h3>
          <p class="mt-3 text-base leading-relaxed text-[color:var(--color-slate)]">{item.v}</p>
          {item.cta && <a href={link(item.cta.href)} class="mt-4 inline-block text-sm font-mono text-[color:var(--color-saffron-text)] hover:underline">{item.cta.label} →</a>}
        </article>
      ))}
    </div>
  </Section>

  <Section narrow eyebrow="A note on what we won't do" title="Three lines we will not cross." bg="paper-2">
    <div class="prose-svge">
      <p>We won't sell a stake to a fund. The 70/30 family equity split is the equity split — we are not adding a third party at this stage. Future plants, if they exist, will be financed the same way unless we discover a structural reason to change.</p>
      <p>We won't dispatch out-of-spec gas. Continuous analysers stamp every slip; out-of-spec is recycled, not sold. IOCL gets IS 16087:2016 or it gets nothing — and the same standard applies internally.</p>
      <p>We won't pay middlemen between us and the farmer. The whole point is to be a buyer that pays the farmer directly, on the slip, in 14 days. Adding a layer breaks the model.</p>
    </div>
  </Section>

  <!-- ACTION — pick a door -->
  <Section eyebrow="Pick a door" title="Tell us which conversation to start.">
    <IntentChooser />
  </Section>
</Base>
