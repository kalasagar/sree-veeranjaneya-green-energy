---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { SITE } from '../lib/site';
---
<Base title="Press" description="Press kit for journalists covering SVGE — boilerplate, fact sheet, logo pack, founder quotes, contact.">
  <Section eyebrow="Press" title="Press kit">
    <div class="prose-svge">
      <p>Everything below is on the record and may be reproduced with attribution. We aim to reply to journalist queries within one business day.</p>
    </div>

    <div class="mt-10 grid lg:grid-cols-2 gap-6">
      <div class="rounded-2xl bg-white border border-black/5 p-6">
        <h2 class="text-xl">Boilerplate (60 words)</h2>
        <p class="mt-3 text-sm leading-relaxed">{SITE.description}</p>
      </div>
      <div class="rounded-2xl bg-white border border-black/5 p-6">
        <h2 class="text-xl">Boilerplate (longer, 120 words)</h2>
        <p class="mt-3 text-sm leading-relaxed">
          Sree Veeranjaneya Green Energy Pvt Ltd is a small family-owned Compressed Bio-Gas (CBG) project in Thatipadu village, Vizianagaram district, Andhra Pradesh. Founded in June 2024 by Pogiri Suri Rao and Pogiri Deepika, the company is building a 4 TPD CBG plant aligned with India's SATAT and GOBARdhan missions. The plant will produce IS 16087:2016 specification transport fuel for Indian Oil under a signed Letter of Intent, and Fermented Organic Manure for local farmers. Total project cost is ₹33.27 crore. The plant is currently in pre-construction. The founders hold 100% of the equity (70/30) and have publicly committed to monthly progress disclosures once construction begins.
        </p>
      </div>
    </div>

    <div class="mt-6 grid lg:grid-cols-2 gap-6">
      <div class="rounded-2xl bg-white border border-black/5 p-6">
        <h2 class="text-xl">Fast facts</h2>
        <ul class="mt-3 text-sm leading-relaxed list-disc list-inside space-y-1">
          <li>Founded: 12 June 2024</li>
          <li>CIN: {SITE.cin}</li>
          <li>Plant capacity: 4 TPD CBG · 9,600 Nm³/day raw biogas</li>
          <li>Standard: IS 16087:2016 (≥90% CH₄)</li>
          <li>Site: Thatipadu village, Regidi Amadalavalasa mandal, Vizianagaram, AP — 532440</li>
          <li>Land: 2.63 acres (owner titled)</li>
          <li>Captive solar: 500 kW</li>
          <li>Project cost: ₹33.27 crore</li>
          <li>Equity / debt: ₹8.37 Cr / ₹23.40 Cr (10-year term)</li>
          <li>Offtake: Indian Oil Corporation — Letter of Intent issued</li>
          <li>Technology partner: Raj Process Equipments & Systems Pvt Ltd, Pune (SATAT-approved)</li>
          <li>Feedstock: Napier grass (contract farming), paddy straw, cattle dung</li>
          <li>Co-product: 1 TPH solid + 52 m³/day liquid Fermented Organic Manure</li>
        </ul>
      </div>

      <div class="rounded-2xl bg-white border border-black/5 p-6">
        <h2 class="text-xl">Logo & brand pack</h2>
        <p class="mt-3 text-sm leading-relaxed">Free for editorial use with attribution. Please do not modify, recolour, or place on background colours other than off-white / brand green.</p>
        <ul class="mt-4 grid grid-cols-2 gap-3 text-sm">
          <li><a href="/brand/mark.svg">Mark — SVG</a></li>
          <li><a href="/brand/mark_2048.png">Mark — PNG 2048</a></li>
          <li><a href="/brand/mark_1024.png">Mark — PNG 1024</a></li>
          <li><a href="/brand/mark_512.png">Mark — PNG 512</a></li>
          <li><a href="/brand/linkedin_banner.png">LinkedIn banner</a></li>
          <li><a href="/brand/og_image.png">OG / social card</a></li>
        </ul>
        <p class="mt-4 text-[11px] font-mono text-[color:var(--color-slate-2)]">Palette: forest #1B5E20 · saffron #E65100 · paper #FAFAF7 · slate #37474F.</p>
      </div>
    </div>

    <div class="mt-6 grid lg:grid-cols-2 gap-6">
      {SITE.promoters.map(p => (
        <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-6">
          <div class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-saffron-text)]">Founder quote · on the record</div>
          <blockquote class="mt-3 border-l-4 border-[color:var(--color-forest)] pl-4 italic">
            <p class="text-base leading-relaxed">{`"${p.quote}"`}</p>
            <footer class="mt-2 text-xs font-mono not-italic">
              — {p.name}, {p.role}{p.quoteDraft ? <span class="ml-2 text-[color:var(--color-saffron-text)] not-italic">[Draft — pending founder approval]</span> : ''}
            </footer>
          </blockquote>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-2xl bg-[color:var(--color-forest)] text-[color:var(--color-paper)] p-8">
      <h2 class="text-xl text-[color:var(--color-paper)]">Journalist contact</h2>
      <p class="mt-3 text-sm">Email <a class="underline text-[color:var(--color-paper)]" href={`mailto:${SITE.email}?subject=Press%20enquiry`}>{SITE.email}</a> with subject line "Press enquiry". We aim to reply within one business day.</p>
      <p class="mt-3 text-xs opacity-80">If you need a phone call, the founders are available by appointment after construction begins.</p>
    </div>
  </Section>
</Base>
