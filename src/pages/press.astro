---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import ChipRail from '../components/ChipRail.astro';
import Mark from '../components/Mark.astro';
import NotifyMe from '../components/NotifyMe.astro';
import { SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
const chips = [
  { id: 'boilerplate', label: 'Boilerplate' },
  { id: 'facts', label: 'Fast facts' },
  { id: 'brand', label: 'Brand pack' },
  { id: 'quotes', label: 'Quotes' },
  { id: 'journal', label: 'Journal' },
];

const facts: [string, string][] = [
  ['Founded', '12 June 2024, ROC Vijayawada'],
  ['CIN', SITE.cin],
  ['Plant capacity', '4 TPD CBG, 9,600 Nm³/day raw biogas'],
  ['Standard', 'IS 16087:2016 (≥90% CH₄)'],
  ['Site', 'Thatipadu village, Regidi Amadalavalasa mandal, Vizianagaram, AP 532440'],
  ['Land', '2.63 acres, owned by the Managing Director'],
  ['Captive solar', '0.5 MW'],
  ['Project cost', 'Privately financed. Full capital structure shared with qualified lenders on request.'],
  ['Confirmed incentives', 'Three central schemes (MNRE CFA, AGRL, FOM MDA), plus a 5-year income-tax holiday. Per-scheme sizing in the lender data room.'],
  ['Offtake', 'Indian Oil, LoI 04 October 2024, 15-year Commercial Agreement'],
  ['Commissioning deadline', '04 October 2026 (LoI clause 2)'],
  ['Tech partner', 'Raj Process Equipments & Systems Pvt Ltd, Pune (SATAT-approved)'],
  ['Feedstock', 'Napier (40-km radius, 5-yr farmer agreements), paddy straw, and cattle dung'],
  ['Co-product', '1 TPH solid FOM, plus 52 m³/day liquid'],
  ['CPCB category', 'WHITE (the lowest pollution tier)'],
  ['Team', '47 on plant payroll, about 120 direct and indirect at steady state'],
  ['SATAT context', '80 plants commissioned and 72 under construction (MoPNG, Nov 2024)'],
];
---
<Base title="Press" description="Press kit, fast facts, brand pack, and build journal for journalists covering SVGE." heroOver={true}>
  <FullBleedHero banner="press_kit" alt="Press kit folder on a dark slate desk." eyebrow="Press" height="xl">
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2rem, 6vw, 5rem);">
      <span class="block">Boilerplate.</span>
      <span class="block" style="color: var(--color-gold);">Brand pack.</span>
      <span class="block">Build journal.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Boilerplate copy at two lengths, brand assets, founder quotes, and a fact-sheet covering CIN, capacity, the Indian Oil Letter of Intent, the EPC partner, and the commissioning clock. The monthly build journal lives below. Reproduce with attribution; email queries get a reply within one business day.
    </p>
  </FullBleedHero>

  <ChipRail items={chips} />

  <Section id="boilerplate" eyebrow="Boilerplate" title="Two lengths. Copy-ready.">
    <p class="meta mb-6" style="color: var(--color-slate-2); max-width: 56ch;">Reproduce with attribution to <strong style="color: var(--color-ink);">Sree Veeranjaneya Green Energy</strong>. Click the copy button on either card; we'll send corrections within one business day on email request.</p>

    <ol class="svge-boiler-grid" role="list">
      <li class="svge-boiler">
        <header class="svge-boiler-head">
          <div>
            <p class="svge-boiler-tag">25 words · Tagline</p>
            <p class="svge-boiler-use">For social bios + photo captions.</p>
          </div>
          <button type="button" class="svge-boiler-copy" data-copy="boiler-25" aria-label="Copy the 25-word tagline">
            <span class="svge-boiler-copy-label">Copy</span>
          </button>
        </header>
        <blockquote class="svge-boiler-body" data-boiler-text="boiler-25">SVGE is a 4 TPD Compressed Bio-Gas plant in Thatipadu, Vizianagaram, Andhra Pradesh, on a 2-year clock from Indian Oil's SATAT Letter of Intent.</blockquote>
        <p class="svge-boiler-meta">25 words · 144 characters · fits a tweet, a sub-headline, or a photo credit.</p>
      </li>

      <li class="svge-boiler">
        <header class="svge-boiler-head">
          <div>
            <p class="svge-boiler-tag">60 words · Standfirst</p>
            <p class="svge-boiler-use">For the dek under a headline.</p>
          </div>
          <button type="button" class="svge-boiler-copy" data-copy="boiler-60" aria-label="Copy the 60-word standfirst">
            <span class="svge-boiler-copy-label">Copy</span>
          </button>
        </header>
        <blockquote class="svge-boiler-body" data-boiler-text="boiler-60">{SITE.description}</blockquote>
        <p class="svge-boiler-meta">~60 words. The official site description; matches OG and meta tags.</p>
      </li>

      <li class="svge-boiler svge-boiler--wide">
        <header class="svge-boiler-head">
          <div>
            <p class="svge-boiler-tag">120 words · Profile paragraph</p>
            <p class="svge-boiler-use">For the "about the company" footer of a piece.</p>
          </div>
          <button type="button" class="svge-boiler-copy" data-copy="boiler-120" aria-label="Copy the 120-word profile paragraph">
            <span class="svge-boiler-copy-label">Copy</span>
          </button>
        </header>
        <blockquote class="svge-boiler-body" data-boiler-text="boiler-120">Sree Veeranjaneya Green Energy Private Limited (CIN U35101AP2024PTC115061) is a two-director Andhra Pradesh company building a 4 TPD Compressed Bio-Gas plant in Thatipadu, Vizianagaram. IOCL LoI under SATAT issued 04.10.2024 (ref IndianOil/SATAT/01/3931), 2-year commissioning clock to 04.10.2026, 15-year Commercial Agreement. SVGE is one of about 152 SATAT CBG projects nationally and one of seven in Andhra Pradesh. EPC partner: SATAT-approved Raj Process Equipments &amp; Systems Pvt Ltd, Pune. Built to IS 16087:2016 spec, CPCB WHITE, runs on Napier grass from a 40-km supply radius. The build is privately financed, with three confirmed central-government incentives (MNRE CFA, AGRL, FOM MDA). Full capital structure shared with qualified lenders on request.</blockquote>
        <p class="svge-boiler-meta">~120 words. Carries CIN, dates, references, and partner names.</p>
      </li>
    </ol>

    <p class="svge-boiler-aria" aria-live="polite" aria-atomic="true" role="status"></p>
  </Section>

  <style>
    .svge-boiler-grid {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    @media (min-width: 768px) { .svge-boiler-grid { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
    .svge-boiler--wide { grid-column: 1 / -1; }

    .svge-boiler {
      background: var(--color-paper);
      border: 1px solid var(--rule-color);
      border-radius: 0.5rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    @media (min-width: 640px) { .svge-boiler { padding: 1.75rem; } }

    .svge-boiler-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
    }
    .svge-boiler-tag {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-saffron-text);
    }
    .svge-boiler-use {
      margin-top: 0.25rem;
      font-size: 0.8125rem;
      color: var(--color-slate);
    }

    .svge-boiler-copy {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.875rem;
      border: 1px solid var(--color-ink);
      border-radius: 999px;
      background: var(--color-paper);
      color: var(--color-ink);
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
      min-height: 36px;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .svge-boiler-copy:hover { background: var(--color-ink); color: var(--color-paper); }
    .svge-boiler-copy:focus-visible {
      outline: 2px solid var(--color-saffron);
      outline-offset: 2px;
    }
    .svge-boiler-copy.is-copied {
      background: var(--color-forest);
      color: var(--color-paper);
      border-color: var(--color-forest);
    }

    .svge-boiler-body {
      margin: 0;
      padding: 1rem 1.25rem;
      background: var(--color-paper-2);
      border-left: 3px solid var(--color-saffron);
      border-radius: 0 0.25rem 0.25rem 0;
      font-family: var(--font-display);
      font-size: 0.9375rem;
      line-height: 1.55;
      color: var(--color-ink);
    }

    .svge-boiler-meta {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      color: var(--color-slate-2);
      margin: 0;
    }

    .svge-boiler-aria {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var live = document.querySelector('.svge-boiler-aria');
      function announce(msg) { if (live) { live.textContent = ''; setTimeout(function () { live.textContent = msg; }, 30); } }
      document.querySelectorAll('.svge-boiler-copy').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var key = btn.getAttribute('data-copy');
          var src = document.querySelector('[data-boiler-text="' + key + '"]');
          if (!src) return;
          var text = (src.textContent || '').trim();
          var done = function () {
            btn.classList.add('is-copied');
            var label = btn.querySelector('.svge-boiler-copy-label');
            var prev = label ? label.textContent : '';
            if (label) label.textContent = 'Copied';
            announce('Boilerplate copied to clipboard.');
            setTimeout(function () {
              btn.classList.remove('is-copied');
              if (label) label.textContent = prev || 'Copy';
            }, 1800);
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done).catch(function () {
              // Fallback for non-https / older browsers
              var ta = document.createElement('textarea');
              ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'absolute'; ta.style.left = '-9999px';
              document.body.appendChild(ta); ta.select();
              try { document.execCommand('copy'); done(); } catch (e) { /* swallow */ }
              document.body.removeChild(ta);
            });
          } else {
            var ta = document.createElement('textarea');
            ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'absolute'; ta.style.left = '-9999px';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); done(); } catch (e) { /* swallow */ }
            document.body.removeChild(ta);
          }
        });
      });
    });
  </script>

  <Section id="facts" eyebrow="Fast facts" title="Everything a journalist will ask." bg="paper-2">
    <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px" style="background: var(--rule-color);">
      {facts.map(([k, v]) => (
        <div class="p-5" style="background: var(--color-paper);">
          <dt class="eyebrow mb-1">{k}</dt>
          <dd class="numeral text-sm" style="color: var(--color-forest);">{v}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="brand" eyebrow="Brand pack" title="Logo, palette, banners.">
    <div class="mb-10 flex items-center gap-8 p-8 svge-card">
      <Mark size={160} />
      <div>
        <p class="eyebrow mb-2">The mark</p>
        <p class="text-lg leading-relaxed max-w-[40ch]">Forest leaf · saffron flame · paper field. The leaf is the feedstock; the flame is what we turn it into.</p>
      </div>
    </div>
    <!-- Whole-kit zip — generated at build time by scripts/build_brand_pack.mjs -->
    <a
      href={link('/brand/svge-brand-pack.zip')}
      class="mb-6 inline-flex items-center justify-between gap-3 px-5 py-3 rounded-full no-underline"
      style="background: var(--color-ink); color: var(--color-paper); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;"
      download
    >
      <span>Download the full brand pack (.zip)</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v14"/><polyline points="6 11 12 17 18 11"/><line x1="4" y1="21" x2="20" y2="21"/></svg>
    </a>

    <div class="grid lg:grid-cols-[2fr_1fr] gap-6">
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm">
        {[
          ['Mark (SVG)', '/brand/mark.svg'],
          ['Mark (PNG 2048)', '/brand/mark_2048.png'],
          ['Mark (PNG 1024)', '/brand/mark_1024.png'],
          ['Mark (PNG 512)', '/brand/mark_512.png'],
          ['LinkedIn banner', '/brand/linkedin_banner.png'],
          ['OG / social card', '/brand/og_image.png'],
        ].map(([label, href]) => (
          <li><a href={link(href)} class="block p-4 svge-card no-underline">{label}</a></li>
        ))}
      </ul>
      <aside class="svge-card p-6">
        <p class="eyebrow mb-2">Palette</p>
        <ul class="numeral text-sm space-y-1">
          <li>Forest #1B5E20</li>
          <li>Saffron #E65100</li>
          <li>Paper #FAFAF7</li>
          <li>Ink #0A0A0A</li>
        </ul>
      </aside>
    </div>
  </Section>

  <Section id="quotes" eyebrow="Founder quotes" title="On the record." bg="paper-2" narrow>
    <p class="prose-svge">Both founders are quoted on the record on the About page. The quotes carry their signed attribution and stay current as the company evolves.</p>
    <p class="mt-6"><a href={link('/about/#founders')}>Founder quotes on /about →</a></p>
  </Section>

  <Section id="journal" eyebrow="Build journal" title="Monthly receipts.">
    {posts.length === 0 && <p class="meta">No posts yet. The first one lands the day construction begins. Target: Q3 2026.</p>}
    {posts.map(post => (
      <article class="rule-bold pt-5 pb-8 max-w-3xl" data-reveal>
        <p class="meta">{fmt.format(post.data.date)}</p>
        <h3 class="mt-2" style="font-family: var(--font-display); font-size: 1.75rem;">
          <a href={link(`/news/${post.id}/`)} style="text-decoration: none;">{post.data.title}</a>
        </h3>
        <p class="mt-2 leading-relaxed">{post.data.summary}</p>
      </article>
    ))}
  </Section>

  <Section narrow bg="paper-2">
    <NotifyMe
      topic="Newsletter"
      eyebrow="Stay in the loop"
      title="One email a month, from the day concrete is poured."
      body="Same content as the build journal, delivered. Unsubscribe at any time."
      cta="Send me the monthly update"
    />
  </Section>

  <Section narrow>
    <article class="svge-card p-8" style="background: var(--color-ink); color: var(--color-paper);">
      <p class="eyebrow" style="color: color-mix(in oklab, var(--color-paper) 70%, transparent);">Journalist contact</p>
      <p class="mt-3 text-xl">Email <a class="underline" style="color: var(--color-paper);" href={`mailto:${SITE.email}?subject=Press%20enquiry`}>{SITE.email}</a> with subject "Press enquiry".</p>
      <p class="meta mt-3" style="color: color-mix(in oklab, var(--color-paper) 80%, transparent);">Reply within one business day.</p>
    </article>
  </Section>
</Base>
