---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import PromiseBlock from '../components/PromiseBlock.astro';
import Stat from '../components/Stat.astro';
import TrustBand from '../components/TrustBand.astro';
import EditorialBlock from '../components/EditorialBlock.astro';
import BuildInPublicReel from '../components/BuildInPublicReel.astro';
import Stakeholders from '../components/Stakeholders.astro';
import { SITE } from '../lib/site';
---
<Base heroOver={true}>
  <!-- 1 · Hero -->
  <FullBleedHero
    banner="hero_paddy_dawn"
    alt="A paddy field at dawn in coastal Andhra Pradesh."
    video="hero_dawn_paddy_to_flame"
    hasAudio={false}
    height="xl"
    priority
  >
    <h1
      class="display text-[color:var(--color-paper)] space-y-2 sm:space-y-3 pt-12 sm:pt-16"
      style="font-size: clamp(2rem, 5.25vw, 4.5rem); line-height: 1;"
    >
      <span class="block">{SITE.hero.h1Top}</span>
      <span class="block" style="color: var(--color-gold);">{SITE.hero.h1Mid}</span>
      <span class="block">{SITE.hero.h1Bottom}</span>
    </h1>
    <p class="mt-6 text-lg sm:text-xl max-w-2xl text-[color:var(--color-paper)]/95 leading-relaxed">{SITE.hero.sub}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={link('/build/')} class="btn btn-on-dark">Read the build →</a>
      <a href={link('/farmers/')} class="btn" style="background: var(--color-ink); color: var(--color-paper);">Are you a farmer?</a>
    </div>
  </FullBleedHero>

  <!-- 2 · The shift (plain-English framing) -->
  <Section>
    <PromiseBlock
      eyebrow="Plainly, what this is"
      anchors={["We buy", "We make fuel", "We return value"]}
      paragraphs={[
        "We buy what farmers in Vizianagaram and Srikakulam would otherwise burn — paddy straw, Napier grass, cattle dung — and turn it into clean Compressed Bio-Gas for Indian Oil under a signed Letter of Intent.",
        "The organic manure that comes out alongside is sold in the same forty-kilometre catchment we sourced from, at a fair market rate. Nothing leaves the belt; the money, the fuel, and the soil all circulate.",
      ]}
      image="impact_fom_soil"
      imageAlt="A hand spreading organic manure on Andhra soil at golden hour."
    />
  </Section>

  <!-- 3 · What's at stake (macro framing, three editorial stats) -->
  <Section
    eyebrow="What's at stake"
    title="Why this matters, in three numbers."
    bg="paper-2"
    lede="A small plant in coastal Andhra sits between two large national problems: the cost of imported oil, and the cost of burning what we should have used."
  >
    <div class="grid sm:grid-cols-3 gap-4">
      {SITE.stakeStats.map(s => <Stat value={s.value} unit={s.unit} label={s.k} framing={s.framing} />)}
    </div>
  </Section>

  <!-- 4 · Hard credentials (trust band) -->
  <Section
    eyebrow="Hard credentials"
    title="Real, not vapour."
    lede="The signals lenders, journalists, and SATAT officials usually have to dig for. Surfaced here, with dates and names."
  >
    <TrustBand />
  </Section>

  <!-- 5 · Why this plant, why now (3 narrative differentiators) -->
  <Section
    eyebrow="Why this plant, why now"
    title="Three reasons this is not just another approved SATAT plant."
    bg="paper-2"
    lede="There are about 152 SATAT plants in the pipeline. Most are stuck. Here is what is different about ours."
  >
    <div class="space-y-20">
      {SITE.differentiators.map((d, i) => (
        <EditorialBlock side={i % 2 === 0 ? 'left' : 'right'} numeral={`0${i + 1}`} title={d.title} image={i === 0 ? 'hero_paddy_dawn' : null} imageAlt="">
          <p>{d.body}</p>
        </EditorialBlock>
      ))}
    </div>
  </Section>

  <!-- 6 · Built in public -->
  <Section>
    <BuildInPublicReel />
  </Section>

  <!-- 7 · Pick the door (Stakeholders router) -->
  <Section eyebrow="Talk to us" title="Pick the door that fits." bg="paper-2">
    <Stakeholders />
  </Section>
</Base>
