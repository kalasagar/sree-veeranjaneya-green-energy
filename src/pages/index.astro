---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import Countdown from '../components/Countdown.astro';
import Stat from '../components/Stat.astro';
import EditorialBlock from '../components/EditorialBlock.astro';
import SATATPositioner from '../components/SATATPositioner.astro';
import DayInTheData from '../components/DayInTheData.astro';
import Stakeholders from '../components/Stakeholders.astro';
import { SITE } from '../lib/site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
).slice(0, 3);
const fmt = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
---
<Base heroOver={true}>
  <FullBleedHero
    banner="hero_paddy_dawn"
    alt="A paddy field at dawn in coastal Andhra Pradesh."
    eyebrow={SITE.hero.eyebrow}
    video="hero_dawn_paddy_to_flame"
    height="xl"
    priority
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3" style="font-size: clamp(2.75rem, 6vw, 5rem);">
      {SITE.hero.h1Top}<br/>
      <span style="color: var(--color-gold);">{SITE.hero.h1Mid}</span><br/>
      {SITE.hero.h1Bottom}
    </h1>
    <p class="mt-6 text-lg sm:text-xl max-w-2xl text-[color:var(--color-paper)]/95 leading-relaxed">{SITE.hero.sub}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={link('/build/')} class="btn btn-on-dark">Read the build →</a>
      <a href={link('/farmers/')} class="btn btn-ghost" style="color: var(--color-paper); border-color: var(--color-paper);">Are you a farmer?</a>
    </div>
  </FullBleedHero>

  <Kicker eyebrow="One plant · two-year clock · 40 km" deck='4 TPD CBG. <span style="color:var(--color-saffron-text);">40-km supply radius.</span> A 2-year clock.' />

  <!-- Countdown -->
  <Section narrow>
    <Countdown label="to the IOCL commissioning deadline" />
  </Section>

  <!-- What's at stake -->
  <Section eyebrow="What's at stake" title="Why this matters, in three numbers." bg="paper-2">
    <div class="grid sm:grid-cols-3 gap-4">
      {SITE.stakeStats.map(s => <Stat value={s.value} unit={s.unit} label={s.k} framing={s.framing} />)}
    </div>
  </Section>

  <!-- A day in the data -->
  <Section eyebrow="A day in the data" title="One operating day, in numbers.">
    <DayInTheData />
  </Section>

  <!-- SATAT positioner -->
  <Section bg="paper-2">
    <SATATPositioner />
  </Section>

  <!-- Why this plant -->
  <Section eyebrow="Why this plant, why now" title="Three reasons this is not just another approved SATAT plant.">
    <div class="space-y-20">
      {SITE.differentiators.map((d, i) => (
        <EditorialBlock side={i % 2 === 0 ? 'left' : 'right'} numeral={`0${i + 1}`} title={d.title} image={i === 0 ? 'hero_paddy_dawn' : null} imageAlt="">
          <p>{d.body}</p>
        </EditorialBlock>
      ))}
    </div>
  </Section>

  <!-- Build journal -->
  {posts.length > 0 && (
    <Section eyebrow="From the build journal" title="Monthly receipts." bg="paper-2">
      <div class="grid sm:grid-cols-3 gap-4">
        {posts.map(p => (
          <a href={link(`/news/${p.id}/`)} class="svge-card p-6 no-underline">
            <p class="meta">{fmt.format(p.data.date)}</p>
            <h3 class="mt-3 text-xl leading-snug">{p.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed">{p.data.summary}</p>
          </a>
        ))}
      </div>
      <p class="mt-6 text-sm"><a href={link('/press/#journal')}>The full build journal →</a></p>
    </Section>
  )}

  <!-- Stakeholders -->
  <Section eyebrow="Talk to us" title="Pick the door that fits.">
    <Stakeholders />
  </Section>
</Base>
