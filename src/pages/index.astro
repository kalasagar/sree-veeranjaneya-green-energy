---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Manifesto from '../components/Manifesto.astro';
import Stat from '../components/Stat.astro';
import { SITE } from '../lib/site';
---
<Base>
  <Manifesto />

  <!-- WHAT'S AT STAKE -->
  <Section eyebrow="What's at stake" title="Why this matters, in three numbers">
    <div class="grid sm:grid-cols-3 gap-4 sm:gap-5">
      {SITE.stakeStats.map(s => <Stat stat={s} large />)}
    </div>
  </Section>

  <!-- HOW THIS PLANT CLOSES THE LOOP -->
  <Section eyebrow="How this plant closes the loop" title="Five steps. One cycle. No smoke.">
    <ol class="grid sm:grid-cols-5 gap-3 sm:gap-4 text-sm">
      <li class="rounded-2xl bg-white border border-black/5 p-5">
        <div class="font-mono text-xs text-[color:var(--color-saffron-text)]">01 · Field</div>
        <h3 class="mt-2 text-base">Farmer harvests</h3>
        <p class="mt-2 text-xs leading-relaxed text-[color:var(--color-slate)]">Paddy straw and cattle dung come off the field. Today, most of it burns. We pay for it instead.</p>
      </li>
      <li class="rounded-2xl bg-white border border-black/5 p-5">
        <div class="font-mono text-xs text-[color:var(--color-saffron-text)]">02 · Digester</div>
        <h3 class="mt-2 text-base">We digest it</h3>
        <p class="mt-2 text-xs leading-relaxed text-[color:var(--color-slate)]">9,600 Nm³ of raw biogas per day from a single CSTR-type anaerobic digester running 24 hours.</p>
      </li>
      <li class="rounded-2xl bg-white border border-black/5 p-5">
        <div class="font-mono text-xs text-[color:var(--color-saffron-text)]">03 · Purification</div>
        <h3 class="mt-2 text-base">We purify it</h3>
        <p class="mt-2 text-xs leading-relaxed text-[color:var(--color-slate)]">Two-tower VPSA and scrubbers strip CO₂, H₂S, and moisture to ≥90% methane — IS 16087:2016 spec.</p>
      </li>
      <li class="rounded-2xl bg-white border border-black/5 p-5">
        <div class="font-mono text-xs text-[color:var(--color-saffron-text)]">04 · Dispatch</div>
        <h3 class="mt-2 text-base">IOCL buys it</h3>
        <p class="mt-2 text-xs leading-relaxed text-[color:var(--color-slate)]">4 tonnes per day of CBG. Roughly the daily CNG for 80 city buses. Under a signed Letter of Intent.</p>
      </li>
      <li class="rounded-2xl bg-white border border-black/5 p-5">
        <div class="font-mono text-xs text-[color:var(--color-saffron-text)]">05 · Return</div>
        <h3 class="mt-2 text-base">FOM goes back</h3>
        <p class="mt-2 text-xs leading-relaxed text-[color:var(--color-slate)]">52 m³/day of liquid manure plus 1 TPH of solid FOM return to the same fields. Soil gets its carbon back.</p>
      </li>
    </ol>
  </Section>

  <!-- WHY THIS PLANT, WHY NOW -->
  <Section eyebrow="Why this plant, why now" title="Three reasons this is not just another approved SATAT plant">
    <div class="grid sm:grid-cols-3 gap-5">
      {SITE.differentiators.map(d => (
        <article class="rounded-2xl bg-[color:var(--color-paper-2)] p-6">
          <h3 class="text-lg leading-snug">{d.title}</h3>
          <p class="mt-3 text-sm leading-relaxed">{d.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- BUILT IN PUBLIC -->
  <Section narrow eyebrow="Built in public" title="No glossy reveal. Monthly receipts.">
    <p class="text-lg leading-relaxed">{SITE.publicPromise}</p>
    <p class="mt-6">
      <a href="/news/" class="btn btn-primary">Read the first post ↗</a>
    </p>
    <p class="mt-3 text-sm text-[color:var(--color-slate-2)]">
      Posts continue monthly from the day concrete is poured.
      <a href="/careers/">Careers</a> and <a href="/press/">press</a> get the same updates.
    </p>
  </Section>

  <!-- PARTNERS -->
  <Section eyebrow="Partners" title="Trusted by">
    <div class="grid sm:grid-cols-3 gap-5 text-sm">
      {SITE.partners.map(p => (
        <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-5">
          <div class="font-semibold text-[color:var(--color-forest)]">{p.name}</div>
          <div class="mt-1 text-xs font-mono uppercase tracking-wider text-[color:var(--color-saffron-text)]">{p.role}</div>
          <p class="mt-2 text-[color:var(--color-slate-2)] leading-relaxed">{p.note}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- SEGMENTED CTA -->
  <Section narrow eyebrow="Talk to us" title="Pick the door that fits">
    <div class="grid sm:grid-cols-2 gap-3">
      <a href="/farmers/" class="rounded-2xl bg-[color:var(--color-forest)] text-[color:var(--color-paper)] p-6 no-underline hover:bg-[color:var(--color-forest-dark)] transition-colors">
        <div class="text-xs font-mono uppercase tracking-widest">For Farmers</div>
        <div class="mt-2 text-lg font-semibold">We buy your paddy straw, Napier and dung.</div>
        <div class="mt-1 text-sm">14-day payment, bank transfer, 50 km radius.</div>
      </a>
      <a href="/contact/" class="rounded-2xl bg-[color:var(--color-saffron-text)] text-[color:var(--color-paper)] p-6 no-underline hover:bg-[color:var(--color-saffron)] transition-colors">
        <div class="text-xs font-mono uppercase tracking-widest">For Partners & Press</div>
        <div class="mt-2 text-lg font-semibold">EPC, logistics, FOM offtake, journalists, future hires.</div>
        <div class="mt-1 text-sm">Email reply within two business days.</div>
      </a>
    </div>
  </Section>
</Base>
