---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import ChipRail from '../components/ChipRail.astro';
import Countdown from '../components/Countdown.astro';
import TimelineRail from '../components/TimelineRail.astro';
import ClearanceMatrix from '../components/ClearanceMatrix.astro';
import SATATPositioner from '../components/SATATPositioner.astro';
import CapitalFlow from '../components/CapitalFlow.astro';
import PlantMap from '../components/PlantMap.astro';
import Stat from '../components/Stat.astro';
import { SITE } from '../lib/site';

const chips = [
  { id: 'status', label: 'Status' },
  { id: 'capital', label: 'Capital' },
  { id: 'clearances', label: 'Clearances' },
  { id: 'site', label: 'Site' },
  { id: 'timeline', label: 'Timeline' },
  { id: 'dataroom', label: 'Data room' },
];
---
<Base title="The Build" description="The whole build, in structure: three confirmed central incentives, seven clearances, ~120 jobs in the belt. Private-side structure in the data room." heroOver={true}>
  <FullBleedHero
    banner="build_concrete_pour"
    alt="A crew guiding wet concrete down a chute at golden hour on a rural Andhra plant site."
    eyebrow="The Build"
    objectPosition="50% 50%"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2rem, 6vw, 5rem);">
      <span class="block">4 TPD CBG.</span>
      <span class="block" style="color: var(--color-gold);">40-km radius.</span>
      <span class="block">A 2-year clock.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      Three confirmed central-government incentives on the public side (MNRE CFA, AGRL, FOM MDA). Four statutory clearances obtained, three sequenced against the commissioning clock. The Indian Oil Letter of Intent runs 15 years, with a procurement floor of ₹46/kg + taxes through 31 March 2029. Full capital structure reconciles in the data room on request.
    </p>
  </FullBleedHero>

  <ChipRail items={chips} />

  <!-- Status -->
  <Section id="status" eyebrow="Status" title="Where we are right now.">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-6 items-start">
      <Countdown size="lg" />
      <article class="svge-card p-8" data-reveal>
        <p class="eyebrow">LoI · 04.10.2024</p>
        <h3 class="display mt-2" style="font-size: 1.75rem;">IndianOil / SATAT / 01 / 3931</h3>
        <p class="mt-3 leading-relaxed">15-year Commercial Agreement. Price floor ₹{SITE.loi.priceFloorRsKg}/kg + taxes through {new Date(SITE.loi.priceFloorThrough).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' })}, indexed to CNG retail thereafter.</p>
        <dl class="mt-5 grid grid-cols-2 gap-3 numeral text-xs">
          <div><dt class="meta">Issuer</dt><dd>IOCL AE&amp;SD</dd></div>
          <div><dt class="meta">Signatory</dt><dd>{SITE.loi.issuerSignatory}</dd></div>
          <div><dt class="meta">CNG linkage</dt><dd>{SITE.loi.iocCnglinkagePct}%</dd></div>
          <div><dt class="meta">Quantity</dt><dd>{SITE.loi.quantityTpd} TPD</dd></div>
        </dl>
      </article>
    </div>
  </Section>

  <!-- Plant snapshot -->
  <Section bg="paper-2">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {SITE.plantStats.slice(0, 4).map(s => <Stat value={s.value} unit={s.unit} label={s.k} framing={s.framing} />)}
    </div>
  </Section>

  <!-- Capital -->
  <Section id="capital" eyebrow="Capital" title="How the project is funded.">
    <CapitalFlow />
  </Section>

  <!-- Clearances -->
  <Section id="clearances" eyebrow="Clearances" title="Statutory clearances obtained and sequenced." bg="paper-2">
    <ClearanceMatrix />
  </Section>

  <!-- Site plan -->
  <Section id="site" eyebrow="Site plan" title="On the ground." bg="paper-2">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-6 items-start">
      <PlantMap />
      <aside aria-label="Site and connectivity data sheet">
        <p class="eyebrow mb-4" style="color: var(--color-saffron-text);">Site &amp; connectivity</p>
        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded" style="background: var(--rule-color);">
          <div class="p-4 flex flex-col gap-2" style="background: var(--color-paper);">
            <dt class="eyebrow" style="color: var(--color-slate-2);">Village</dt>
            <dd style="font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; color: var(--color-ink); line-height: 1.2;">{SITE.plant.village}</dd>
          </div>
          <div class="p-4 flex flex-col gap-2" style="background: var(--color-paper);">
            <dt class="eyebrow" style="color: var(--color-slate-2);">Mandal</dt>
            <dd style="font-family: var(--font-display); font-weight: 700; font-size: 1rem; color: var(--color-ink); line-height: 1.2;">{SITE.plant.mandal}</dd>
          </div>
          <div class="col-span-2 p-4 flex flex-col gap-2" style="background: var(--color-paper);">
            <dt class="eyebrow" style="color: var(--color-slate-2);">District</dt>
            <dd style="font-family: var(--font-body); font-weight: 500; font-size: 0.9375rem; color: var(--color-ink); line-height: 1.4;">{SITE.plant.district}, {SITE.plant.state} <span style="font-family: var(--font-mono); color: var(--color-slate-2);">· {SITE.plant.pin}</span></dd>
          </div>
          <div class="p-4 flex flex-col gap-2" style="background: var(--color-ink); color: var(--color-paper);">
            <dt class="eyebrow" style="color: color-mix(in oklab, var(--color-paper) 70%, transparent);">Land</dt>
            <dd>
              <span style="font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; color: var(--color-paper); letter-spacing: -0.02em;">{SITE.plant.landAcres}</span>
              <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; color: var(--color-gold); text-transform: uppercase; margin-left: 4px;">ac</span>
            </dd>
            <p class="meta" style="color: color-mix(in oklab, var(--color-paper) 70%, transparent);">Owned by the MD</p>
          </div>
          <div class="p-4 flex flex-col gap-2" style="background: var(--color-paper);">
            <dt class="eyebrow" style="color: var(--color-slate-2);">Coordinates</dt>
            <dd style="font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-ink); line-height: 1.4;">{SITE.plant.lat.toFixed(4)}°N<br/>{SITE.plant.lng.toFixed(4)}°E</dd>
          </div>
        </dl>
        <p class="meta mt-4" style="color: var(--color-slate-2);">Concentric distances from the site are shown on the radius map at <a href="/sree-veeranjaneya-green-energy/farmers/#radius" style="color: var(--color-slate);">/farmers</a>.</p>
      </aside>
    </div>
  </Section>

  <!-- SATAT positioner -->
  <Section>
    <SATATPositioner />
  </Section>

  <!-- Timeline -->
  <Section id="timeline" eyebrow="Timeline" title="Where we are on the rail.">
    <div class="max-w-3xl">
      <TimelineRail />
    </div>
  </Section>

  <!-- Data room -->
  <Section id="dataroom" eyebrow="For lenders" title="The data room." bg="paper-2">
    <article class="svge-card p-8 max-w-3xl" data-reveal>
      <p class="eyebrow mb-3">Request the DPR</p>
      <p class="leading-relaxed">The full Detailed Project Report (cost sheet, sensitivity, DSCR, IRR, working-capital plan, equipment vendor quotations) is available on email request to qualified lenders.</p>
      <ul class="mt-4 list-disc pl-5 space-y-1 text-sm leading-relaxed">
        <li>Capital structure: {SITE.financing.structure}.</li>
        <li>Plant capacity {SITE.capacity.cbgTpd} TPD CBG · {SITE.capacity.rawGasNm3PerDay.toLocaleString('en-IN')} Nm³/day raw biogas · {SITE.capacity.workingHoursDay} h × {SITE.capacity.workingDaysYear} days · {SITE.capacity.standard}.</li>
        <li>IOCL LoI dated 04.10.2024 · {SITE.loi.commercialAgreementYears}-year Commercial Agreement · commissioning deadline 04.10.2026.</li>
        <li>CFA eligibility: MNRE Phase-I National Bioenergy Programme · three confirmed central incentives (MNRE CFA, AGRL, FOM MDA) · {SITE.financing.taxHolidayYears}-year tax holiday.</li>
        <li>UDYAM-registered MSME: {SITE.udyam}. ROC Vijayawada, Reg. No. {SITE.registrationNumber}.</li>
        <li>CPCB pollution category: WHITE. 4 clearances obtained, 3 applied, 1 after-COD.</li>
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={link('/build/data-room/')} class="btn btn-primary">View the one-pager →</a>
        <a href={`mailto:${SITE.email}?subject=DPR%20request`} class="btn btn-ghost">Email for the full DPR</a>
      </div>
      <p class="meta mt-4">The one-pager prints to a single A4 PDF (⌘P). The full DPR is shared on email request to qualified lenders with a brief intro to your institution.</p>
    </article>
  </Section>
</Base>
