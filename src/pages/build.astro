---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import ChipRail from '../components/ChipRail.astro';
import Countdown from '../components/Countdown.astro';
import TimelineRail from '../components/TimelineRail.astro';
import ClearanceMatrix from '../components/ClearanceMatrix.astro';
import RadiusMap from '../components/RadiusMap.astro';
import SATATPositioner from '../components/SATATPositioner.astro';
import TeamComposition from '../components/TeamComposition.astro';
import ComparisonCards from '../components/ComparisonCards.astro';
import CapitalFlow from '../components/CapitalFlow.astro';
import PlantMap from '../components/PlantMap.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Stat from '../components/Stat.astro';
import { SITE } from '../lib/site';

const chips = [
  { id: 'status', label: 'Status' },
  { id: 'capital', label: 'Capital' },
  { id: 'clearances', label: 'Clearances' },
  { id: 'radius', label: 'Radius' },
  { id: 'site', label: 'Site' },
  { id: 'impact', label: 'Impact' },
  { id: 'team', label: 'Team' },
  { id: 'dataroom', label: 'Data room' },
];
---
<Base title="The Build" description="₹33 Cr. ₹6.7 Cr in incentives. Seven clearances. 120 jobs. The whole build, in numbers." heroOver={true}>
  <FullBleedHero
    banner="project_plant_render"
    alt="Aerial view of the plant site surrounded by paddy fields."
    eyebrow="The Build"
    objectPosition="50% 20%"
    height="xl"
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2.75rem, 6vw, 5rem);">
      <span class="block">4 TPD CBG.</span>
      <span class="block" style="color: var(--color-gold);">40-km radius.</span>
      <span class="block">A 2-year clock.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      About ₹33 crore of total project cost, with ₹6.7 crore in confirmed central incentives (MNRE CFA, AGRL, FOM MDA) and a 10-year public-sector term loan. Four statutory clearances obtained, three sequenced against the commissioning clock. The Indian Oil Letter of Intent runs 15 years, with a procurement floor of ₹46/kg + taxes through 31 March 2029.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="The whole build, in numbers" deck='A thirty-three-crore build, with <span style="color: var(--color-saffron-text);">six and a half crore in incentives</span>, seven clearances, and a hundred and twenty jobs to come.' maxCh={34} />
  <ChipRail items={chips} />

  <!-- Status -->
  <Section id="status" eyebrow="Status" title="Where we are right now.">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-6 items-start">
      <Countdown size="lg" />
      <article class="svge-card p-8" data-reveal>
        <p class="eyebrow">LoI · 04.10.2024</p>
        <h3 class="display mt-2" style="font-size: 1.75rem;">IndianOil / SATAT / 01 / 3931</h3>
        <p class="mt-3 leading-relaxed">15-year Commercial Agreement. Price floor ₹{SITE.loi.priceFloorRsKg}/kg + taxes through {new Date(SITE.loi.priceFloorThrough).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' })}, indexed to CNG retail thereafter.</p>
        <dl class="mt-5 grid grid-cols-2 gap-3 numeral text-xs">
          <div><dt class="meta">Issuer</dt><dd>IOCL AE&amp;SD</dd></div>
          <div><dt class="meta">Signatory</dt><dd>{SITE.loi.issuerSignatory}</dd></div>
          <div><dt class="meta">CNG linkage</dt><dd>{SITE.loi.iocCnglinkagePct}%</dd></div>
          <div><dt class="meta">Quantity</dt><dd>{SITE.loi.quantityTpd} TPD</dd></div>
        </dl>
      </article>
    </div>
  </Section>

  <!-- Plant snapshot -->
  <Section bg="paper-2">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {SITE.plantStats.slice(0, 4).map(s => <Stat value={s.value} unit={s.unit} label={s.k} framing={s.framing} />)}
    </div>
  </Section>

  <!-- Capital -->
  <Section id="capital" eyebrow="Capital" title="How the project is funded.">
    <CapitalFlow />
  </Section>

  <!-- Clearances -->
  <Section bg="paper-2">
    <ClearanceMatrix />
  </Section>

  <!-- Radius -->
  <Section id="radius" eyebrow="Radius" title="A 40-km supply belt and a 75-km dispatch cap.">
    <RadiusMap highlight={40} caption="Concentric distances from the plant site at Thatipadu." />
  </Section>

  <!-- Site plan -->
  <Section id="site" eyebrow="Site plan" title="On the ground." bg="paper-2">
    <div class="grid lg:grid-cols-[2fr_1fr] gap-6 items-start">
      <PlantMap />
      <aside class="prose-svge">
        <h3 style="font-size: 1.25rem;">Site &amp; connectivity</h3>
        <ul class="text-sm">
          <li><strong>Village:</strong> {SITE.plant.village}</li>
          <li><strong>Mandal:</strong> {SITE.plant.mandal}</li>
          <li><strong>District:</strong> {SITE.plant.district}, {SITE.plant.state}, {SITE.plant.pin}</li>
          <li><strong>Land:</strong> {SITE.plant.landAcres} ac, MD-owned</li>
        </ul>
      </aside>
    </div>
  </Section>

  <!-- SATAT positioner -->
  <Section>
    <SATATPositioner />
  </Section>

  <!-- Impact -->
  <Section id="impact" eyebrow="Impact" title="What 4 TPD looks like." bg="paper-2">
    <ComparisonCards />
  </Section>

  <Section>
    <IndiaMap />
  </Section>

  <!-- Team -->
  <Section id="team" eyebrow="Team" title="Who is doing the work." bg="paper-2">
    <TeamComposition />
  </Section>

  <!-- Timeline -->
  <Section eyebrow="Timeline" title="Where we are on the rail.">
    <div class="max-w-3xl">
      <TimelineRail />
    </div>
  </Section>

  <!-- Data room -->
  <Section id="dataroom" eyebrow="For lenders" title="The data room." bg="paper-2">
    <article class="svge-card p-8 max-w-3xl" data-reveal>
      <p class="eyebrow mb-3">Request the DPR</p>
      <p class="leading-relaxed">The full Detailed Project Report (cost sheet, sensitivity, DSCR, IRR, working-capital plan, equipment vendor quotations) is available on email request to qualified lenders.</p>
      <ul class="mt-4 list-disc pl-5 space-y-1 text-sm leading-relaxed">
        <li>Total project cost ≈ ₹{SITE.financing.totalCr} Cr. {SITE.financing.structure}.</li>
        <li>Plant capacity {SITE.capacity.cbgTpd} TPD CBG · {SITE.capacity.rawGasNm3PerDay.toLocaleString('en-IN')} Nm³/day raw biogas · {SITE.capacity.workingHoursDay} h × {SITE.capacity.workingDaysYear} days · {SITE.capacity.standard}.</li>
        <li>IOCL LoI dated 04.10.2024 · {SITE.loi.commercialAgreementYears}-year Commercial Agreement · commissioning deadline 04.10.2026.</li>
        <li>CFA eligibility: MNRE Phase-I National Bioenergy Programme · ₹{SITE.financing.incentivesCr} Cr confirmed central incentives · {SITE.financing.taxHolidayYears}-year tax holiday.</li>
        <li>UDYAM-registered MSME: {SITE.udyam}. ROC Vijayawada, Reg. No. {SITE.registrationNumber}.</li>
        <li>CPCB pollution category: WHITE. 4 clearances obtained, 3 applied, 1 after-COD.</li>
      </ul>
      <p class="mt-5 text-sm">Email <a href={`mailto:${SITE.email}?subject=DPR%20request`}>{SITE.email}</a> with subject <em>DPR request</em>.</p>
    </article>
  </Section>
</Base>
