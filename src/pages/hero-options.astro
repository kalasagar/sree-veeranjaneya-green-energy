  <script is:inline>
    document.querySelectorAll('video.hopt-video').forEach(function (v) {
      var ready = function () { v.classList.add('hopt-video--ready'); };
      if (v.readyState >= 2) ready();
      else v.addEventListener('loadeddata', ready, { once: true });
    });
  </script>
