              <span class="brand">
                <img src={mark} alt="" class="mark" />
                <span class="wm">SVGE</span>
              </span>
              <span class="nav">
                {navItems.map((n, i) => <a href="#" class={i === 0 ? 'is-active' : ''}>{n}</a>)}
