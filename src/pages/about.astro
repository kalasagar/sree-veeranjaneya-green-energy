---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Banner from '../components/Banner.astro';
import { SITE } from '../lib/site';
---
<Base title="About" description="The two-director family-owned company behind SVGE — and the four things we are willing to be measured on.">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-6 sm:pt-10">
    <Banner name="about_founder_field" alt="A man in a white kurta walking unhurriedly down a narrow earth path between tall Napier grass plots at golden hour." aspect="21/9" priority />
  </div>

  <Section eyebrow="About" title="A small family-owned company. One plant. ₹8.37 crore on the line." narrow>
    <div class="prose-svge">
      <p>
        We are not a fund-backed clean-tech startup. We are two directors, ₹8.37 crore of personal equity, a ₹23.40 crore term loan, an Indian Oil Letter of Intent, and 2.63 acres of paddy-belt land we bought for exactly this purpose.
      </p>
      <p>
        We are building one Compressed Bio-Gas plant in Thatipadu village, Vizianagaram district. That is the entire plan for the next 24 months. We are not pitching plant number two, three, or five. We are not pitching a green-bond. We are getting one plant right.
      </p>
      <p>
        We named the company after the local form of Lord Hanuman — Veeranjaneya — because Suresh's family has lived in this part of Andhra for as long as anyone in the family can remember. The mark on the wordmark is secular: a leaf and a flame. The name carries the heritage; the mark does not need to.
      </p>
    </div>
  </Section>

  <Section eyebrow="Founders" title="Who is on the line">
    <div class="grid sm:grid-cols-2 gap-6">
      {SITE.promoters.map(p => (
        <article class="rounded-2xl bg-white p-6 border border-black/5">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-[color:var(--color-paper-2)] grid place-items-center font-bold text-[color:var(--color-forest)] text-lg">
              {p.name.split(' ').map(w => w[0]).slice(0, 2).join('')}
            </div>
            <div>
              <div class="font-semibold text-lg">{p.name}</div>
              <div class="text-xs font-mono uppercase tracking-wider text-[color:var(--color-saffron-text)]">{p.role} · {p.share}</div>
            </div>
          </div>
          <p class="mt-4 text-sm leading-relaxed">{p.story}</p>
          <blockquote class="mt-4 border-l-4 border-[color:var(--color-saffron)] pl-4 italic text-[color:var(--color-slate)]">
            <p class="text-sm">{`"${p.quote}"`}</p>
            <footer class="mt-2 text-[11px] font-mono not-italic text-[color:var(--color-slate-2)]">
              — {p.name}{p.quoteDraft ? <span class="ml-2 text-[color:var(--color-saffron-text)]">[Draft — pending founder approval]</span> : ''}
            </footer>
          </blockquote>
          <p class="mt-4 text-[11px] font-mono text-[color:var(--color-slate-2)]">DIN {p.din} · {p.credentials}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="What we are willing to be measured on" title="Four behavioural promises">
    <div class="grid sm:grid-cols-2 gap-5">
      {SITE.values.map(v => (
        <article class="rounded-2xl bg-[color:var(--color-paper-2)] p-6">
          <h3 class="text-lg leading-snug">{v.k}</h3>
          <p class="mt-3 text-sm leading-relaxed">{v.v}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Registration" title="The paperwork, in plain sight">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
      <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-5">
        <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">CIN</div>
        <div class="mt-1 font-semibold break-all">{SITE.cin}</div>
      </div>
      <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-5">
        <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">GSTIN</div>
        <div class="mt-1 font-semibold break-all">{SITE.gst}</div>
      </div>
      <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-5">
        <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">UDYAM</div>
        <div class="mt-1 font-semibold break-all">{SITE.udyam}</div>
      </div>
      <div class="rounded-2xl bg-[color:var(--color-paper-2)] p-5">
        <div class="text-xs font-mono uppercase text-[color:var(--color-slate-2)]">Incorporated</div>
        <div class="mt-1 font-semibold">12 June 2024</div>
      </div>
    </div>
    <p class="mt-6 text-xs font-mono text-[color:var(--color-slate-2)]">Registered office: {SITE.registeredOffice.line1}, {SITE.registeredOffice.line2}, {SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}.</p>
  </Section>
</Base>
