---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import TimelineRail from '../components/TimelineRail.astro';
import StatGrid from '../components/StatGrid.astro';
import PullQuote from '../components/PullQuote.astro';
import FounderAvatar from '../components/FounderAvatar.astro';
import { SITE } from '../lib/site';

const aboutStats = [
  { v: '2024', k: 'Founded', sub: '12 June · ' + SITE.rocName },
  { v: '4 TPD', k: 'CBG capacity', sub: 'IS 16087:2016 spec' },
  { v: 'WHITE', k: 'CPCB category', sub: 'Lowest-impact tier' },
  { v: '2.63 ac', k: 'Plot owned', sub: 'Thatipadu, Vizianagaram' },
];
---
<Base title="About" description="Two-director Andhra Pradesh company building a 4 TPD CBG plant. IOCL Letter of Intent issued 04.10.2024." heroOver={true}>
  <FullBleedHero
    banner="about_founder_field"
    video="about_founder_walk"
    alt="A man walking down a path between Napier grass plots at golden hour."
    eyebrow="About SVGE"
    height="xl"
    priority
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2.75rem, 6vw, 5rem);">
      One plant. Two directors.<br/>
      <span style="color: var(--color-gold);">A 2-year clock.</span>
    </h1>
  </FullBleedHero>

  <Kicker eyebrow="About · two directors · one clock" deck='One company. <span style="color: var(--color-saffron-text);">Two directors.</span> A 24-month build.' />

  <!-- Lead paragraph (editorial) -->
  <Section narrow>
    <div class="prose-svge drop-cap">
      <p>Sree Veeranjaneya Green Energy is a two-director Andhra Pradesh company building a 4 TPD Compressed Bio-Gas plant in Thatipadu village, Vizianagaram district. The Indian Oil Letter of Intent was issued on 04.10.2024 (ref IndianOil/SATAT/01/3931) under the SATAT scheme; commissioning is contracted within 2 years.</p>
      <p>The plant is one of about 152 SATAT CBG projects currently in operation or under construction nationally, and one of seven in Andhra Pradesh. Tech partner Raj Process Equipments &amp; Systems, Pune. Built to IS 16087:2016 spec. Classified WHITE by the CPCB. Construction is promoter-led, backed by a 10-year public-sector term loan and ₹6.7 crore in confirmed central-government incentives.</p>
      <p>We named the company after the local form of Lord Hanuman — Veeranjaneya — because Suresh's family has lived in this part of Andhra for as long as anyone can remember. The mark is secular: a leaf and a flame. The name carries the heritage; the mark does not need to.</p>
    </div>
  </Section>

  <!-- Timeline rail -->
  <Section eyebrow="Timeline" title="The company, on a rail." bg="paper-2">
    <div class="max-w-3xl">
      <TimelineRail />
    </div>
  </Section>

  <!-- At a glance -->
  <Section eyebrow="At a glance" title="The company, in four numbers.">
    <StatGrid stats={aboutStats} />
  </Section>

  <!-- Founders -->
  <Section eyebrow="Founders" title="Who is on the line." bg="paper-2">
    <div class="space-y-16">
      {SITE.promoters.map((p, i) => {
        const avatarName = i === 0 ? 'suresh' : 'deepika';
        return (
          <div class="grid lg:grid-cols-[1fr_2fr] gap-8 items-start" data-reveal>
            <div class={i % 2 === 0 ? '' : 'lg:order-2'}>
              <div class="aspect-square rounded overflow-hidden grid place-items-center" style="background: var(--color-paper-3);">
                <FounderAvatar name={avatarName} size={240} label={`Stylised portrait of ${p.name}`} />
              </div>
              <p class="mt-3 meta">Stylised portrait · photograph pending.</p>
            </div>
            <div class={i % 2 === 0 ? '' : 'lg:order-1'}>
              <p class="eyebrow mb-2">{p.role} · {p.share}</p>
              <h3 class="display" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{p.name}</h3>
              <p class="prose-svge mt-4">{p.story}</p>
              <PullQuote quote={p.quote} attribution={p.name} draft={p.quoteDraft} />
              <p class="meta">DIN {p.din} · {p.credentials}</p>
            </div>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- Behavioural promises -->
  <Section eyebrow="What we will be measured on" title="Four behavioural promises.">
    <div class="space-y-12">
      {SITE.values.map((v, i) => (
        <div class="grid lg:grid-cols-[80px_1fr] gap-6 items-start" data-reveal>
          <p class="numeral text-3xl text-[color:var(--color-saffron-text)]">0{i + 1}</p>
          <div>
            <h3 class="display" style="font-size: clamp(1.5rem, 2.5vw, 2rem);">{v.k}.</h3>
            <p class="mt-3 prose-svge">{v.v}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Registration -->
  <Section eyebrow="Registration" title="The paperwork, in plain sight." bg="paper-2">
    <dl class="grid-12 numeral text-sm">
      {[
        { k: 'CIN', v: SITE.cin }, { k: 'GSTIN', v: SITE.gst },
        { k: 'UDYAM', v: SITE.udyam }, { k: 'Incorporated', v: '12 June 2024' },
        { k: 'ROC', v: SITE.rocName + ' · ' + SITE.registrationNumber },
        { k: 'PAN', v: SITE.pan }, { k: 'Class', v: 'Private · Small Company' },
        { k: 'CPCB category', v: 'WHITE' },
      ].map(item => (
        <div class="col-3 pt-3 rule-bold">
          <dt class="eyebrow mb-1" style="font-family: var(--font-mono);">{item.k}</dt>
          <dd class="text-base font-semibold" style="color: var(--color-forest);">{item.v}</dd>
        </div>
      ))}
    </dl>
    <p class="meta mt-8">
      Registered office: {SITE.registeredOffice.line1}, {SITE.registeredOffice.line2}, {SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}.
      Incorporated as a One Person Company on 12.06.2024; converted to a two-director Private Limited on 25.10.2025.
    </p>
  </Section>
</Base>
