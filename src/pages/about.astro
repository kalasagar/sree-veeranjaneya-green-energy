---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import PullQuote from '../components/PullQuote.astro';
import { SITE } from '../lib/site';
---
<Base title="About" description="The two-director family-owned company behind SVGE — and the four things we are willing to be measured on.">
  <FullBleedHero
    banner="about_founder_field"
    alt="A man in a white kurta walking unhurriedly down a narrow earth path between tall Napier grass plots at golden hour."
    eyebrow="About"
    height="lg"
    priority
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl">A small family-owned company.<br/>
      <span style="color:#FFB300;">One plant. ₹8.37 crore on the line.</span>
    </h1>
  </FullBleedHero>

  <!-- LEAD PARAGRAPH (editorial, drop-cap) -->
  <Section narrow>
    <div class="prose-svge drop-cap">
      <p>
        We are not a fund-backed clean-tech startup. We are two directors, ₹8.37 crore of personal equity, a ₹23.40 crore term loan, an Indian Oil Letter of Intent, and 2.63 acres of paddy-belt land we bought for exactly this purpose.
      </p>
      <p>
        We are building one Compressed Bio-Gas plant in Thatipadu village, Vizianagaram district. That is the entire plan for the next 24 months. We are not pitching plant number two, three, or five. We are not pitching a green-bond. We are getting one plant right.
      </p>
      <p>
        We named the company after the local form of Lord Hanuman — Veeranjaneya — because Suresh's family has lived in this part of Andhra for as long as anyone in the family can remember. The mark on the wordmark is secular: a leaf and a flame. The name carries the heritage; the mark does not need to.
      </p>
    </div>
  </Section>

  <!-- FOUNDERS — editorial spread per founder -->
  <Section eyebrow="Founders" title="Who is on the line." bg="paper-2">
    <div class="space-y-16">
      {SITE.promoters.map((p, i) => (
        <div class="grid-12 items-start">
          <div class={`col-4 ${i % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}`}>
            <div class="aspect-square rounded-xl bg-[color:var(--color-paper)] border border-[color:var(--color-slate-2-soft)]/30 grid place-items-center">
              <span class="text-5xl font-bold text-[color:var(--color-forest)]">
                {p.name.split(' ').map(w => w[0]).slice(0, 2).join('')}
              </span>
            </div>
            <p class="mt-3 text-[11px] font-mono text-[color:var(--color-slate-2)]">Portrait pending shoot.</p>
          </div>
          <div class={`col-8 ${i % 2 === 0 ? 'lg:order-2' : 'lg:order-1'}`}>
            <p class="eyebrow mb-2">{p.role} · {p.share}</p>
            <h3 class="text-2xl sm:text-3xl mb-4">{p.name}</h3>
            <p class="prose-svge">{p.story}</p>
            <PullQuote quote={p.quote} attribution={p.name} draft={p.quoteDraft} />
            <p class="mt-2 text-[11px] font-mono text-[color:var(--color-slate-2)]">DIN {p.din} · {p.credentials}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- BEHAVIOURAL PROMISES — numbered editorial stack -->
  <Section eyebrow="What we are willing to be measured on" title="Four behavioural promises.">
    <div class="space-y-10">
      {SITE.values.map((v, i) => (
        <div class="grid-12 items-start">
          <div class="col-3">
            <p class="numeral">0{i + 1}</p>
          </div>
          <div class="col-8">
            <h3 class="text-2xl sm:text-3xl leading-tight mb-3">{v.k}.</h3>
            <p class="text-[color:var(--color-slate)] text-lg leading-relaxed max-w-prose">{v.v}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- REGISTRATION — data sheet -->
  <Section eyebrow="Registration" title="The paperwork, in plain sight." bg="paper-2">
    <dl class="grid-12 font-mono text-sm">
      {[
        { k: 'CIN', v: SITE.cin },
        { k: 'GSTIN', v: SITE.gst },
        { k: 'UDYAM', v: SITE.udyam },
        { k: 'Incorporated', v: '12 June 2024' },
      ].map(item => (
        <div class="col-3 border-t-2 border-[color:var(--color-ink)] pt-3">
          <dt class="eyebrow text-[color:var(--color-slate-2)] mb-1">{item.k}</dt>
          <dd class="text-base break-all text-[color:var(--color-forest)] font-semibold">{item.v}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-8 text-xs font-mono text-[color:var(--color-slate-2)]">Registered office: {SITE.registeredOffice.line1}, {SITE.registeredOffice.line2}, {SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}.</p>
  </Section>
</Base>
