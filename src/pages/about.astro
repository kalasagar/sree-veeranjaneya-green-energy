---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FullBleedHero from '../components/FullBleedHero.astro';
import Kicker from '../components/Kicker.astro';
import TimelineRail from '../components/TimelineRail.astro';
import StatGrid from '../components/StatGrid.astro';
import PullQuote from '../components/PullQuote.astro';
import FounderAvatar from '../components/FounderAvatar.astro';
import WhatOneTonneDoes from '../components/WhatOneTonneDoes.astro';
import { SITE } from '../lib/site';

const aboutStats = [
  { v: '2024', k: 'Founded', sub: '12 June, at ' + SITE.rocName },
  { v: '4 TPD', k: 'CBG capacity', sub: 'IS 16087:2016 spec' },
  { v: 'WHITE', k: 'CPCB category', sub: 'Lowest-impact tier' },
  { v: '2.63 ac', k: 'Plot owned', sub: 'Thatipadu, Vizianagaram' },
];
---
<Base title="About" description="Two-director Andhra Pradesh company building a 4 TPD CBG plant. IOCL Letter of Intent issued 04.10.2024." heroOver={true}>
  <FullBleedHero
    banner="about_founder_field"
    video="about_founder_walk"
    alt="A man walking down a path between Napier grass plots at golden hour."
    eyebrow="About SVGE"
    height="xl"
    priority
  >
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl" style="font-size: clamp(2rem, 6vw, 5rem);">
      <span class="block">One plant.</span>
      <span class="block" style="color: var(--color-gold);">Two directors.</span>
      <span class="block">A 2-year clock.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      A two-director Andhra Pradesh company incorporated 12 June 2024 (CIN U35101AP2024PTC115061). The plant at Thatipadu, Vizianagaram is on a 24-month commissioning clock from the Indian Oil Letter of Intent issued 04 October 2024.
    </p>
  </FullBleedHero>

  <Kicker eyebrow="Who is on the line" deck='One small company, <span style="color: var(--color-saffron-text);">two directors</span>, twenty-four months to commission.' maxCh={28} />

  <!-- Lead paragraph (editorial) -->
  <Section narrow>
    <div class="prose-svge drop-cap">
      <p>Sree Veeranjaneya Green Energy is a two-director Andhra Pradesh company building a 4 TPD Compressed Bio-Gas plant in Thatipadu village, Vizianagaram district. The Indian Oil Letter of Intent was issued on 04 October 2024 (ref IndianOil/SATAT/01/3931) under the SATAT scheme. Commissioning is contracted within two years.</p>
      <p>The plant is one of about 152 SATAT CBG projects in operation or under construction nationally, and one of seven in Andhra Pradesh. The technology partner is Raj Process Equipments &amp; Systems, Pune. The plant is built to IS 16087:2016 and classified WHITE by the CPCB. Construction is promoter-led, backed by a 10-year public-sector term loan and ₹6.7 crore in confirmed central-government incentives.</p>
      <p>We named the company after the local form of Lord Hanuman, Veeranjaneya, because Suresh's family has lived in this part of Andhra for as long as anyone can remember. The mark itself is secular: a leaf and a flame. The name carries the heritage; the mark does not have to.</p>
    </div>
  </Section>

  <!-- What one tonne does — the circularity story in three sentences. -->
  <Section eyebrow="Why this matters" title="A tonne of paddy straw, walked through the loop.">
    <WhatOneTonneDoes />
  </Section>

  <!-- Timeline rail -->
  <Section eyebrow="Timeline" title="The company, on a rail." bg="paper-2">
    <div class="max-w-3xl">
      <TimelineRail />
    </div>
  </Section>

  <!-- At a glance -->
  <Section eyebrow="At a glance" title="The company, in four numbers.">
    <StatGrid stats={aboutStats} />
  </Section>

  <!-- Founders -->
  <Section eyebrow="Founders" title="Who is on the line." bg="paper-2">
    <div class="space-y-16">
      {SITE.promoters.map((p, i) => {
        const avatarName = i === 0 ? 'suresh' : 'deepika';
        return (
          <div class="grid lg:grid-cols-[1fr_2fr] gap-8 items-start" data-reveal>
            <div class={i % 2 === 0 ? '' : 'lg:order-2'}>
              <div class="aspect-square rounded overflow-hidden grid place-items-center" style="background: var(--color-paper-3);">
                <FounderAvatar name={avatarName} size={240} label={`Stylised portrait of ${p.name}`} />
              </div>
              <p class="mt-3 meta">Stylised portrait. Photograph pending.</p>
            </div>
            <div class={i % 2 === 0 ? '' : 'lg:order-1'}>
              <p class="eyebrow mb-2">{p.role}, {p.share}</p>
              <h3 class="display" style="font-size: clamp(1.75rem, 3vw, 2.5rem);">{p.name}</h3>
              <p class="prose-svge mt-4">{p.story}</p>
              <PullQuote quote={p.quote} attribution={p.name} draft={p.quoteDraft} />
              <p class="meta">DIN {p.din}. {p.credentials}</p>
            </div>
          </div>
        );
      })}
    </div>
  </Section>

  <!-- Behavioural promises -->
  <Section eyebrow="What we will be measured on" title="Four behavioural promises.">
    <div class="space-y-12">
      {SITE.values.map((v, i) => (
        <div class="grid lg:grid-cols-[80px_1fr] gap-6 items-start" data-reveal>
          <p class="numeral text-3xl text-[color:var(--color-saffron-text)]">0{i + 1}</p>
          <div>
            <h3 class="display" style="font-size: clamp(1.5rem, 2.5vw, 2rem);">{v.k}.</h3>
            <p class="mt-3 prose-svge">{v.v}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Registration -->
  <Section eyebrow="Registration" title="The paperwork, in plain sight." bg="paper-2">
    <!-- Identifier grid: hairline cells (gap-px on rule-color bg) so the
         data sheet reads as one card with internal divisions, not a row
         of bordered tiles. Codes use the mono numeral treatment;
         categorical facts use the body text. -->
    <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px overflow-hidden rounded max-w-5xl" style="background: var(--rule-color);">
      {[
        { k: 'CIN',           v: SITE.cin,                                                kind: 'code' },
        { k: 'GSTIN',         v: SITE.gst,                                                kind: 'code' },
        { k: 'UDYAM',         v: SITE.udyam,                                              kind: 'code' },
        { k: 'PAN',           v: SITE.pan,                                                kind: 'code' },
        { k: 'Incorporated',  v: '12 June 2024',                                          kind: 'fact' },
        { k: 'ROC',           v: SITE.rocName + ', Reg. ' + SITE.registrationNumber,      kind: 'fact' },
        { k: 'Class',         v: 'Private, Small Company',                                kind: 'fact' },
        { k: 'CPCB category', v: 'WHITE',                                                 kind: 'badge' },
      ].map(item => (
        <div
          class={`p-4 sm:p-5 flex flex-col justify-between ${item.kind === 'badge' ? 'is-badge' : ''}`}
          style={item.kind === 'badge'
            ? 'background: var(--color-ink); color: var(--color-paper);'
            : 'background: var(--color-paper);'}
        >
          <dt
            class="eyebrow"
            style={item.kind === 'badge'
              ? 'color: color-mix(in oklab, var(--color-paper) 70%, transparent);'
              : 'color: var(--color-slate-2);'}
          >{item.k}</dt>
          <dd
            class="mt-3"
            style={item.kind === 'code'
              ? 'font-family: var(--font-mono); font-weight: 500; font-size: 0.875rem; color: var(--color-ink); word-break: break-all;'
              : item.kind === 'badge'
                ? 'font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: 0.04em; color: var(--color-paper);'
                : 'font-family: var(--font-body); font-weight: 600; font-size: 0.9375rem; color: var(--color-ink); line-height: 1.35;'}
          >
            {item.kind === 'badge' && <span class="inline-flex items-center gap-2 align-middle"><span class="w-2 h-2 rounded-full" style="background: var(--color-paper); border: 2px solid var(--color-paper);" aria-hidden="true"></span>{item.v}</span>}
            {item.kind !== 'badge' && item.v}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Registered office + incorporation timeline as a paired card row.
         Same hairline-grid pattern, two cells. -->
    <div class="mt-6 grid sm:grid-cols-2 gap-px overflow-hidden rounded max-w-5xl" style="background: var(--rule-color);">
      <article class="p-5" style="background: var(--color-paper);">
        <p class="eyebrow" style="color: var(--color-slate-2);">Registered office</p>
        <address class="mt-3 not-italic text-sm leading-relaxed" style="color: var(--color-ink);">
          {SITE.registeredOffice.line1},<br/>
          {SITE.registeredOffice.line2},<br/>
          {SITE.registeredOffice.district}, {SITE.registeredOffice.state} {SITE.registeredOffice.pin}.
        </address>
      </article>
      <article class="p-5" style="background: var(--color-paper);">
        <p class="eyebrow" style="color: var(--color-slate-2);">Incorporation history</p>
        <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-ink);">
          Filed as a One Person Company on 12.06.2024. Converted to a two-director Private Limited on 25.10.2025 when Deepika joined as Director.
        </p>
      </article>
    </div>
  </Section>
</Base>
