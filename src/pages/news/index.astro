---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import FullBleedHero from '../../components/FullBleedHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
const [featured, ...rest] = posts;
---
<Base title="News" description="Monthly receipts from the SVGE construction record. One photo, one milestone hit, one missed, one financial number, one thing that went wrong.">
  <FullBleedHero banner={null} alt="News" eyebrow="News">
    <h1 class="display text-[color:var(--color-paper)] mt-3 max-w-4xl">
      Built in public.<br/>
      <span style="color:#FFB300;">Monthly receipts.</span>
    </h1>
    <p class="mt-6 text-lg max-w-2xl text-[color:var(--color-paper)]/90 leading-relaxed">
      One post a month from the day concrete is poured. A photo, a milestone hit, a milestone missed, one financial number, and one thing that went wrong.
    </p>
  </FullBleedHero>

  {featured && (
    <Section eyebrow="Latest" title="The first post.">
      <a href={`/news/${featured.id}/`} class="grid-12 no-underline group">
        <div class="col-8">
          <p class="eyebrow mb-3">{fmt.format(featured.data.date)}</p>
          <h2 class="text-3xl sm:text-5xl leading-tight text-[color:var(--color-forest)] group-hover:text-[color:var(--color-saffron-text)] transition-colors duration-200">{featured.data.title}</h2>
          <p class="serif text-xl mt-5 max-w-[55ch] leading-relaxed text-[color:var(--color-slate)]">{featured.data.summary}</p>
          <p class="mt-6 inline-block text-sm font-mono text-[color:var(--color-saffron-text)] underline">Read the post →</p>
        </div>
        <div class="col-4">
          <div class="aspect-[4/5] rounded-xl bg-[color:var(--color-paper-2)] grid place-items-center p-6">
            <p class="eyebrow text-[color:var(--color-slate-2)] text-center">Image will land<br/>when the<br/>plant breaks ground.</p>
          </div>
        </div>
      </a>
    </Section>
  )}

  {rest.length > 0 && (
    <Section eyebrow="Earlier" title="Archive." bg="paper-2">
      <ul class="space-y-6 max-w-3xl">
        {rest.map(post => (
          <li class="border-t-2 border-[color:var(--color-ink)] pt-5">
            <p class="eyebrow">{fmt.format(post.data.date)}</p>
            <h3 class="mt-2 text-2xl"><a href={`/news/${post.id}/`}>{post.data.title}</a></h3>
            <p class="mt-2 text-[color:var(--color-slate)] leading-relaxed">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  {posts.length === 0 && (
    <Section narrow>
      <p class="text-base font-mono text-[color:var(--color-slate-2)]">No posts yet. The first one lands the day construction commences.</p>
    </Section>
  )}
</Base>
