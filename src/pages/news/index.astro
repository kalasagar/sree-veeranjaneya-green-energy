---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = new Intl.DateTimeFormat('en-IN', { dateStyle: 'long' });
---
<Base title="News" description="Monthly receipts from the SVGE construction record. One photo, one milestone hit, one missed, one financial number, one thing that went wrong.">
  <Section eyebrow="News" title="Built in public · Monthly receipts">
    <p class="text-lg max-w-3xl mb-10 leading-relaxed">
      One post a month from the day concrete is poured. A photo, a milestone hit, a milestone missed, one financial number, and one thing that went wrong. We've started the record now — before there is anything photogenic — because that is the point.
    </p>

    <ul class="space-y-6">
      {posts.map(post => (
        <li class="rounded-2xl bg-white border border-black/5 p-6">
          <div class="text-xs font-mono uppercase tracking-widest text-[color:var(--color-saffron-text)]">{fmt.format(post.data.date)}</div>
          <h2 class="mt-2 text-xl"><a href={`/news/${post.id}/`}>{post.data.title}</a></h2>
          <p class="mt-3 text-sm leading-relaxed">{post.data.summary}</p>
          {post.data.tags && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {post.data.tags.map(t => <span class="chip">{t}</span>)}
            </div>
          )}
          <a href={`/news/${post.id}/`} class="inline-block mt-4 text-sm font-mono text-[color:var(--color-saffron-text)] hover:underline">Read the post ↗</a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="text-sm font-mono text-[color:var(--color-slate-2)]">
        No posts yet. The first one lands the day construction commences.
      </p>
    )}
  </Section>
</Base>
