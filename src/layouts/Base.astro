---
import '../styles/global.css';
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusStrip from '../components/StatusStrip.astro';
import { SITE } from '../lib/site';
import { stripBase } from '../lib/links';

const BASE = import.meta.env.BASE_URL;
const asset = (p: string) => `${BASE}${p.replace(/^\//, '')}`.replace('//', '/');

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  article?: { title: string; description: string; datePublished: Date; tags?: string[] };
  heroOver?: boolean;
}

const { title, description, ogImage = asset('brand/og_image.png'), canonical, article, heroOver = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const desc = description ?? SITE.description;
const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const path = stripBase(Astro.url.pathname);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  alternateName: [SITE.name, SITE.short],
  url: SITE.url,
  logo: new URL('/brand/mark_512.png', SITE.url).href,
  email: SITE.email,
  description: SITE.description,
  foundingDate: SITE.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${SITE.registeredOffice.line1}, ${SITE.registeredOffice.line2}`,
    addressLocality: SITE.registeredOffice.district,
    addressRegion: SITE.registeredOffice.state,
    postalCode: SITE.registeredOffice.pin,
    addressCountry: 'IN',
  },
  location: {
    '@type': 'Place',
    name: `${SITE.plant.village} CBG Plant`,
    geo: { '@type': 'GeoCoordinates', latitude: SITE.plant.lat, longitude: SITE.plant.lng },
  },
  sameAs: [SITE.social.linkedin],
  identifier: [
    { '@type': 'PropertyValue', name: 'CIN', value: SITE.cin },
    { '@type': 'PropertyValue', name: 'GSTIN', value: SITE.gst },
    { '@type': 'PropertyValue', name: 'UDYAM', value: SITE.udyam },
  ],
};

// Per-page WebSite + SearchAction so brand-name searches resolve to this site.
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.short,
  alternateName: [SITE.name, SITE.legalName],
  url: SITE.url,
  inLanguage: 'en-IN',
  publisher: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={asset('favicon.ico')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="canonical" href={url} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@600;700&family=Public+Sans:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@600;700&family=Public+Sans:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    </noscript>

    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#1B5E20" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" type="application/xml" href={asset('sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {article && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: article.title,
        description: article.description,
        datePublished: article.datePublished.toISOString(),
        url,
        image: new URL(ogImage, SITE.url).href,
        author: { '@type': 'Organization', name: SITE.legalName, url: SITE.url },
        publisher: { '@type': 'Organization', name: SITE.legalName, logo: { '@type': 'ImageObject', url: new URL('/brand/mark_512.png', SITE.url).href } },
        keywords: article.tags?.join(', '),
        mainEntityOfPage: url,
      })} />
    )}
    <link rel="alternate" type="application/rss+xml" title="SVGE · Build journal" href={asset('news/rss.xml')} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-path={path}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header heroOver={heroOver} />
    <StatusStrip />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline data-astro-rerun>
      (function () {
        var rm = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Reduced-motion fast path: mark everything visible immediately,
        // skip all observers.
        if (rm) {
          document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(function (el) { el.setAttribute('data-revealed', ''); });
          document.querySelectorAll('[data-draw]:not([data-drawn])').forEach(function (el) { el.setAttribute('data-drawn', ''); });
          return;
        }

        // Above-the-fold critical path: mark reveal-eligible elements
        // already in the initial viewport as revealed BEFORE the observer
        // wires up. Stops first paint from showing translucent text.
        var vh = window.innerHeight || 800;
        document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(function (el) {
          var r = el.getBoundingClientRect();
          if (r.top < vh && r.bottom > 0) el.setAttribute('data-revealed', '');
        });

        // Defer all observer wiring past LCP so they don't compete on the
        // main thread with first paint + LCP.
        var rIC = window.requestIdleCallback || function (fn) { setTimeout(fn, 200); };
        rIC(function init() {
          // Reveal observer (for elements below the initial viewport)
          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.setAttribute('data-revealed', '');
                  io.unobserve(e.target);
                }
              });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
            document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(function (el) { io.observe(el); });
          } else {
            document.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(function (el) { el.setAttribute('data-revealed', ''); });
          }

          // Hero parallax
          var pxEls = document.querySelectorAll('[data-hero-bg]:not([data-hero-bg-bound])');
          pxEls.forEach(function (el) {
            el.setAttribute('data-hero-bg-bound', '');
            var ticking = false;
            function onScroll() {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(function () {
                var y = window.scrollY;
                var offset = Math.max(-30, Math.min(0, -y * 0.12));
                el.style.transform = 'translate3d(0,' + offset + 'px,0)';
                ticking = false;
              });
            }
            window.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
          });

          // Count-up
          if ('IntersectionObserver' in window) {
            var countEls = document.querySelectorAll('[data-count-to]:not([data-counted])');
            var co = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                var el = e.target;
                co.unobserve(el);
                el.setAttribute('data-counted', '');
                var to = parseFloat(el.getAttribute('data-count-to'));
                var prefix = el.getAttribute('data-prefix') || '';
                var suffix = el.getAttribute('data-suffix') || '';
                var decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
                var thousands = el.getAttribute('data-thousands') === 'true';
                var start = performance.now();
                var dur = 1200;
                function step(t) {
                  var p = Math.min(1, (t - start) / dur);
                  var eased = 1 - Math.pow(1 - p, 3);
                  var v = to * eased;
                  var s = decimals > 0 ? v.toFixed(decimals) : Math.round(v).toString();
                  if (thousands) s = s.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
                  el.textContent = prefix + s + suffix;
                  if (p < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
              });
            }, { threshold: 0.4 });
            countEls.forEach(function (el) { co.observe(el); });
          }

          // SVG draw-on-scroll
          if ('IntersectionObserver' in window) {
            var drawEls = document.querySelectorAll('[data-draw]:not([data-drawn])');
            var drawObs = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                var el = e.target;
                drawObs.unobserve(el);
                el.querySelectorAll('path').forEach(function (p) {
                  try { p.style.setProperty('--draw-length', p.getTotalLength()); } catch (err) {}
                });
                requestAnimationFrame(function () { el.setAttribute('data-drawn', ''); });
              });
            }, { threshold: 0.18 });
            drawEls.forEach(function (el) { drawObs.observe(el); });
          }
          // Note: hero video lazy-load lives in FullBleedHero.astro — it
          // gates on min-width: 768px so mobile never fetches the 3.5 MB
          // MP4. The duplicate handler that used to live here was redundant
          // and bypassed the mobile gate.
        }, { timeout: 800 });
      })();
    </script>
  </body>
</html>
