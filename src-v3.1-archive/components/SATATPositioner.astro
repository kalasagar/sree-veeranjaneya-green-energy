---
/**
 * SATAT pipeline positioner — national + AP bars with SVGE marker.
 */
import { SITE } from '../lib/site';

const nat = SITE.industry;
const totalNat = nat.satatCommissioned + nat.satatUnderConstruction;
const commPct = Math.round((nat.satatCommissioned / totalNat) * 100);
const apTotal = nat.andhraPlantsCommissioned + 1; // SVGE marker counts as the next one
const apCommPct = Math.round((nat.andhraPlantsCommissioned / apTotal) * 100);
---
<section class="svge-card p-6 sm:p-8" data-reveal>
  <p class="eyebrow text-[color:var(--tone-ink)]">Where SVGE sits in SATAT</p>
  <h3 class="mt-2 text-2xl text-[color:var(--color-ink)]">India's CBG pipeline, and our slot in it.</h3>

  <dl class="mt-6 space-y-6">
    <div>
      <div class="flex items-baseline justify-between mb-2">
        <dt class="text-sm font-mono text-[color:var(--color-slate-2)]">National pipeline</dt>
        <dd class="text-xs font-mono text-[color:var(--color-slate-2)]">as of {nat.satatCommissionedAsOfDate}</dd>
      </div>
      <div class="svge-bar" role="img" aria-label={`${nat.satatCommissioned} commissioned, ${nat.satatUnderConstruction} under construction`}>
        <span style={`width:${commPct}%;background:var(--color-forest);`}></span>
        <span style={`width:${100 - commPct}%;background:var(--tone);opacity:0.7;`}></span>
      </div>
      <div class="mt-2 flex justify-between text-xs font-mono">
        <span><span data-count-to={nat.satatCommissioned} data-thousands="true" class="text-[color:var(--color-forest)] font-semibold">{nat.satatCommissioned}</span> commissioned</span>
        <span><span data-count-to={nat.satatUnderConstruction} data-thousands="true" class="text-[color:var(--tone-ink)] font-semibold">{nat.satatUnderConstruction}</span> under construction</span>
      </div>
    </div>

    <div>
      <div class="flex items-baseline justify-between mb-2">
        <dt class="text-sm font-mono text-[color:var(--color-slate-2)]">Andhra Pradesh</dt>
        <dd class="text-xs font-mono text-[color:var(--color-slate-2)]">SVGE = the next plant</dd>
      </div>
      <div class="svge-bar relative" role="img" aria-label={`${nat.andhraPlantsCommissioned} commissioned in AP`}>
        <span style={`width:${apCommPct}%;background:var(--color-forest);`}></span>
        <span style={`width:${100 - apCommPct}%;background:var(--tone);opacity:0.45;`}></span>
        <span class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1 w-3 h-6 bg-[color:var(--color-saffron)] ring-2 ring-[color:var(--color-paper)] rounded-sm" aria-hidden="true"></span>
      </div>
      <div class="mt-2 flex justify-between text-xs font-mono">
        <span><span data-count-to={nat.andhraPlantsCommissioned} class="text-[color:var(--color-forest)] font-semibold">{nat.andhraPlantsCommissioned}</span> in AP today</span>
        <span class="text-[color:var(--color-saffron-text)] font-semibold">SVGE on the bar</span>
      </div>
    </div>
  </dl>

  <p class="mt-6 text-xs font-mono text-[color:var(--color-slate-2)]">
    Target: 5,000 plants · 15 MMTPA nationally. Sources: {nat.sources.map((s: any, i: number) => (
      <>{i > 0 && ' · '}<a href={s.url} class="underline">{s.label}</a></>
    ))}.
  </p>
</section>
