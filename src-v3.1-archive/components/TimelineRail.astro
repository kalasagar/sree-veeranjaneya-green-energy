---
/**
 * Vertical timeline rail of dated milestones. State = done | now | next.
 */
import { SITE } from '../lib/site';

interface Props {
  compact?: boolean;
  items?: { date: string; label: string; done?: boolean; current?: boolean }[];
}
const { compact = false, items = SITE.timeline as any } = Astro.props;

const fmt = new Intl.DateTimeFormat('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
function fmtDate(d: string) {
  if (/^\d{4}-\d{2}-\d{2}$/.test(d)) return fmt.format(new Date(d + 'T00:00:00Z'));
  return d;
}
function stateOf(item: { done?: boolean; current?: boolean }) {
  if (item.current) return 'now';
  if (item.done) return 'done';
  return 'next';
}
---
<ol class="svge-rail" data-reveal>
  {items.map((item: any) => (
    <li class={`svge-rail-item ${compact ? 'py-3' : ''}`} data-state={stateOf(item)}>
      <time class="block">{fmtDate(item.date)}</time>
      <p class={`mt-1 ${compact ? 'text-base' : 'text-lg'} text-[color:var(--color-ink)]`}>{item.label}</p>
    </li>
  ))}
</ol>
