---
/**
 * FounderAvatar — stylised inline-SVG portrait placeholder in brand palette.
 *
 * Used until real founder photos are commissioned. Two named variants:
 *   - `suresh`: olive kurta, short grey-tipped hair, looking right
 *   - `deepika`: forest sari/dupatta, longer hair pulled back, looking left
 *
 * Renders as a circular medallion with a forest-green ring and saffron sun
 * behind the silhouette. Pure SVG, no raster, no external requests.
 */
interface Props {
  name: 'suresh' | 'deepika';
  size?: number;        // px, square
  label?: string;       // a11y label
  class?: string;
}
const { name, size = 140, label, class: className = '' } = Astro.props;
const a11y = label ?? (name === 'suresh' ? 'Stylised portrait of Suresh Babu' : 'Stylised portrait of Pogiri Deepika');
const lookRight = name === 'suresh';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 140 140"
  width={size}
  height={size}
  role="img"
  aria-label={a11y}
  class={`svge-founder-avatar ${className}`}
  style="display:block;"
>
  <defs>
    <clipPath id={`fa-clip-${name}`}><circle cx="70" cy="70" r="66" /></clipPath>
    <linearGradient id={`fa-sun-${name}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#FFB300"/>
      <stop offset="100%" stop-color="#E65100"/>
    </linearGradient>
  </defs>
  <!-- outer ring -->
  <circle cx="70" cy="70" r="68" fill="#1B5E20"/>
  <circle cx="70" cy="70" r="66" fill="#FAFAF7"/>
  <g clip-path={`url(#fa-clip-${name})`}>
    <!-- horizon sky -->
    <rect x="0" y="0" width="140" height="80" fill="#FAFAF7"/>
    <!-- saffron sun, off-centre opposite the look direction -->
    <circle cx={lookRight ? 38 : 102} cy="60" r="22" fill={`url(#fa-sun-${name})`} opacity="0.85"/>
    <!-- distant field band -->
    <rect x="0" y="80" width="140" height="60" fill="#1B5E20"/>
    <!-- subtle field texture -->
    <g stroke="#103a14" stroke-width="1" opacity="0.5">
      <line x1="0" y1="92" x2="140" y2="92"/>
      <line x1="0" y1="104" x2="140" y2="104"/>
      <line x1="0" y1="116" x2="140" y2="116"/>
    </g>
    {name === 'suresh' ? (
      <g>
        <!-- shoulders/kurta -->
        <path d="M22 140 C 22 110 44 96 70 96 C 96 96 118 110 118 140 Z" fill="#FAFAF7" stroke="#37474F" stroke-width="1.2"/>
        <!-- collar -->
        <path d="M58 100 L 70 110 L 82 100" fill="none" stroke="#37474F" stroke-width="1.4" stroke-linecap="round"/>
        <!-- head (looking right — left edge of face shown) -->
        <ellipse cx="70" cy="74" rx="22" ry="26" fill="#8D5A3B"/>
        <!-- hair: short, grey at temples -->
        <path d="M48 64 C 50 50 60 44 70 44 C 80 44 90 50 92 64 L 90 70 C 88 60 80 56 70 56 C 60 56 52 60 50 70 Z" fill="#37474F"/>
        <path d="M48 64 C 50 56 56 50 64 48" stroke="#FAFAF7" stroke-width="1.6" fill="none" opacity="0.55"/>
        <!-- ear hint right side -->
        <ellipse cx="89" cy="76" rx="2.4" ry="3.6" fill="#7A4E33"/>
        <!-- subtle chin shadow -->
        <path d="M56 86 C 62 92 78 92 84 86" stroke="#5E3D27" stroke-width="1.2" fill="none" opacity="0.6"/>
      </g>
    ) : (
      <g>
        <!-- shoulders/sari -->
        <path d="M22 140 C 22 110 44 96 70 96 C 96 96 118 110 118 140 Z" fill="#1B5E20"/>
        <!-- dupatta drape -->
        <path d="M30 140 C 36 120 52 108 70 108 L 70 140 Z" fill="#E65100" opacity="0.78"/>
        <!-- gold border on dupatta -->
        <path d="M30 140 C 36 120 52 108 70 108" stroke="#FFB300" stroke-width="1.4" fill="none"/>
        <!-- head (looking left) -->
        <ellipse cx="70" cy="74" rx="22" ry="26" fill="#8D5A3B"/>
        <!-- hair: long, pulled back behind right side -->
        <path d="M48 60 C 50 44 62 38 70 38 C 78 38 92 44 94 60 L 96 90 C 92 80 84 76 80 76 L 82 70 C 78 58 64 58 60 70 L 56 80 C 50 82 46 86 46 90 Z" fill="#1A1310"/>
        <!-- bindi -->
        <circle cx="70" cy="58" r="1.6" fill="#E65100"/>
        <!-- earring hint -->
        <circle cx="51" cy="80" r="2" fill="#FFB300"/>
        <!-- chin shadow -->
        <path d="M56 86 C 62 92 78 92 84 86" stroke="#5E3D27" stroke-width="1.2" fill="none" opacity="0.6"/>
      </g>
    )}
  </g>
  <!-- subtle outer rim for legibility -->
  <circle cx="70" cy="70" r="66" fill="none" stroke="#37474F" stroke-width="0.6" opacity="0.35"/>
</svg>
