---
import Base from '../layouts/Base.astro';
import { link } from '../lib/links';
import Section from '../components/Section.astro';
import Mark from '../components/Mark.astro';
import { SITE } from '../lib/site';
---
<Base title="Page not found" description="That page doesn't exist on the SVGE site.">
  <Section narrow>
    <div class="text-center py-10">
      <div class="inline-flex items-center justify-center mb-6">
        <Mark size={96} ariaLabel={null} />
      </div>
      <p class="font-mono uppercase tracking-[0.18em] text-xs text-[color:var(--color-saffron-text)] mb-3">404 · Page not found</p>
      <h1 class="text-3xl sm:text-4xl text-[color:var(--color-forest)]">We can't find that page.</h1>
      <p class="mt-4 text-lg leading-relaxed text-[color:var(--color-slate)]">
        Either the link is wrong, or we moved the page while you were reading. Both happen. Pick a door:
      </p>
      <div class="mt-8 grid sm:grid-cols-2 gap-3 text-left">
        {SITE.nav.filter(n => n.href !== '/').map(n => (
          <a href={link(n.href)} class="rounded-2xl bg-[color:var(--color-paper-2)] p-4 no-underline cursor-pointer hover:bg-[color:var(--color-paper)] active:scale-[0.99] border border-black/5 transition-all duration-200 ease-out">
            <div class="font-semibold text-[color:var(--color-forest)] flex items-center justify-between">{n.label} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg></div>
          </a>
        ))}
      </div>
      <p class="mt-8 text-sm font-mono text-[color:var(--color-slate-2)]">
        Or go <a href="/">back to the home page</a>.
      </p>
    </div>
  </Section>
</Base>
